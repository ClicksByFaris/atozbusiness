---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LocationHero from '../../components/location/LocationHero.astro';
import ContactInfo from '../../components/location/ContactInfo.astro';
import GoogleMap from '../../components/location/GoogleMap';
import { sanityClient } from '../../lib/sanity';
import { locationBySlugQuery, locationsQuery } from '../../lib/queries';
import type { Location } from '../../types';
import { CircleCheck, Image as ImageIcon, Briefcase } from 'lucide-react';
import { getImageUrl } from '../../lib/sanity';

import SEO from '../../components/SEO.astro';
import { generateLocationSchema } from '../../lib/schemas/localBusiness';

export async function getStaticPaths() {
  const locations: Location[] = await sanityClient.fetch(locationsQuery);
  return locations.map((location) => ({
    params: { slug: location.slug.current },
  }));
}

const { slug } = Astro.params;
const location: Location = await sanityClient.fetch(locationBySlugQuery, { slug });

if (!location) {
  return new Response(null, {
    status: 404,
    statusText: 'Not Found',
  });
}

const title = `${location.name} - AtoZ Business Services`;
const description =
  location.metaDescription ||
  `Visit AtoZ Business Services at ${location.area}. We offer professional government and typing services in Abu Dhabi.`;

const schema = generateLocationSchema({
  name: location.name,
  address: location.address,
  area: location.area,
  city: 'Abu Dhabi',
  phone: location.phone,
  latitude: location.coordinates?.lat,
  longitude: location.coordinates?.lng,
  image: location.image ? getImageUrl(location.image) : undefined,
});

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Locations', url: '/locations' },
  { name: location.name, url: `/locations/${location.slug.current}` },
];
---

<BaseLayout title={title} description={description}>
  <SEO
    slot="head"
    schema={schema}
    breadcrumbs={breadcrumbs}
    keywords={['typing center', location.area, 'PRO services', location.name, 'Abu Dhabi']}
  />
  <LocationHero location={location} />

  <div class="container mx-auto px-4 py-16 -mt-32 relative z-20">
    <div class="grid gap-8 lg:grid-cols-12">
      <!-- Main Content -->
      <div class="lg:col-span-8 space-y-8 animate-fade-in-up [animation-delay:300ms]">
        <!-- Gallery Section -->
        {
          location.gallery && location.gallery.length > 0 && (
            <div class="bg-white rounded-3xl p-8 shadow-soft border border-neutral-100">
              <div class="flex items-center gap-3 mb-6">
                <div class="p-2 bg-accent-50 rounded-lg text-accent-600">
                  <ImageIcon className="h-6 w-6" />
                </div>
                <h2 class="text-2xl font-display font-bold text-primary-900">Branch Gallery</h2>
              </div>

              <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
                {location.gallery.map((image) => (
                  <div class="aspect-square rounded-2xl overflow-hidden cursor-pointer hover:opacity-90 transition group relative shadow-sm">
                    <img
                      src={getImageUrl(image, 600, 600)}
                      alt={image.alt || 'Location photo'}
                      class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110"
                    />
                    <div class="absolute inset-0 bg-black/0 group-hover:bg-black/10 transition-colors" />
                  </div>
                ))}
              </div>
            </div>
          )
        }

        <!-- Services Section -->
        {
          location.servicesAvailable && location.servicesAvailable.length > 0 && (
            <div class="bg-white rounded-3xl p-8 shadow-soft border border-neutral-100">
              <div class="flex items-center gap-3 mb-6">
                <div class="p-2 bg-primary-50 rounded-lg text-primary-600">
                  <Briefcase className="h-6 w-6" />
                </div>
                <h2 class="text-2xl font-display font-bold text-primary-900">Services Available</h2>
              </div>

              <div class="grid gap-4 sm:grid-cols-2">
                {location.servicesAvailable.map((service) => (
                  <a
                    href={`/services/${service.slug.current}`}
                    class="flex items-center gap-3 p-4 rounded-xl bg-neutral-50 hover:bg-primary-50 hover:shadow-sm transition-all group border border-transparent hover:border-primary-100"
                  >
                    <div class="shrink-0 rounded-full bg-white p-1 text-green-500 shadow-sm">
                      <CircleCheck className="h-4 w-4" />
                    </div>
                    <span class="font-medium text-neutral-700 group-hover:text-primary-700">
                      {service.title}
                    </span>
                  </a>
                ))}
              </div>
            </div>
          )
        }

        <!-- Map Section -->
        <div
          class="h-[400px] md:h-[500px] rounded-3xl shadow-soft bg-white border border-neutral-100 overflow-hidden"
        >
          <GoogleMap server:defer embedUrl={location.mapEmbedUrl} className="w-full h-full">
            <div
              slot="fallback"
              class="flex h-full w-full flex-col items-center justify-center bg-neutral-100 text-neutral-400 relative overflow-hidden"
            >
              <div
                class="absolute inset-0 bg-[url('https://www.gstatic.com/images/branding/product/2x/maps_96dp.png')] opacity-5 bg-center bg-no-repeat grayscale"
              >
              </div>
              <div class="relative z-10 flex flex-col items-center animate-pulse">
                <div
                  class="h-12 w-12 rounded-full bg-neutral-200 flex items-center justify-center mb-3"
                >
                  <div class="h-6 w-6 text-neutral-400">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      ><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path><circle
                        cx="12"
                        cy="10"
                        r="3"></circle></svg
                    >
                  </div>
                </div>
                <span class="font-medium text-sm">Loading Map...</span>
              </div>
            </div>
          </GoogleMap>
        </div>
      </div>

      <!-- Sidebar -->
      <div class="lg:col-span-4 animate-fade-in-up [animation-delay:400ms]">
        <div class="sticky top-24">
          <ContactInfo location={location} />

          <!-- Helper CTA -->
          <div
            class="mt-6 rounded-3xl bg-neutral-900 p-8 text-center text-white relative overflow-hidden"
          >
            <div class="relative z-10">
              <h3 class="font-display font-bold text-xl mb-2">Need immediate help?</h3>
              <p class="text-neutral-400 text-sm mb-6">Our experts are ready to assist you.</p>
              <a
                href={`tel:${location.phone}`}
                class="block w-full rounded-xl bg-white text-neutral-900 font-bold py-3 hover:bg-neutral-200 transition-colors"
              >
                Call Now
              </a>
            </div>
            <!-- Background blobs -->
            <div class="absolute top-0 right-0 w-32 h-32 bg-primary-500/20 blur-2xl rounded-full">
            </div>
            <div class="absolute bottom-0 left-0 w-32 h-32 bg-accent-500/20 blur-2xl rounded-full">
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
