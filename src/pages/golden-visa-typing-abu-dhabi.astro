    .trust-box-centered {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      justify-content: center;
    }
    .trust-box-centered .trust-box-header {
      justify-content: center;
    }
    .reg-label {
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: rgba(255, 255, 255, 0.45);
      margin-bottom: 0.5rem;
    }
    .reg-name {
      font-family: "Outfit", sans-serif;
      font-size: 1.05rem;
      font-weight: 800;
      color: rgba(255, 255, 255, 0.95);
      line-height: 1.4;
      margin-bottom: 0.75rem;
      letter-spacing: 0.02em;
    }
    .reg-auth {
      font-size: 0.78rem;
      color: var(--gold);
      font-weight: 600;
    }

    /* ── LEGAL DISCLAIMER ──────────────────────────────────────────────── */
    .legal-disclaimer {
      background: rgba(0, 0, 0, 0.35);
      border-top: 1px solid rgba(255, 255, 255, 0.06);
      padding: 2rem 1.25rem;
    }
    .disclaimer-header {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-bottom: 1rem;
    }
    .disclaimer-icon {
      font-size: 1rem;
    }
    .disclaimer-header strong {
      font-size: 0.82rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.07em;
      color: rgba(255, 255, 255, 0.5);
    }
    .disclaimer-body p {
      font-size: 0.75rem;
      line-height: 1.65;
      color: rgba(255, 255, 255, 0.35);
      margin-bottom: 0.6rem;
    }
    .disclaimer-body p strong {
      color: rgba(255, 255, 255, 0.5);
      font-weight: 600;
    }
    .disclaimer-body p:last-child {
      margin-bottom: 0;
    }
  </style>

  <script>
    (function () {
      const track = document.getElementById("testimonialTrack");
      const dots = document.querySelectorAll<HTMLElement>("#carouselDots .dot");
      if (!track || !dots.length) return;

      // Click a dot → scroll to its card
      dots.forEach((dot) => {
        dot.addEventListener("click", () => {
          const idx = Number(dot.dataset.index);
          const card = track.children[idx] as HTMLElement;
          if (card)
            track.scrollTo({ left: card.offsetLeft, behavior: "smooth" });
        });
      });

      // Scroll → highlight nearest dot
      let rafId: number;
      track.addEventListener("scroll", () => {
        cancelAnimationFrame(rafId);
        rafId = requestAnimationFrame(() => {
          const cards = Array.from(track.children) as HTMLElement[];
          let closest = 0;
          let minDist = Infinity;
          cards.forEach((card, i) => {
            const dist = Math.abs(card.offsetLeft - track.scrollLeft);
            if (dist < minDist) {
              minDist = dist;
              closest = i;
            }
          });
          dots.forEach((d, i) => d.classList.toggle("active", i === closest));
        });
      });
    })();
  </script>
</BaseLayout>
