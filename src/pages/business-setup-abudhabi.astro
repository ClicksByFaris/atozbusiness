---
export const prerender = true; // SSG — pre-built static HTML at deploy time

import BaseLayout from '../layouts/BaseLayout.astro';
import { BUSINESS_INFO, BUSINESS_LICENSE, LOCATIONS, SOCIAL_MEDIA } from '../lib/constants';
import LPHeader from '../components/lp/LPHeader.astro';
import LPTrustBar from '../components/lp/LPTrustBar.astro';

// ─────────────────────────────────────────────
const page = {
  // SEO
  metaTitle: 'Business Setup Abu Dhabi | Free Consultation – AtoZ Business Setup',
  metaDescription:
    'Launch your Abu Dhabi business with full support. Paperwork managed. Free 30-min consultation. Bilingual experts. No hidden fees.',

  // Hero
  badge: '⚡ Fast-Track Application Support',
  headline: 'Business Setup Abu Dhabi',
  subHeadline:
    'Free Consultation – Book Today. Launch your Abu Dhabi business with full support. Paperwork managed. Free 30-min call with our bilingual experts.',
  bullets: [
    'Free 30-Min Consultation',
    '100% Ownership Allowed',
    'All-Inclusive Packages',
    'Bilingual Team Support',
  ],
  ctaText: 'Book Free Consultation →',
  whatsappMessage: "Hi, I'm interested in Business Setup in Abu Dhabi",

  // Offer section
  offerHeadline: 'End-to-End Setup Experts',
  offerText:
    'Confused by Abu Dhabi setup options? We compare Mainland vs Free Zone for you — free 30-min call. End-to-end setup: Paperwork, MOA, Documentation & Bank Account help. One dedicated bilingual consultant manages your case from start to finish. WhatsApp us today.',

  // Package highlights (icon must be an emoji)
  highlights: [
    {
      icon: '🏢',
      title: 'Mainland Setup',
      desc: '100% ownership across most activities. Trade anywhere in the UAE without restrictions.',
    },
    {
      icon: '🌍',
      title: 'Offshore Setup',
      desc: '0% personal income tax, 100% foreign ownership, easy bank account opening.',
    },
    {
      icon: '📋',
      title: 'Documentation Support',
      desc: 'We prepare all paperwork — MOA drafting, approvals, and authority submissions.',
    },
    {
      icon: '🏦',
      title: 'Bank Account Assistance',
      desc: 'We liaise with our partner banks to help you open a corporate account smoothly.',
    },
    {
      icon: '🛡️',
      title: 'Dedicated Account Manager',
      desc: 'One person handles your case from start to finish. No call centre confusion.',
    },
    {
      icon: '📱',
      title: 'WhatsApp & Phone Support',
      desc: 'Instant replies during business hours — we respond within 1 minute.',
    },
  ],

  // Stats bar
  stats: [
    { num: '⭐ 4.9', label: 'Google Rating' },
    { num: '127+', label: 'Verified Reviews' },
    { num: '15,000+', label: 'Clients Served' },
    { num: '10+', label: 'Years in Abu Dhabi' },
  ],

  // Testimonials
  testimonials: [
    {
      name: 'Ahmed R.',
      role: 'Founder, Tech Consultancy LLC',
      stars: 5,
      quote:
        'AtoZ helped me set up my consultancy in Abu Dhabi within weeks. The team handled everything — I just signed papers.',
    },
    {
      name: 'Sarah M.',
      role: 'CEO, Trading Company',
      stars: 5,
      quote:
        'Their bilingual team explained everything clearly in Arabic and English. The whole process was completely stress-free.',
    },
    {
      name: 'James K.',
      role: 'Director, Consulting Firm',
      stars: 5,
      quote:
        'Transparent pricing, no surprises. My free zone company was set up faster than expected. Highly recommend.',
    },
    {
      name: 'Fatima Al Hashmi',
      role: 'Owner, Retail Business',
      stars: 5,
      quote:
        'I was confused between mainland and free zone. The free consultation cleared everything up in 30 minutes. Now my shop is open!',
    },
    {
      name: 'Ravi S.',
      role: 'Managing Director, Import/Export LLC',
      stars: 5,
      quote:
        'They handled all my MOA drafting, bank account opening, and PRO services. Truly all-inclusive. Saved me so much time.',
    },
    {
      name: 'Mohammed Al Zaabi',
      role: 'Partner, Construction Company',
      stars: 5,
      quote:
        'Dedicated account manager from start to finish. No call centre, no confusion. My license was ready ahead of schedule.',
    },
    {
      name: 'Elena P.',
      role: 'Founder, Digital Marketing Agency',
      stars: 5,
      quote:
        'Set up my agency remotely from Europe via WhatsApp. The team replied within minutes every time. Absolutely seamless.',
    },
    {
      name: 'Tariq B.',
      role: 'CEO, Healthcare Services',
      stars: 5,
      quote:
        'No hidden fees — exactly as promised. The quote was the final price. I highly recommend AtoZ to anyone starting in Abu Dhabi.',
    },
  ],

  // Process steps
  steps: [
    {
      n: '01',
      icon: '📞',
      title: 'Free 30-Min Consultation',
      desc: 'Book a free strategy call. We compare Mainland vs Free Zone options and help you choose the right structure for your goals.',
    },
    {
      n: '02',
      icon: '📋',
      title: 'Document Preparation',
      desc: 'We prepare all required paperwork — MOA drafting, trade name reservation, and authority forms. You review and sign.',
    },
    {
      n: '03',
      icon: '⚙️',
      title: 'Authority Submission Support',
      desc: 'We prepare and submit all documents to the relevant Abu Dhabi authorities on your behalf — ADDED or your chosen Free Zone.',
    },
    {
      n: '04',
      icon: '🎉',
      title: 'Setup Complete',
      desc: 'Once approved by the authority, we deliver your trade license and guide you through bank account opening — step by step.',
    },
  ],

  // FAQ
  faqs: [
    {
      q: 'How long does business setup take in Abu Dhabi?',
      a: 'With our fast-track application support, timelines are minimised. Our consultants give realistic estimates during your free 30-min consultation based on your specific business activity.',
    },
    {
      q: 'Mainland or Free Zone or Offshore — which is right for me?',
      a: 'Confused by the options? We compare all three for you on a free 30-min call. It depends on your customers, tax goals, and business activity.',
    },
    {
      q: 'What is included in your all-inclusive packages?',
      a: 'Our all-inclusive packages cover trade name reservation, MOA drafting, documentation, authority submissions, compliance services, VAT registration guidance, and bank account assistance. PRO services and a dedicated account manager are included.',
    },
    {
      q: 'Do I need a local sponsor?',
      a: 'Most activities now allow 100% foreign ownership. We confirm exactly what applies to your business type during the free consultation.',
    },
    {
      q: 'Are there any hidden fees?',
      a: 'No hidden fees — promise. Our quote is your final price unless you add new services. We are committed to 100% transparent pricing.',
    },
  ],
};
// ─────────────────────────────────────────────

const whatsappNumber = BUSINESS_INFO.whatsapp.replace(/[^0-9]/g, '');
const whatsappLink = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(page.whatsappMessage)}`;
const phoneHref = `tel:${BUSINESS_INFO.phone.replace(/\s/g, '')}`;

// ─── JSON-LD Structured Data ──────────────────────────────────────────────────
const _siteUrl = 'https://atozbusiness.ae';
const _pageUrl = `${_siteUrl}/business-setup-abudhabi`;

const schemaLocalBusiness = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${_siteUrl}/#business`,
  name: 'A to Z Business Setup',
  legalName: BUSINESS_LICENSE.registeredName,
  description: page.metaDescription,
  url: _siteUrl,
  telephone: '+971565331632',
  email: BUSINESS_INFO.email,
  priceRange: '$$',
  currenciesAccepted: 'AED',
  paymentAccepted: 'Cash, Credit Card, Bank Transfer',
  address: {
    '@type': 'PostalAddress',
    streetAddress: LOCATIONS.main.address,
    addressLocality: 'Abu Dhabi',
    addressRegion: 'Abu Dhabi',
    addressCountry: 'AE',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: LOCATIONS.main.coordinates.latitude,
    longitude: LOCATIONS.main.coordinates.longitude,
  },
  hasMap: LOCATIONS.main.mapsLink,
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
      opens: '08:00',
      closes: '21:00',
    },
  ],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.9',
    reviewCount: '127',
    bestRating: '5',
    worstRating: '1',
  },
  sameAs: [
    SOCIAL_MEDIA.facebook,
    SOCIAL_MEDIA.instagram,
    SOCIAL_MEDIA.linkedin,
    SOCIAL_MEDIA.twitter,
  ],
};

const schemaFAQ = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: page.faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const schemaService = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Business Setup Abu Dhabi',
  alternateName: [
    'Company Formation Abu Dhabi',
    'Trade License Abu Dhabi',
    'Business Registration UAE',
  ],
  description:
    'End-to-end business setup in Abu Dhabi: Mainland, Free Zone & Offshore company formation, trade license, MOA drafting, PRO services, and bank account assistance.',
  provider: { '@id': `${_siteUrl}/#business` },
  areaServed: {
    '@type': 'City',
    name: 'Abu Dhabi',
    sameAs: 'https://www.wikidata.org/wiki/Q35178',
  },
  serviceType: 'Business Formation Consultancy',
  url: _pageUrl,
  offers: {
    '@type': 'Offer',
    name: 'Free 30-Minute Business Setup Consultation',
    price: '0',
    priceCurrency: 'AED',
    description:
      'Free 30-minute consultation to compare Mainland vs Free Zone options for your Abu Dhabi business.',
  },
};

const schemaBreadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: _siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Business Setup Abu Dhabi', item: _pageUrl },
  ],
};
---

<BaseLayout
  title={page.metaTitle}
  description={page.metaDescription}
  showFloating={false}
  showNav={false}
>
  <!-- ── HEAD: SEO schemas + geo + robots ─────────────────────────────────── -->
  <Fragment slot="head">
    <!-- Explicit indexing directive with rich-snippet allowances -->
    <meta
      name="robots"
      content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
    />
    <!-- Geo targeting — Abu Dhabi, UAE -->
    <meta name="geo.region" content="AE-AZ" />
    <meta name="geo.placename" content="Abu Dhabi" />
    <meta name="geo.position" content="24.473660;54.352215" />
    <meta name="ICBM" content="24.473660, 54.352215" />
    <!-- JSON-LD: LocalBusiness (address, hours, rating, map) -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaLocalBusiness)} />
    <!-- JSON-LD: FAQPage → FAQ rich results in Google SERP -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaFAQ)} />
    <!-- JSON-LD: Service → what we offer + free consultation offer -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaService)} />
    <!-- JSON-LD: BreadcrumbList → navigation path in search snippet -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaBreadcrumb)} />
  </Fragment>

  <LPTrustBar />
  <LPHeader title="A to Z Business" />

  <main style="padding-bottom: 0;">
    <!-- ① HERO -->
    <section class="hero">
      <div class="hero-inner container">
        <div class="hero-copy">
          <div class="badge">{page.badge}</div>
          <h1>{page.headline}</h1>
          <p class="sub">{page.subHeadline}</p>
          <ul class="bullets">
            {page.bullets.map((b) => <li>✅ {b}</li>)}
          </ul>
          <div class="cta-group">
            <a href={phoneHref} class="btn-primary">📞 Call Now — Free Consultation</a>
            <a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="btn-wa"
              >💬 WhatsApp Us</a
            >
          </div>
          <p class="micro">⚡ We reply within 1 minute · 🔒 100% confidential</p>
        </div>
      </div>
    </section>

    <!-- ② OFFER -->
    <section class="offer">
      <div class="container">
        <h2>{page.offerHeadline}</h2>
        <p class="offer-text">{page.offerText}</p>
      </div>
    </section>

    <!-- ③ HIGHLIGHTS -->
    <section class="section-light">
      <div class="container">
        <h2>All-Inclusive Setup Packages</h2>
        <p class="sub-label">
          Everything handled end-to-end by our bilingual Abu Dhabi team. No hidden fees — promise.
        </p>
        <div class="grid-3">
          {
            page.highlights.map((h) => (
              <div class="card">
                <div class="card-icon">{h.icon}</div>
                <h3>{h.title}</h3>
                <p>{h.desc}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ④ STATS BAR -->
    <section class="stats-bar">
      <div class="container stats-grid">
        {
          page.stats.map((s) => (
            <div class="stat">
              <span class="stat-num">{s.num}</span>
              <span class="stat-label">{s.label}</span>
            </div>
          ))
        }
      </div>
    </section>

    <!-- ⑤ TESTIMONIALS -->
    <section class="section-light">
      <div class="container">
        <h2>Talk to a Real Consultant — See What Clients Say</h2>
        <div class="testimonial-carousel-wrap">
          <div class="testimonial-track" id="testimonialTrack">
            {
              page.testimonials.map((t, i) => (
                <div class="testimonial" data-index={i}>
                  <div class="stars">{'⭐'.repeat(t.stars)}</div>
                  <blockquote>"{t.quote}"</blockquote>
                  <p class="t-name">— {t.name}</p>
                  <p class="t-role">{t.role}</p>
                </div>
              ))
            }
          </div>
          <div class="carousel-dots" id="carouselDots">
            {
              page.testimonials.map((_, i) => (
                <button
                  class={`dot${i === 0 ? ' active' : ''}`}
                  data-index={i}
                  aria-label={`Testimonial ${i + 1}`}
                />
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- ⑥ PROCESS -->
    <section class="section-white">
      <div class="container">
        <h2>PRO + More Services Included — 4 Simple Steps to Launch</h2>
        <div class="steps-grid">
          {
            page.steps.map((s) => (
              <div class="step">
                <div class="step-num">{s.n}</div>
                <div class="step-icon">{s.icon}</div>
                <h3>{s.title}</h3>
                <p>{s.desc}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ⑦ FAQ -->
    <section class="section-light">
      <div class="container faq-wrap">
        <h2>Frequently Asked Questions</h2>
        <p class="sub-label">
          Confused by Abu Dhabi setup options? We answer the most common questions below.
        </p>
        <div class="accordion">
          {
            page.faqs.map((f) => (
              <details class="faq-item">
                <summary>{f.q}</summary>
                <p class="faq-answer">{f.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ⑧ CONTACT FORM -->
    <section class="contact" id="contact">
      <div class="container contact-inner">
        <div class="contact-copy">
          <h2>Get Your Free Quote Now</h2>
          <p>
            Call AtoZ Business Today — or WhatsApp us for an instant reply. Book your free 30-min
            consultation. No hidden fees. No obligation.
          </p>
          <ul class="bullets-white">
            <li>✅ Free 30-Min Consultation</li>
            <li>✅ Bilingual Team Support (EN/AR)</li>
            <li>✅ Dedicated Account Manager</li>
            <li>✅ WhatsApp & Phone Support</li>
          </ul>
        </div>
        <form class="lead-form" action="https://api.web3forms.com/submit" method="POST">
          <input type="hidden" name="access_key" value="59338c35-f3ad-474d-99b6-c11817de7a6c" />
          <input type="hidden" name="subject" value="New Lead: Business Setup Abu Dhabi" />
          <div class="form-row">
            <label for="f-name">Full Name *</label>
            <input type="text" id="f-name" name="name" required placeholder="Enter your name" />
          </div>
          <div class="form-row">
            <label for="f-phone">WhatsApp Number *</label>
            <input type="tel" id="f-phone" name="phone" required placeholder="+971 XX XXX XXXX" />
          </div>
          <div class="form-row">
            <label for="f-email">Email *</label>
            <input type="email" id="f-email" name="email" required placeholder="you@example.com" />
          </div>
          <div class="form-row">
            <label for="f-service">Service of Interest *</label>
            <select id="f-service" name="service" required>
              <option value="">Select an option</option>
              <option>Mainland Setup</option>
              <option>Free Zone Setup</option>
              <option>Business Support / PRO</option>
              <option>Trade Name Renewal</option>
              <option>Not sure — Need consultation</option>
            </select>
          </div>
          <button type="submit" class="btn-submit">Book My Free Consultation →</button>
          <p class="disclaimer">
            🔒 Your information is 100% confidential. We respect your privacy.
          </p>
        </form>
      </div>
    </section>
  </main>

  <!-- ⑨ FOOTER -->
  <footer class="foot">
    <div class="container foot-inner">
      <div>
        <p class="foot-brand">A to Z Business Setup</p>
        <p>Abu Dhabi's trusted business formation specialists.</p>
      </div>
      <div class="foot-links">
        <a href="/privacy-policy">Privacy Policy</a>
        <a href="/terms">Terms of Service</a>
        <a href="/about">About Us</a>
        <a href="/contact">Contact</a>
      </div>
    </div>

    <!-- Trust Boxes -->
    <div class="container trust-boxes">
      <!-- Box 1: Official License Credentials -->
      <div class="trust-box trust-box-centered">
        <div class="trust-box-header">
          <span class="trust-icon">🏛️</span>
          <h4>Licensed & Regulated Business</h4>
        </div>
        <p class="reg-label">Registered Business Name</p>
        <p class="reg-name">{BUSINESS_LICENSE.registeredName}</p>
        <p class="reg-auth">Issued by ADDED · Abu Dhabi, UAE</p>
      </div>

      <!-- Box 2: Our 2 Locations -->
      <div class="trust-box">
        <div class="trust-box-header">
          <span class="trust-icon">📍</span>
          <h4>Our Office Locations</h4>
        </div>
        <div class="location-row">
          <p class="loc-name">{LOCATIONS.main.name}</p>
          <p class="loc-addr">{LOCATIONS.main.address}</p>
          <p class="loc-city">{LOCATIONS.main.city}, UAE</p>
          <a
            href={LOCATIONS.main.mapsLink}
            target="_blank"
            rel="noopener noreferrer"
            class="loc-link">📍 Get Directions</a
          >
        </div>
        <div class="loc-divider"></div>
        <div class="location-row">
          <p class="loc-name">{LOCATIONS.branch.name}</p>
          <p class="loc-addr">{LOCATIONS.branch.address}</p>
          <p class="loc-city">{LOCATIONS.branch.city}, UAE</p>
          <a
            href={LOCATIONS.branch.mapsLink}
            target="_blank"
            rel="noopener noreferrer"
            class="loc-link">📍 Get Directions</a
          >
        </div>
      </div>
    </div>
    <!-- End Trust Boxes -->

    <div class="foot-bottom">
      <p>
        © {new Date().getFullYear()} A to Z Business Setup. All rights reserved. · Abu Dhabi, UAE
      </p>
    </div>

    <!-- ⑩ LEGAL DISCLAIMER — Google Ads Policy Compliant -->
    <div class="legal-disclaimer" id="legal-disclaimer">
      <div class="container">
        <div class="disclaimer-header">
          <span class="disclaimer-icon">⚖️</span>
          <strong>Important Legal Disclaimer</strong>
        </div>
        <div class="disclaimer-body">
          <p>
            <strong>A to Z Business Setup</strong> is an independent, privately owned business consultancy
            registered and licensed in Abu Dhabi, UAE. We are <strong>not</strong> a government body,
            government agency, or official authority. We are not affiliated with, endorsed by, or acting
            on behalf of the Abu Dhabi Department of Economic Development (ADDED), the Department of Economic
            Development Dubai (DED), the Abu Dhabi Global Market (ADGM), any UAE Free Zone Authority,
            or any other government or regulatory entity.
          </p>
          <p>
            All services offered — including trade license applications, company formation support,
            document preparation, PRO services, and authority submission assistance — are provided
            as a private professional consultancy. Final approvals, licensing decisions, and
            processing timelines are solely at the discretion of the relevant UAE government
            authority.
          </p>
          <p>
            <strong>Statistics & Claims:</strong> Figures such as "15,000+ Clients Served", "127+ Verified
            Reviews", "⭐ 4.9 Google Rating", and "10+ Years in Abu Dhabi" are based on internal records
            and publicly available review data at the time of publication and are subject to change. Past
            performance does not guarantee future results.
          </p>
          <p>
            <strong>Response Times:</strong> Claims such as "reply within 1 minute" refer to our target
            business-hours response standard and are not a contractual guarantee. Response times may vary
            depending on query volume and operating hours.
          </p>
          <p>
            <strong>Pricing:</strong> All quoted fees are for our professional consultancy services only.
            Government fees, authority charges, notarisation costs, and third-party expenses are separate
            and payable directly to the relevant authority or service provider. Full cost breakdowns are
            provided during consultation prior to any engagement.
          </p>
          <p>
            By submitting an enquiry or contacting us, you acknowledge that you are engaging a
            private business consultancy and not a government service. This website does not
            constitute legal or financial advice. For official government services, please visit the
            relevant UAE authority websites directly.
          </p>
        </div>
      </div>
    </div>
    <!-- End Legal Disclaimer -->
  </footer>

  <!-- Mobile sticky bar — hidden on desktop -->
  <div class="mob-bar">
    <a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="mob-wa">💬 WhatsApp</a>
    <a href={phoneHref} class="mob-call">📞 Call Now</a>
    <a href="#contact" class="mob-quote">Get Quote</a>
  </div>

  <!-- LPFloatingButtons removed — sticky bar is the single CTA source on mobile -->

  <style>
    *,
    *::before,
    *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    :root {
      /* ── Brand colours (from tailwind.config.js) ─────────────────── */
      --primary: #2a5298; /* primary-500  */
      --navy: #1a3260; /* primary-700  */
      --dark: #122140; /* primary-800  */
      --accent: #f59e0b; /* accent-500   */
      --accent-h: #c47e09; /* accent-600   */
      --green: #16a34a; /* WhatsApp std */
      --green-h: #15803d;
      --white: #fff;
      --g50: #f9fafb; /* neutral-50   */
      --g600: #4b5563; /* neutral-600  */
      --g700: #374151; /* neutral-700  */
      --r: 1rem;
      --sh: 0 4px 24px rgba(0, 0, 0, 0.1);
      --shl: 0 8px 40px rgba(0, 0, 0, 0.16);
    }
    html {
      scroll-behavior: smooth;
      scroll-padding-top: 72px;
    }
    body {
      font-family: 'Inter', system-ui, sans-serif; /* brand sans font */
      color: var(--g700);
      background: var(--white);
    }
    h2 {
      font-family: 'Outfit', 'Inter', sans-serif; /* brand display font */
      font-size: clamp(1.5rem, 3vw, 2.25rem);
      font-weight: 800;
      color: var(--dark);
      line-height: 1.2;
      margin-bottom: 1rem;
    }
    h3 {
      font-family: 'Outfit', 'Inter', sans-serif; /* brand display font */
      font-size: 1.1rem;
      font-weight: 700;
      color: var(--dark);
      margin-bottom: 0.4rem;
    }
    p {
      line-height: 1.7;
      color: var(--g600);
    }
    a {
      text-decoration: none;
    }
    .container {
      max-width: 1120px;
      margin: 0 auto;
