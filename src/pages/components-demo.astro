---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import Heading from '../components/ui/Heading.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import Badge from '../components/ui/Badge.astro';
import Grid from '../components/ui/Grid.astro';
import Icon from '../components/icons/Icon';
---

<BaseLayout
  title="Component Library"
  description="UI Component showcase for AtoZ Business Services"
>
  <!-- Hero Section -->
  <Section background="gradient" padding="lg">
    <Container>
      <div class="text-center max-w-3xl mx-auto">
        <Heading as="h1" size="6xl" gradient> Component Library </Heading>
        <p class="text-xl text-gray-600 mt-4">
          A showcase of all UI components used in the AtoZ Business Services website.
        </p>
      </div>
    </Container>
  </Section>

  <!-- Color Palette -->
  <Section>
    <Container>
      <Heading as="h2" class="mb-8">Color Palette</Heading>
      <Grid cols="3">
        <div>
          <h3 class="font-semibold mb-4">Primary Blue</h3>
          <div class="space-y-2">
            <div
              class="h-16 bg-primary-500 rounded-lg shadow-md flex items-center justify-center text-white font-medium"
            >
              #2A5298
            </div>
            <div class="flex gap-2">
              <div class="h-12 bg-primary-100 rounded flex-1"></div>
              <div class="h-12 bg-primary-300 rounded flex-1"></div>
              <div class="h-12 bg-primary-700 rounded flex-1"></div>
            </div>
          </div>
        </div>
        <div>
          <h3 class="font-semibold mb-4">Secondary Blue</h3>
          <div class="space-y-2">
            <div
              class="h-16 bg-secondary-500 rounded-lg shadow-md flex items-center justify-center text-white font-medium"
            >
              #2D86C7
            </div>
            <div class="flex gap-2">
              <div class="h-12 bg-secondary-100 rounded flex-1"></div>
              <div class="h-12 bg-secondary-300 rounded flex-1"></div>
              <div class="h-12 bg-secondary-700 rounded flex-1"></div>
            </div>
          </div>
        </div>
        <div>
          <h3 class="font-semibold mb-4">Accent Orange</h3>
          <div class="space-y-2">
            <div
              class="h-16 bg-accent-500 rounded-lg shadow-md flex items-center justify-center text-white font-medium"
            >
              #F59E0B
            </div>
            <div class="flex gap-2">
              <div class="h-12 bg-accent-100 rounded flex-1"></div>
              <div class="h-12 bg-accent-300 rounded flex-1"></div>
              <div class="h-12 bg-accent-700 rounded flex-1"></div>
            </div>
          </div>
        </div>
      </Grid>
    </Container>
  </Section>

  <!-- Typography -->
  <Section background="gray">
    <Container>
      <Heading as="h2" class="mb-8">Typography</Heading>
      <div class="space-y-4 bg-white p-8 rounded-xl shadow-soft">
        <Heading as="h1">Heading 1 - Display Font</Heading>
        <Heading as="h2">Heading 2 - Display Font</Heading>
        <Heading as="h3">Heading 3 - Display Font</Heading>
        <Heading as="h4">Heading 4 - Display Font</Heading>
        <p class="text-lg">Large body text - Inter font family</p>
        <p>Regular body text - Inter font family with excellent readability</p>
        <p class="text-sm text-gray-600">Small text for captions and meta information</p>
      </div>
    </Container>
  </Section>

  <!-- Buttons -->
  <Section>
    <Container>
      <Heading as="h2" class="mb-8">Buttons</Heading>
      <div class="space-y-6">
        <!-- Button Variants -->
        <div>
          <h3 class="font-semibold mb-4">Variants</h3>
          <div class="flex flex-wrap gap-4">
            <Button variant="primary">Primary Button</Button>
            <Button variant="secondary">Secondary Button</Button>
            <Button variant="accent">Accent Button</Button>
            <Button variant="outline">Outline Button</Button>
            <Button variant="ghost">Ghost Button</Button>
          </div>
        </div>

        <!-- Button Sizes -->
        <div>
          <h3 class="font-semibold mb-4">Sizes</h3>
          <div class="flex flex-wrap items-center gap-4">
            <Button size="sm">Small</Button>
            <Button size="md">Medium</Button>
            <Button size="lg">Large</Button>
          </div>
        </div>

        <!-- Button with Icons -->
        <div>
          <h3 class="font-semibold mb-4">With Icons</h3>
          <div class="flex flex-wrap gap-4">
            <Button variant="primary">
              <Icon name="Phone" size={20} className="mr-2" client:load />
              Call Now
            </Button>
            <Button variant="secondary">
              <Icon name="MessageCircle" size={20} className="mr-2" client:load />
              WhatsApp
            </Button>
            <Button variant="accent">
              <Icon name="ArrowRight" size={20} className="ml-2" client:load />
              Get Started
            </Button>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <!-- Cards -->
  <Section background="gray">
    <Container>
      <Heading as="h2" class="mb-8">Cards</Heading>
      <Grid cols="3">
        <Card variant="default">
          <h3 class="font-semibold text-lg mb-2">Default Card</h3>
          <p class="text-gray-600">Basic card with soft shadow effect.</p>
        </Card>
        <Card variant="hover">
          <h3 class="font-semibold text-lg mb-2">Hover Card</h3>
          <p class="text-gray-600">Card with hover animation and shadow lift.</p>
        </Card>
        <Card variant="bordered">
          <h3 class="font-semibold text-lg mb-2">Bordered Card</h3>
          <p class="text-gray-600">Card with border instead of shadow.</p>
        </Card>
      </Grid>
    </Container>
  </Section>

  <!-- Badges -->
  <Section>
    <Container>
      <Heading as="h2" class="mb-8">Badges</Heading>
      <div class="space-y-4">
        <div>
          <h3 class="font-semibold mb-3">Variants</h3>
          <div class="flex flex-wrap gap-3">
            <Badge variant="primary">Primary</Badge>
            <Badge variant="secondary">Secondary</Badge>
            <Badge variant="accent">Accent</Badge>
            <Badge variant="success">Success</Badge>
            <Badge variant="warning">Warning</Badge>
            <Badge variant="info">Info</Badge>
          </div>
        </div>
        <div>
          <h3 class="font-semibold mb-3">Sizes</h3>
          <div class="flex flex-wrap items-center gap-3">
            <Badge size="sm">Small</Badge>
            <Badge size="md">Medium</Badge>
            <Badge size="lg">Large</Badge>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <!-- Icons -->
  <Section background="gray">
    <Container>
      <Heading as="h2" class="mb-8">Icons (Lucide React)</Heading>
      <Card>
        <div class="grid grid-cols-4 md:grid-cols-6 lg:grid-cols-8 gap-6">
          <div class="flex flex-col items-center gap-2">
            <Icon name="Home" size={32} className="text-primary-500" client:load />
            <span class="text-xs text-gray-600">Home</span>
          </div>
          <div class="flex flex-col items-center gap-2">
            <Icon name="FileText" size={32} className="text-primary-500" client:load />
            <span class="text-xs text-gray-600">FileText</span>
          </div>
          <div class="flex flex-col items-center gap-2">
            <Icon name="Briefcase" size={32} className="text-primary-500" client:load />
            <span class="text-xs text-gray-600">Briefcase</span>
          </div>
          <div class="flex flex-col items-center gap-2">
            <Icon name="Users" size={32} className="text-primary-500" client:load />
            <span class="text-xs text-gray-600">Users</span>
          </div>
          <div class="flex flex-col items-center gap-2">
            <Icon name="MapPin" size={32} className="text-primary-500" client:load />
            <span class="text-xs text-gray-600">MapPin</span>
          </div>
          <div class="flex flex-col items-center gap-2">
            <Icon name="Phone" size={32} className="text-primary-500" client:load />
            <span class="text-xs text-gray-600">Phone</span>
          </div>
          <div class="flex flex-col items-center gap-2">
            <Icon name="Mail" size={32} className="text-primary-500" client:load />
            <span class="text-xs text-gray-600">Mail</span>
          </div>
          <div class="flex flex-col items-center gap-2">
            <Icon name="Globe" size={32} className="text-primary-500" client:load />
            <span class="text-xs text-gray-600">Globe</span>
          </div>
        </div>
      </Card>
    </Container>
  </Section>

  <!-- Grid Layouts -->
  <Section>
    <Container>
      <Heading as="h2" class="mb-8">Grid Layouts</Heading>
      <div class="space-y-8">
        <div>
          <h3 class="font-semibold mb-4">2 Columns</h3>
          <Grid cols="2">
            <Card
              ><div class="h-24 flex items-center justify-center text-gray-600">Item 1</div></Card
            >
            <Card
              ><div class="h-24 flex items-center justify-center text-gray-600">Item 2</div></Card
            >
          </Grid>
        </div>
        <div>
          <h3 class="font-semibold mb-4">3 Columns</h3>
          <Grid cols="3">
            <Card
              ><div class="h-24 flex items-center justify-center text-gray-600">Item 1</div></Card
            >
            <Card
              ><div class="h-24 flex items-center justify-center text-gray-600">Item 2</div></Card
            >
            <Card
              ><div class="h-24 flex items-center justify-center text-gray-600">Item 3</div></Card
            >
          </Grid>
        </div>
        <div>
          <h3 class="font-semibold mb-4">4 Columns</h3>
          <Grid cols="4">
            <Card
              ><div class="h-24 flex items-center justify-center text-gray-600">Item 1</div></Card
            >
            <Card
              ><div class="h-24 flex items-center justify-center text-gray-600">Item 2</div></Card
            >
            <Card
              ><div class="h-24 flex items-center justify-center text-gray-600">Item 3</div></Card
            >
            <Card
              ><div class="h-24 flex items-center justify-center text-gray-600">Item 4</div></Card
            >
          </Grid>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>
