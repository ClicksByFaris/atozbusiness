---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
---

<BaseLayout
  title="404 - Page Not Found"
  description="The page you are looking for could not be found."
>
  <div
    class="min-h-[70vh] flex items-center justify-center relative overflow-hidden bg-neutral-950 py-20"
  >
    <!-- Background Accents -->
    <div
      class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(42,82,152,0.1),transparent_50%)]"
    >
    </div>
    <div
      class="absolute inset-0 bg-[radial-gradient(circle_at_bottom_left,rgba(212,175,55,0.05),transparent_50%)]"
    >
    </div>
    <div class="absolute inset-0 bg-[url('/noise.png')] opacity-[0.03] mix-blend-overlay"></div>

    <Container class="relative z-10 text-center">
      <div
        class="inline-flex items-center justify-center px-4 py-1.5 rounded-full bg-white/5 border border-white/10 text-neutral-400 text-sm font-medium mb-8 animate-fade-in-up"
      >
        Error 404
      </div>

      <h1
        class="text-7xl md:text-9xl font-display font-bold text-white mb-6 animate-fade-in-up"
        style="animation-delay: 100ms;"
      >
        4<span class="text-secondary-500">0</span>4
      </h1>

      <p
        class="text-xl md:text-2xl font-medium text-neutral-300 mb-4 max-w-2xl mx-auto animate-fade-in-up"
        style="animation-delay: 200ms;"
      >
        Oops! The page you're looking for seems to have vanished.
      </p>

      <p
        class="text-neutral-500 mb-10 max-w-md mx-auto animate-fade-in-up"
        style="animation-delay: 300ms;"
      >
        The link might be broken, or the page may have been removed or renamed. Let's get you back
        on track to exploring our services.
      </p>

      <div
        class="flex flex-col sm:flex-row items-center justify-center gap-4 animate-fade-in-up"
        style="animation-delay: 400ms;"
      >
        <a
          href="/"
          class="group relative w-full sm:w-auto flex items-center justify-center gap-3 bg-white text-primary-950 px-8 py-4 rounded-xl font-bold overflow-hidden transition-transform hover:scale-105"
        >
          <div
            class="absolute inset-0 bg-secondary-500 translate-y-full group-hover:translate-y-0 transition-transform duration-300 ease-out"
          >
          </div>
          <span class="relative z-10 group-hover:text-white transition-colors duration-300"
            >Return Home</span
          >
        </a>

        <a
          href="/contact"
          class="flex items-center justify-center w-full sm:w-auto gap-3 px-8 py-4 rounded-xl font-bold text-white border border-white/10 hover:bg-white/5 transition-colors"
        >
          Contact Support
        </a>
      </div>
    </Container>
  </div>
</BaseLayout>
