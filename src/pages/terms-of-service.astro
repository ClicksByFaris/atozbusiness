---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Heading from '../components/ui/Heading.astro';
import Section from '../components/ui/Section.astro';
import Breadcrumbs from '../components/shared/Breadcrumbs.astro';

const breadcrumbs = [{ name: 'Terms of Service', url: '/terms-of-service' }];

const lastUpdated = 'January 21, 2026';
---

<BaseLayout
  title="Terms of Service"
  description="Terms of Service for A to Z Business Services - Usage agreement and policies."
>
  <Section
    class="pt-32 pb-16 bg-primary-50 dark:bg-neutral-900 border-b border-neutral-200 dark:border-neutral-800"
  >
    <Container>
      <Breadcrumbs items={breadcrumbs} class="mb-6" />
      <Heading tag="h1" size="5xl" class="mb-4">Terms of Service</Heading>
      <p class="text-neutral-600 dark:text-neutral-400 text-lg">Last updated: {lastUpdated}</p>
    </Container>
  </Section>

  <Section class="py-16">
    <Container>
      <div class="max-w-4xl mx-auto space-y-12 text-neutral-700 dark:text-neutral-300">
        <div class="space-y-4">
          <Heading tag="h2" size="2xl" class="text-primary-800 dark:text-primary-200"
            >1. Agreement to Terms</Heading
          >
          <p class="leading-relaxed">
            These Terms of Service constitute a legally binding agreement made between you, whether
            personally or on behalf of an entity ("you") and A to Z Business Services ("we," "us,"
            or "our"), concerning your access to and use of the atozbusiness.ae website as well as
            any other media form, media channel, mobile website or mobile application related,
            linked, or otherwise connected thereto (collectively, the "Site").
          </p>
          <p class="leading-relaxed">
            You agree that by accessing the Site, you have read, understood, and agreed to be bound
            by all of these Terms of Service. If you do not agree with all of these terms of
            service, then you are expressly prohibited from using the site and you must discontinue
            use immediately.
          </p>
        </div>

        <div class="space-y-4">
          <Heading tag="h2" size="2xl" class="text-primary-800 dark:text-primary-200"
            >2. Service Description</Heading
          >
          <p class="leading-relaxed">
            A to Z Business Services provides document clearing, typing, and business setup services
            in Abu Dhabi, UAE. We act as an intermediary between clients and various government
            departments. While we strive to ensure the accuracy and timely processing of all
            applications, the final approval of any visa, license, or permit lies solely with the
            respective government authority.
          </p>
        </div>

        <div class="space-y-4">
          <Heading tag="h2" size="2xl" class="text-primary-800 dark:text-primary-200"
            >3. User Representations</Heading
          >
          <p class="leading-relaxed">
            By using the Site and our services, you represent and warrant that:
          </p>
          <ul class="list-disc pl-6 space-y-2 marker:text-primary-500">
            <li>
              All registration information you submit will be true, accurate, current, and complete.
            </li>
            <li>
              You will maintain the accuracy of such information and promptly update such
              registration information as necessary.
            </li>
            <li>
              You have the legal capacity and you agree to comply with these Terms of Service.
            </li>
            <li>You are not a minor in the jurisdiction in which you reside.</li>
            <li>You will not use the Site for any illegal or unauthorized purpose.</li>
          </ul>
        </div>

        <div class="space-y-4">
          <Heading tag="h2" size="2xl" class="text-primary-800 dark:text-primary-200"
            >4. Payment and Refunds</Heading
          >
          <p class="leading-relaxed">
            <strong>Payment:</strong> All fees for our services and government processing must be paid
            in advance or as agreed upon. We accept cash, credit cards, and bank transfers.
          </p>
          <p class="leading-relaxed">
            <strong>Refunds:</strong> Government fees are generally non-refundable once the application
            has been submitted to the authority. Our service fees may be refunded in part or full only
            if the service was not rendered due to an error on our part. Rejection of an application by
            government authorities for reasons beyond our control (e.g., security ban, insufficient documents
            provided by client) does not entitle the client to a refund of service fees.
          </p>
        </div>

        <div class="space-y-4">
          <Heading tag="h2" size="2xl" class="text-primary-800 dark:text-primary-200"
            >5. Limitation of Liability</Heading
          >
          <p class="leading-relaxed">
            In no event will we or our directors, employees, or agents be liable to you or any third
            party for any direct, indirect, consequential, exemplary, incidental, special, or
            punitive damages, including lost profit, lost revenue, loss of data, or other damages
            arising from your use of the site or our services, even if we have been advised of the
            possibility of such damages.
          </p>
        </div>

        <div class="space-y-4">
          <Heading tag="h2" size="2xl" class="text-primary-800 dark:text-primary-200"
            >6. Governing Law</Heading
          >
          <p class="leading-relaxed">
            These Terms shall be governed by and defined following the laws of the United Arab
            Emirates. A to Z Business Services and yourself irrevocably consent that the courts of
            Abu Dhabi, UAE shall have exclusive jurisdiction to resolve any dispute which may arise
            in connection with these terms.
          </p>
        </div>

        <div class="space-y-4">
          <Heading tag="h2" size="2xl" class="text-primary-800 dark:text-primary-200"
            >7. Contact Us</Heading
          >
          <p class="leading-relaxed">
            In order to resolve a complaint regarding the Site or to receive further information
            regarding use of the Site, please contact us at:
          </p>
          <div class="mt-4 p-6 bg-neutral-50 dark:bg-neutral-800 rounded-lg">
            <p class="font-bold text-primary-900 dark:text-primary-100">A to Z Business Services</p>
            <p>Mohammed Alhur Al Suwaidi St, Khalidiya</p>
            <p>Abu Dhabi, United Arab Emirates</p>
            <p class="mt-2">Phone: +971 50 348 9891</p>
            <p>Email: contact@atozbusiness.ae</p>
          </div>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>
