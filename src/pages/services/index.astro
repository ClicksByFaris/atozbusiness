---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import Section from '../../components/ui/Section.astro';
import ServiceCard from '../../components/services/ServiceCard.astro';
import CTASection from '../../components/home/CTASection.astro';
import { SERVICES_DATA } from '../../lib/services-data';

// Get unique categories
const categories = [...new Set(SERVICES_DATA.map((s) => s.category))];

// Organize services by category
const servicesByCategory = categories.map((category) => ({
  name: category,
  services: SERVICES_DATA.filter((s) => s.category === category),
}));
---

<BaseLayout
  title="Our Services | A to Z Business Abu Dhabi"
  description="Explore our comprehensive range of government and business services in Abu Dhabi. From visas to company formation, we handle it all."
>
  <div
    class="bg-gradient-to-br from-primary-900 via-primary-800 to-black text-white py-24 relative overflow-hidden"
  >
    <div class="absolute inset-0 bg-[url('/patterns/grid.svg')] opacity-10"></div>
    <Container>
      <div class="relative z-10 max-w-3xl">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6">Type Less, Do More.</h1>
        <p class="text-xl md:text-2xl text-neutral-300 max-w-2xl leading-relaxed">
          Professional government, visa, and business setup services designed to save you time and
          hassle.
        </p>
      </div>
    </Container>
  </div>

  <Section class="bg-neutral-50">
    <Container>
      {
        servicesByCategory.map((category, index) => (
          <div class={index !== 0 ? 'mt-20' : ''}>
            <h2 class="text-2xl md:text-3xl font-bold text-neutral-900 mb-8 border-l-4 border-secondary-500 pl-4">
              {category.name} Services
            </h2>
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
              {category.services.map((service) => (
                <ServiceCard
                  name={service.name}
                  description={service.shortDescription}
                  icon={service.icon}
                  slug={service.slug}
                  category={service.category}
                />
              ))}
            </div>
          </div>
        ))
      }
    </Container>
  </Section>

  <CTASection />
</BaseLayout>
