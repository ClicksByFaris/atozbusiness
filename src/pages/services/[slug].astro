---
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import ServiceHero from '../../components/services/ServiceHero.astro';
import ServiceBanner from '../../components/services/ServiceBanner.astro';
import ServiceFeatures from '../../components/services/ServiceFeatures.astro';
import ServiceProcess from '../../components/services/ServiceProcess.astro';
import ServiceDocuments from '../../components/services/ServiceDocuments.astro';
import ServiceFAQ from '../../components/services/ServiceFAQ.astro';
import RelatedServicesSidebar from '../../components/services/RelatedServicesSidebar.astro';
import RelatedBlogsSidebar from '../../components/services/RelatedBlogsSidebar.astro';
import SidebarSticky from '../../components/blog/SidebarSticky.astro';
import CTASection from '../../components/home/CTASection.astro';
import Breadcrumbs from '../../components/shared/Breadcrumbs.astro';
import Container from '../../components/ui/Container.astro';
import { sanityClient } from '../../lib/sanity';
import { servicesQuery, serviceBySlugQuery } from '../../lib/queries';
import type { Service } from '../../types';

export const prerender = true;

export async function getStaticPaths() {
  try {
    const services: Service[] = await sanityClient.fetch(servicesQuery);

    if (!services || services.length === 0) {
      console.warn('No services found in Sanity CMS');
      return [];
    }

    return services.map((service) => ({
      params: { slug: service.slug.current },
    }));
  } catch (error) {
    console.error('Error fetching services for static paths:', error);
    return [];
  }
}

const { slug } = Astro.params;

let service: Service | null = null;
try {
  service = await sanityClient.fetch(serviceBySlugQuery, { slug });
} catch (error) {
  console.error(`Error fetching service with slug "${slug}":`, error);
}

if (!service) {
  return new Response(null, {
    status: 404,
    statusText: 'Not Found',
  });
}

const breadcrumbs = [
  { name: 'Services', url: '/services' },
  { name: service.title, url: `/services/${service.slug.current}` },
];

// Map string array to object array for ServiceDocuments
const documents = service.documentsRequired?.map((doc) => ({ name: doc, required: true })) || [];

// Map process steps
const processMap =
  service.processSteps?.map((step: any, idx: number) => ({
    step: idx + 1,
    title: step.step || `Step ${idx + 1}`,
    description: step.description,
  })) || [];
---

<ServiceLayout service={service}>
  <ServiceHero
    name={service.title}
    description={service.excerpt}
    icon={service.icon || 'FileText'}
    image={service.featuredImage}
  />

  <Container class="pt-4 pb-12">
    <div class="mb-4">
      <Breadcrumbs items={breadcrumbs} />
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 md:gap-12 lg:gap-16">
      <!-- Main Content -->
      <div class="lg:col-span-8 space-y-12">
        <ServiceFeatures features={service.features || []} fullDescription={service.description} />
        {processMap.length > 0 && <ServiceProcess process={processMap} />}
        {documents.length > 0 && <ServiceDocuments documents={documents} />}
        {service.faq && service.faq.length > 0 && <ServiceFAQ faqs={service.faq} />}
      </div>

      <!-- Sidebar -->
      <SidebarSticky topOffset="6rem">
        <RelatedServicesSidebar services={service.relatedServices || []} />
        {
          service.relatedBlogs && service.relatedBlogs.length > 0 && (
            <RelatedBlogsSidebar posts={service.relatedBlogs} />
          )
        }
      </SidebarSticky>
    </div>
  </Container>

  <CTASection />
</ServiceLayout>
