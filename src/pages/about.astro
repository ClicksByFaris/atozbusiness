---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import Heading from '../components/ui/Heading.astro';
import Button from '../components/ui/Button.astro';
import ValueCard from '../components/about/ValueCard.astro';
import Icon from '../components/icons/Icon';
import { ABOUT_DATA } from '../lib/about-data';
import { generateOrganizationSchema } from '../lib/schemas/organization';

const organizationSchema = generateOrganizationSchema();

const pageTitle = 'About Us | A to Z Business Services';
const pageDescription =
  "Learn about A to Z Business Services - Abu Dhabi's trusted PRO services and typing center. Our mission, values, and experienced team dedicated to simplifying government transactions.";
---

<BaseLayout title={pageTitle} description={pageDescription} ogImage="/og-about.jpg">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  </Fragment>

  <!-- Hero Section -->
  <Section
    class="bg-gradient-to-br from-primary-950 via-primary-900 to-primary-800 text-white pt-24 pb-40 md:pt-32 md:pb-56 lg:pt-40 lg:pb-64 overflow-hidden relative"
  >
    <!-- Background Pattern & Effects -->
    <div class="absolute inset-0 z-0">
      <div
        class="absolute inset-0 bg-[linear-gradient(to_right,#ffffff08_1px,transparent_1px),linear-gradient(to_bottom,#ffffff08_1px,transparent_1px)] bg-[size:40px_40px]"
      >
      </div>
      <!-- Gradient overlay for depth -->
      <div
        class="absolute inset-0 bg-gradient-to-b from-primary-950/95 via-primary-900/90 to-primary-950/85"
      >
      </div>
    </div>

    <!-- Animated blobs for depth -->
    <div
      class="absolute -top-1/3 -left-1/4 w-2/3 h-2/3 bg-secondary-500/15 rounded-full blur-[140px] opacity-50 animate-pulse-slow pointer-events-none"
    >
    </div>
    <div
      class="absolute -bottom-1/3 -right-1/4 w-2/3 h-2/3 bg-accent-500/10 rounded-full blur-[140px] opacity-40 animate-pulse pointer-events-none"
    >
    </div>

    <Container>
      <div class="max-w-5xl mx-auto text-center relative z-10 px-4 sm:px-6 lg:px-8">
        <div class="reveal inline-block mb-6 md:mb-8" data-animation="animate-fade-in-up">
          <div
            class="inline-flex items-center gap-2 rounded-full bg-white/10 px-5 py-2.5 md:px-7 md:py-3 text-xs md:text-sm font-bold text-white backdrop-blur-md border border-white/20 uppercase tracking-widest shadow-lg"
          >
            <Icon name="Building2" className="w-4 h-4 md:w-5 md:h-5" client:idle />
            <span>Since {ABOUT_DATA.companyInfo.foundingYear}</span>
          </div>
        </div>

        <Heading
          level="h1"
          size="6xl"
          className="mb-6 md:mb-8 text-white reveal leading-[1.1] font-display text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold"
          data-animation="animate-fade-in-up"
          style="animation-delay: 100ms"
        >
          Your Trusted Partner in <span
            class="bg-gradient-to-r from-secondary-300 via-secondary-400 to-accent-400 bg-clip-text text-transparent"
            >Government Services</span
          >
        </Heading>
        <p
          class="text-lg sm:text-xl md:text-2xl lg:text-2xl text-primary-50/95 max-w-3xl mx-auto leading-relaxed reveal font-sans"
          data-animation="animate-fade-in-up"
          style="animation-delay: 200ms"
        >
          Making life in the <span class="text-accent-300 font-semibold">UAE</span> easier, one service
          at a time.
        </p>

        <!-- Stats Section -->
        <div
          class="mt-12 md:mt-16 grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6 max-w-4xl mx-auto reveal"
          data-animation="animate-fade-in-up"
          style="animation-delay: 300ms"
        >
          {
            ABOUT_DATA.statistics.map((stat, index) => (
              <div class="bg-white/5 backdrop-blur-md border border-white/10 rounded-2xl p-4 md:p-6 hover:bg-white/10 transition-all duration-300">
                <div class="w-10 h-10 md:w-12 md:h-12 rounded-xl bg-white/10 flex items-center justify-center mx-auto mb-3 md:mb-4">
                  <Icon
                    name={stat.icon as any}
                    className="w-5 h-5 md:w-6 md:h-6 text-accent-300"
                    client:idle
                  />
                </div>
                <p class="text-2xl md:text-3xl lg:text-4xl font-display font-bold text-white mb-1">
                  {stat.value}
                </p>
                <p class="text-xs md:text-sm text-primary-200 uppercase tracking-wider font-semibold">
                  {stat.label}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </Container>
  </Section>

  <!-- Company Story Section -->
  <Section>
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-center">
        <!-- Story Content -->
        <div class="space-y-6">
          <div
            class="inline-block text-sm font-bold uppercase tracking-wider text-primary-600 mb-4"
          >
            Our Story
          </div>
          <Heading level="h2" size="3xl">
            Building Trust Since {ABOUT_DATA.companyInfo.foundingYear}
          </Heading>
          <p class="text-lg leading-relaxed text-neutral-600">
            {ABOUT_DATA.companyInfo.history}
          </p>
        </div>

        <!-- Story Image -->
        <div class="order-first lg:order-last">
          <div class="relative rounded-2xl overflow-hidden aspect-[4/3]">
            <div
              class="w-full h-full bg-gradient-to-br from-primary-500 to-secondary-500 flex items-center justify-center"
            >
              <Icon name="Building2" className="w-24 h-24 text-white/50" client:idle />
            </div>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <!-- Mission & Vision Section -->
  <Section background="gradient">
    <Container>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
        <!-- Mission Card -->
        <div
          class="bg-white/5 backdrop-blur-md border border-white/10 rounded-2xl p-6 md:p-8 lg:p-12 text-center transition-all duration-300 hover:-translate-y-2 hover:bg-white/10"
        >
          <div
            class="w-16 h-16 rounded-xl bg-gradient-to-br from-primary-500 to-secondary-500 flex items-center justify-center mx-auto mb-6"
          >
            <Icon name="Target" className="w-9 h-9 text-white" client:idle />
          </div>
          <h3 class="text-2xl font-bold text-white mb-4">Our Mission</h3>
          <p class="text-base leading-relaxed text-white/80">
            {ABOUT_DATA.statements.mission}
          </p>
        </div>

        <!-- Vision Card -->
        <div
          class="bg-white/5 backdrop-blur-md border border-white/10 rounded-2xl p-6 md:p-8 lg:p-12 text-center transition-all duration-300 hover:-translate-y-2 hover:bg-white/10"
        >
          <div
            class="w-16 h-16 rounded-xl bg-gradient-to-br from-primary-500 to-secondary-500 flex items-center justify-center mx-auto mb-6"
          >
            <Icon name="Eye" className="w-9 h-9 text-white" client:idle />
          </div>
          <h3 class="text-2xl font-bold text-white mb-4">Our Vision</h3>
          <p class="text-base leading-relaxed text-white/80">
            {ABOUT_DATA.statements.vision}
          </p>
        </div>
      </div>
    </Container>
  </Section>

  <!-- Core Values Section -->
  <Section>
    <Container>
      <!-- Section Header -->
      <div class="text-center max-w-3xl mx-auto mb-12 lg:mb-16">
        <div class="inline-block text-sm font-bold uppercase tracking-wider text-primary-600 mb-4">
          Our Values
        </div>
        <Heading level="h2" size="3xl" className="mb-4"> What We Stand For </Heading>
        <p class="text-lg leading-relaxed text-neutral-600">
          These core values guide everything we do, ensuring exceptional service and peace of mind
          for every client.
        </p>
      </div>

      <!-- Values Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
        {
          ABOUT_DATA.values.map((value) => (
            <ValueCard name={value.name} description={value.description} icon={value.icon} />
          ))
        }
      </div>
    </Container>
  </Section>

  <!-- Statistics Section -->
  <Section background="gradient">
    <Container>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
        {
          ABOUT_DATA.statistics.map((stat) => (
            <div class="bg-white/10 backdrop-blur-md border border-white/20 rounded-2xl p-6 lg:p-8 text-center transition-all duration-300 hover:-translate-y-1 hover:bg-white/15">
              <div class="w-14 h-14 rounded-xl bg-white flex items-center justify-center mx-auto mb-4">
                <Icon name={stat.icon as any} className="w-8 h-8 text-primary-600" client:idle />
              </div>
              <div class="text-4xl lg:text-5xl font-extrabold text-white mb-2">{stat.value}</div>
              <div class="text-sm font-semibold uppercase tracking-wide text-white/80">
                {stat.label}
              </div>
            </div>
          ))
        }
      </div>
    </Container>
  </Section>

  <!-- Team Section -->
  {
    ABOUT_DATA.team.showTeam && (
      <Section>
        <Container>
          {/* Section Header */}
          <div class="text-center max-w-3xl mx-auto mb-12 lg:mb-16">
            <div class="inline-block text-sm font-bold uppercase tracking-wider text-primary-600 mb-4">
              Our Team
            </div>
            <Heading level="h2" size="3xl" className="mb-4">
              Meet the Experts
            </Heading>
            {ABOUT_DATA.team.teamDescription && (
              <p class="text-lg leading-relaxed text-neutral-600">
                {ABOUT_DATA.team.teamDescription}
              </p>
            )}
          </div>

          {/* Team Grid */}
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6 lg:gap-8">
            {ABOUT_DATA.team.members?.map((member) => (
              <div class="group text-center p-6 bg-gradient-to-br from-white/5 to-white/2 border border-neutral-200 rounded-2xl transition-all duration-300 hover:-translate-y-2 hover:shadow-xl">
                <div class="w-28 h-28 lg:w-32 lg:h-32 rounded-full bg-gradient-to-br from-primary-500 to-secondary-500 flex items-center justify-center mx-auto mb-6 overflow-hidden">
                  <Icon name="User" className="w-14 h-14 lg:w-16 lg:h-16 text-white" client:idle />
                </div>
                <h3 class="text-lg font-bold text-neutral-900 mb-2">{member.name}</h3>
                <p class="text-sm text-neutral-600">{member.role}</p>
              </div>
            ))}
          </div>
        </Container>
      </Section>
    )
  }

  <!-- CTA Section -->
  <Section background="gradient">
    <Container>
      <div class="text-center max-w-3xl mx-auto space-y-8">
        <Heading level="h2" size="3xl" className="text-white"> Ready to Get Started? </Heading>
        <p class="text-xl text-white/90">
          Let our experienced team handle your government services with care and efficiency.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <Button variant="primary" size="lg" href="https://wa.me/971503489891">
            <Icon name="MessageCircle" className="w-5 h-5" client:idle />
            WhatsApp Us
          </Button>
          <Button variant="outline" size="lg" href="/contact">Get in Touch</Button>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>
