---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import Section from '../../components/ui/Section.astro';
import Heading from '../../components/ui/Heading.astro';
import Badge from '../../components/ui/Badge.astro';
import SanityImage from '../../components/ui/SanityImage.astro';
import BlogCard from '../../components/blog/BlogCard.astro';
import { getAllPosts, getAllCategories } from '../../lib/sanity';
import type { BlogPost, Category } from '../../types';

const posts: BlogPost[] = await getAllPosts();
const categories: Category[] = await getAllCategories();

// Separate featured post (first post marked as featured, or just the latest one)
const featuredPost = posts.find((p) => p.featured) || posts[0];
const remainingPosts = posts.filter((p) => p._id !== featuredPost?._id);

const title = 'Insights & News | AtoZ Business Services Abu Dhabi';
const description =
  'Stay updated with the latest news on UAE Visas, Golden Visas, PRO Services, and Business Setup in Abu Dhabi.';
---

<BaseLayout title={title} description={description}>
  <!-- Hero Section -->
  <Section
    class="bg-gradient-to-br from-primary-950 via-primary-900 to-primary-800 text-white pt-24 pb-40 md:pt-32 md:pb-56 lg:pt-40 lg:pb-64 overflow-hidden relative"
  >
    <!-- Background Image -->
    <div class="absolute inset-0 z-0">
      {
        featuredPost && featuredPost.featuredImage && (
          <div class="absolute inset-0">
            <SanityImage
              node={featuredPost.featuredImage}
              width={1920}
              className="w-full h-full object-cover opacity-20 scale-105"
            />
            <div class="absolute inset-0 bg-gradient-to-b from-primary-950/95 via-primary-900/90 to-primary-950/85" />
          </div>
        )
      }

      <div
        class="absolute inset-0 bg-[linear-gradient(to_right,#ffffff08_1px,transparent_1px),linear-gradient(to_bottom,#ffffff08_1px,transparent_1px)] bg-[size:40px_40px]"
      >
      </div>
    </div>

    <!-- Animated blobs for depth -->
    <div
      class="absolute -top-1/3 -left-1/4 w-2/3 h-2/3 bg-secondary-500/15 rounded-full blur-[140px] opacity-50 animate-pulse-slow pointer-events-none"
    >
    </div>
    <div
      class="absolute -bottom-1/3 -right-1/4 w-2/3 h-2/3 bg-accent-500/10 rounded-full blur-[140px] opacity-40 animate-pulse pointer-events-none"
    >
    </div>

    <Container>
      <div class="max-w-5xl mx-auto text-center relative z-10 px-4 sm:px-6 lg:px-8">
        <div class="reveal inline-block mb-6 md:mb-8" data-animation="animate-fade-in-up">
          <Badge
            variant="secondary"
            class="bg-white/10 text-white border border-white/20 backdrop-blur-md px-5 py-2.5 md:px-7 md:py-3 uppercase tracking-widest text-xs md:text-sm font-bold shadow-lg"
          >
            📚 Insights & Updates
          </Badge>
        </div>

        <Heading
          as="h1"
          size="6xl"
          class="mb-6 md:mb-8 text-white reveal leading-[1.1] font-display text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold"
          data-animation="animate-fade-in-up"
          style="transition-delay: 100ms"
        >
          Stay Ahead with <span
            class="bg-gradient-to-r from-secondary-300 via-secondary-400 to-accent-400 bg-clip-text text-transparent"
            >Expert Insights</span
          >
        </Heading>

        <p
          class="text-lg sm:text-xl md:text-2xl lg:text-2xl text-primary-50/95 max-w-3xl mx-auto leading-relaxed reveal font-sans"
          data-animation="animate-fade-in-up"
          style="transition-delay: 200ms"
        >
          Expert advice, step-by-step guides, and regulatory updates for businesses and residents in
          <span class="text-accent-300 font-semibold">Abu Dhabi</span>.
        </p>

        <!-- Stats Section -->
        <div
          class="mt-12 md:mt-16 grid grid-cols-2 md:grid-cols-3 gap-6 md:gap-8 max-w-3xl mx-auto reveal"
          data-animation="animate-fade-in-up"
          style="transition-delay: 300ms"
        >
          <div
            class="bg-white/5 backdrop-blur-md border border-white/10 rounded-2xl p-4 md:p-6 hover:bg-white/10 transition-all duration-300"
          >
            <p class="text-3xl md:text-4xl font-display font-bold text-accent-300">
              {posts.length}+
            </p>
            <p class="text-sm md:text-base text-primary-200 mt-1 md:mt-2">Articles</p>
          </div>
          <div
            class="bg-white/5 backdrop-blur-md border border-white/10 rounded-2xl p-4 md:p-6 hover:bg-white/10 transition-all duration-300"
          >
            <p class="text-3xl md:text-4xl font-display font-bold text-secondary-300">
              {categories.length}+
            </p>
            <p class="text-sm md:text-base text-primary-200 mt-1 md:mt-2">Categories</p>
          </div>
          <div
            class="bg-white/5 backdrop-blur-md border border-white/10 rounded-2xl p-4 md:p-6 hover:bg-white/10 transition-all duration-300 col-span-2 md:col-span-1"
          >
            <p class="text-3xl md:text-4xl font-display font-bold text-primary-300">Weekly</p>
            <p class="text-sm md:text-base text-primary-200 mt-1 md:mt-2">Updates</p>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <!-- Blog Listing -->
  <Section class="bg-neutral-50 -mt-24 md:-mt-32 relative z-20 pt-8 pb-16 md:pb-24 lg:pb-32">
    <Container>
      <!-- Featured Post Overlay -->
      {
        featuredPost && (
          <div
            class="mb-12 md:mb-20 shadow-2xl rounded-2xl md:rounded-3xl lg:rounded-4xl overflow-hidden reveal hover:shadow-glow transition-all duration-500"
            data-animation="animate-fade-in-up"
          >
            <BlogCard post={featuredPost} featured={true} />
          </div>
        )
      }

      <!-- Section Header -->
      <div class="mb-10 md:mb-16 text-center md:text-left px-4 sm:px-0">
        <h2
          class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-display font-bold text-neutral-900 mb-3 md:mb-4"
        >
          Latest <span
            class="bg-gradient-to-r from-primary-600 to-secondary-500 bg-clip-text text-transparent"
            >Articles</span
          >
        </h2>
        <p class="text-base md:text-lg text-neutral-600 max-w-2xl mx-auto md:mx-0">
          Explore our curated collection of insights and updates
        </p>
      </div>

      <!-- Main Grid -->
      <div
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8 lg:gap-10 px-4 sm:px-0"
      >
        {
          remainingPosts.map((post, index) => (
            <div
              class="reveal group"
              data-animation="animate-fade-in-up"
              style={`transition-delay: ${index * 50}ms`}
            >
              <BlogCard post={post} />
            </div>
          ))
        }
      </div>

      {
        posts.length === 0 && (
          <div class="text-center py-16 md:py-24 bg-white rounded-2xl md:rounded-3xl border-2 border-dashed border-neutral-300 mx-4 sm:mx-0">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-16 h-16 md:w-20 md:h-20 mx-auto mb-6 text-neutral-300"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
              />
            </svg>
            <p class="text-neutral-500 text-lg md:text-xl font-medium">No blog posts found.</p>
            <p class="text-neutral-400 mt-2">Check back soon for new content!</p>
          </div>
        )
      }
    </Container>
  </Section>
</BaseLayout>

<script>
  // Simple category filter logic can be added here if needed statically
</script>
