---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import Section from '../../components/ui/Section.astro';
import Heading from '../../components/ui/Heading.astro';
import Badge from '../../components/ui/Badge.astro';
import SanityImage from '../../components/ui/SanityImage.astro';
import BlogCard from '../../components/blog/BlogCard.astro';
import BlogHero from '../../components/blog/BlogHero.astro';
import { getAllPosts, getAllCategories } from '../../lib/sanity';
import type { BlogPost, Category } from '../../types';

const posts: BlogPost[] = await getAllPosts();
const categories: Category[] = await getAllCategories();

// Separate featured post (first post marked as featured, or just the latest one)
const featuredPost = posts.find((p) => p.featured) || posts[0];
const remainingPosts = posts.filter((p) => p._id !== featuredPost?._id);

const title = 'Insights & News | AtoZ Business Services Abu Dhabi';
const description =
  'Stay updated with the latest news on UAE Visas, Golden Visas, PRO Services, and Business Setup in Abu Dhabi.';
---

<BaseLayout title={title} description={description}>
  <!-- Hero Section -->
  <BlogHero posts={posts} categories={categories} featuredPost={featuredPost} />

  <!-- Blog Listing -->
  <Section
    class="bg-neutral-50 -mt-16 md:-mt-20 lg:-mt-24 relative z-20 pt-8 pb-16 md:pb-24 lg:pb-32"
  >
    <Container>
      <!-- Featured Post Overlay -->
      {
        featuredPost && (
          <div
            class="mb-12 md:mb-20 shadow-2xl rounded-2xl md:rounded-3xl lg:rounded-4xl overflow-hidden reveal hover:shadow-glow transition-all duration-500"
            data-animation="animate-fade-in-up"
          >
            <BlogCard post={featuredPost} featured={true} />
          </div>
        )
      }

      <!-- Section Header -->
      <div class="mb-10 md:mb-16 text-center md:text-left px-4 sm:px-0">
        <h2
          class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-display font-bold text-neutral-900 mb-3 md:mb-4"
        >
          Latest <span
            class="bg-gradient-to-r from-primary-600 to-secondary-500 bg-clip-text text-transparent"
            >Articles</span
          >
        </h2>
        <p class="text-base md:text-lg text-neutral-600 max-w-2xl mx-auto md:mx-0">
          Explore our curated collection of insights and updates
        </p>
      </div>

      <!-- Main Grid -->
      <div
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8 lg:gap-10 px-4 sm:px-0"
      >
        {
          remainingPosts.map((post, index) => (
            <div
              class="reveal group"
              data-animation="animate-fade-in-up"
              style={`transition-delay: ${index * 50}ms`}
            >
              <BlogCard post={post} />
            </div>
          ))
        }
      </div>

      {
        posts.length === 0 && (
          <div class="text-center py-16 md:py-24 bg-white rounded-2xl md:rounded-3xl border-2 border-dashed border-neutral-300 mx-4 sm:mx-0">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-16 h-16 md:w-20 md:h-20 mx-auto mb-6 text-neutral-300"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
              />
            </svg>
            <p class="text-neutral-500 text-lg md:text-xl font-medium">No blog posts found.</p>
            <p class="text-neutral-400 mt-2">Check back soon for new content!</p>
          </div>
        )
      }
    </Container>
  </Section>
</BaseLayout>

<script>
  // Simple category filter logic can be added here if needed statically
</script>
