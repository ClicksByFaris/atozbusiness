---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import Section from '../../components/ui/Section.astro';
import Heading from '../../components/ui/Heading.astro';
import Badge from '../../components/ui/Badge.astro';
import SanityImage from '../../components/ui/SanityImage.astro';
import PortableText from '../../components/blog/PortableText.astro';
import BlogCard from '../../components/blog/BlogCard.astro';
import SEO from '../../components/SEO.astro';
import { getAllPosts, getPostBySlug, getLatestPosts } from '../../lib/sanity';
import { formatDate } from '../../lib/utils';
import type { BlogPost } from '../../types';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post: BlogPost) => ({
    params: { slug: post.slug.current },
  }));
}

const { slug } = Astro.params;
const post: BlogPost = await getPostBySlug(slug as string);
const latestPosts: BlogPost[] = await getLatestPosts(5);
const relatedPosts = latestPosts.filter((p) => p._id !== post._id).slice(0, 2);

if (!post) {
  return Astro.redirect('/404');
}

// Generate Article Schema
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.title,
  image: post.featuredImage?.asset?.url,
  datePublished: post.publishedAt,
  dateModified: post.publishedAt, // Simplified
  author: {
    '@type': 'Person',
    name: post.author.name,
  },
  publisher: {
    '@type': 'Organization',
    name: 'AtoZ Business Services',
    logo: {
      '@type': 'ImageObject',
      url: 'https://atozbusiness.ae/logo.svg', // Placeholder
    },
  },
  description: post.excerpt,
};

// Generate FAQ Schema if exists
const faqSchema =
  post.faqs && post.faqs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: post.faqs.map((faq) => ({
          '@type': 'Question',
          name: faq.question,
          acceptedAnswer: {
            '@type': 'Answer',
            text: faq.answer,
          },
        })),
      }
    : null;

const schemas: any[] = [articleSchema];
if (faqSchema) schemas.push(faqSchema);

const title = `${post.metaTitle || post.title} | AtoZ Blog`;
const description = post.metaDescription || post.excerpt;
---

<BaseLayout title={title} description={description} ogImage={post.featuredImage?.asset?.url}>
  <SEO
    slot="head"
    author={post.author.name}
    publishDate={post.publishedAt}
    keywords={post.tags}
    schema={schemas}
  />

  <!-- Reading Progress Bar -->
  <div class="fixed top-0 left-0 w-full h-1 z-[100] bg-neutral-100">
    <div id="progress-bar" class="h-full bg-primary-500 w-0 transition-all duration-150"></div>
  </div>

  <!-- Hero Section -->
  <Section
    class="bg-gradient-to-br from-primary-950 via-primary-900 to-primary-800 text-white pt-24 pb-40 md:pt-32 md:pb-56 lg:pt-40 lg:pb-64 overflow-hidden relative"
  >
    <!-- Background Image -->
    <div class="absolute inset-0 z-0">
      {
        post.featuredImage && (
          <div class="absolute inset-0">
            <SanityImage
              node={post.featuredImage}
              width={1920}
              className="w-full h-full object-cover opacity-25 scale-105 blur-sm"
              priority={true}
            />
            <div class="absolute inset-0 bg-gradient-to-b from-primary-950/95 via-primary-900/90 to-primary-950/85" />
          </div>
        )
      }
      <div
        class="absolute inset-0 bg-[linear-gradient(to_right,#ffffff08_1px,transparent_1px),linear-gradient(to_bottom,#ffffff08_1px,transparent_1px)] bg-[size:40px_40px]"
      >
      </div>
    </div>

    <!-- Animated blobs for depth -->
    <div
      class="absolute -top-1/3 -left-1/4 w-2/3 h-2/3 bg-secondary-500/15 rounded-full blur-[140px] opacity-50 animate-pulse-slow pointer-events-none"
    >
    </div>
    <div
      class="absolute -bottom-1/3 -right-1/4 w-2/3 h-2/3 bg-accent-500/10 rounded-full blur-[140px] opacity-40 animate-pulse pointer-events-none"
    >
    </div>

    <Container>
      <header class="max-w-5xl mx-auto text-center relative z-10 px-4 sm:px-6 lg:px-8">
        <div class="reveal inline-block mb-6 md:mb-8" data-animation="animate-fade-in-up">
          <Badge
            variant="secondary"
            class="bg-white/10 text-white border border-white/20 backdrop-blur-md px-5 py-2.5 md:px-7 md:py-3 uppercase tracking-widest text-xs md:text-sm font-bold shadow-lg"
          >
            {post.category.title}
          </Badge>
        </div>

        <Heading
          as="h1"
          size="6xl"
          class="mb-8 md:mb-12 text-white reveal leading-[1.1] font-display text-3xl sm:text-4xl md:text-5xl lg:text-6xl xl:text-7xl font-extrabold px-4"
          data-animation="animate-fade-in-up"
          style="transition-delay: 100ms"
        >
          {post.title}
        </Heading>

        <div
          class="flex flex-wrap items-center justify-center gap-4 md:gap-6 text-primary-100/90 reveal text-sm md:text-base"
          data-animation="animate-fade-in-up"
          style="transition-delay: 200ms"
        >
          <div
            class="flex items-center gap-3 bg-white/5 backdrop-blur-sm px-4 py-2 rounded-full border border-white/10"
          >
            {
              post.author.photo && (
                <div class="w-8 h-8 md:w-10 md:h-10 rounded-full overflow-hidden border-2 border-white/30 shadow-lg">
                  <SanityImage node={post.author.photo} width={80} height={80} />
                </div>
              )
            }
            <span class="font-semibold text-white">{post.author.name}</span>
          </div>
          <span class="w-1.5 h-1.5 bg-white/30 rounded-full hidden sm:block"></span>
          <div
            class="flex items-center gap-2 bg-white/5 backdrop-blur-sm px-4 py-2 rounded-full border border-white/10"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-4 h-4 md:w-5 md:h-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            <time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time>
          </div>
          <span class="w-1.5 h-1.5 bg-white/30 rounded-full hidden sm:block"></span>
          <div
            class="flex items-center gap-2 bg-white/5 backdrop-blur-sm px-4 py-2 rounded-full border border-white/10"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-4 h-4 md:w-5 md:h-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <span>{post.readingTime || 5} min read</span>
          </div>
        </div>
      </header>
    </Container>
  </Section>

  <!-- Article Body -->
  <article class="bg-neutral-50 -mt-24 md:-mt-32 lg:-mt-40 relative z-20 pb-16 md:pb-24 lg:pb-32">
    <Container class="pt-8 md:pt-12 lg:pt-16">
      <div
        class="grid grid-cols-1 lg:grid-cols-12 gap-8 md:gap-12 lg:gap-16 max-w-7xl mx-auto px-4 sm:px-0"
      >
        <!-- Main Content -->
        <div class="lg:col-span-8">
          <div
            class="bg-white rounded-2xl md:rounded-3xl lg:rounded-4xl p-6 sm:p-8 md:p-10 lg:p-12 shadow-soft border border-neutral-100/50 hover:shadow-xl transition-shadow duration-500"
          >
            <!-- Key Takeaways -->
            {
              post.keyTakeaways && post.keyTakeaways.length > 0 && (
                <div class="bg-gradient-to-br from-primary-50 to-primary-100/30 rounded-2xl md:rounded-3xl p-6 md:p-8 mb-10 md:mb-12 border-2 border-primary-200/50 relative overflow-hidden group">
                  <div class="absolute -top-12 -right-12 w-24 h-24 bg-primary-300/20 rounded-full blur-3xl group-hover:scale-150 transition-transform duration-700" />
                  <h2 class="text-xl md:text-2xl lg:text-3xl font-display font-bold text-primary-900 mb-6 md:mb-8 flex items-center gap-3 relative z-10">
                    <div class="w-10 h-10 md:w-12 md:h-12 rounded-xl md:rounded-2xl bg-gradient-to-br from-primary-500 to-primary-600 text-white flex items-center justify-center shadow-lg">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="w-5 h-5 md:w-6 md:h-6"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                      >
                        <path d="M9 11l3 3L22 4" />
                        <path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11" />
                      </svg>
                    </div>
                    Article Highlights
                  </h2>
                  <ul class="space-y-4 md:space-y-5 relative z-10">
                    {post.keyTakeaways.map((item) => (
                      <li class="flex items-start gap-3 md:gap-4 text-primary-900">
                        <div class="mt-1.5 flex-shrink-0 w-2 h-2 md:w-2.5 md:h-2.5 rounded-full bg-gradient-to-r from-primary-500 to-secondary-500 shadow-sm" />
                        <span class="text-base md:text-lg leading-relaxed font-sans">{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )
            }

            <div
              class="reveal mb-10 md:mb-12 prose prose-lg md:prose-xl max-w-none"
              data-animation="animate-fade-in"
            >
              <PortableText value={post.content} />
            </div>

            <!-- Tags -->
            {
              post.tags && (
                <div class="pt-8 md:pt-12 border-t border-neutral-200">
                  <h3 class="text-sm font-bold text-neutral-500 uppercase tracking-wider mb-4">
                    Topics
                  </h3>
                  <div class="flex flex-wrap gap-2 md:gap-3">
                    {post.tags.map((tag) => (
                      <span class="px-4 md:px-5 py-2 md:py-2.5 bg-neutral-100 text-neutral-700 rounded-xl text-sm md:text-base font-semibold transition-all duration-300 hover:bg-gradient-to-r hover:from-primary-500 hover:to-secondary-500 hover:text-white hover:shadow-lg hover:scale-105 cursor-default">
                        #{tag}
                      </span>
                    ))}
                  </div>
                </div>
              )
            }
          </div>
        </div>

        <!-- Sidebar -->
        <aside class="lg:col-span-4 space-y-6 md:space-y-8 lg:space-y-10">
          <!-- Author Card (Extended) -->
          <div
            class="bg-white rounded-2xl md:rounded-3xl p-6 md:p-8 shadow-soft border border-neutral-100/50 text-center hover:shadow-lg transition-shadow duration-300"
          >
            <div
              class="w-20 h-20 md:w-24 md:h-24 rounded-xl md:rounded-2xl overflow-hidden mx-auto mb-5 md:mb-6 border-4 border-primary-100 shadow-md"
            >
              {
                post.author.photo ? (
                  <SanityImage
                    node={post.author.photo}
                    width={200}
                    height={200}
                    className="w-full h-full object-cover"
                  />
                ) : (
                  <div class="w-full h-full bg-gradient-to-br from-primary-100 to-primary-200 flex items-center justify-center text-primary-600 text-2xl md:text-3xl font-display font-bold">
                    {post.author.name.charAt(0)}
                  </div>
                )
              }
            </div>
            <h3 class="text-lg md:text-xl font-display font-bold text-neutral-900 mb-1">
              {post.author.name}
            </h3>
            <p class="text-xs md:text-sm text-neutral-500 mb-5 md:mb-6 font-medium">
              {post.author.role}
            </p>
            <div
              class="h-px bg-gradient-to-r from-transparent via-neutral-200 to-transparent w-full mb-5 md:mb-6"
            >
            </div>
            <p class="text-neutral-600 text-sm md:text-base leading-relaxed font-sans">
              Expert in Abu Dhabi business regulations and government services.
            </p>
          </div>

          <!-- Related Locations -->
          {
            post.relatedLocations && post.relatedLocations.length > 0 && (
              <div class="bg-white rounded-2xl md:rounded-3xl p-6 md:p-8 shadow-soft border border-neutral-100/50 hover:shadow-lg transition-shadow duration-300">
                <h3 class="text-lg md:text-xl font-display font-bold text-neutral-900 mb-6 md:mb-8 border-l-4 border-secondary-500 pl-4">
                  Visit Our Nearest Office
                </h3>
                <div class="space-y-4 md:space-y-5">
                  {post.relatedLocations.map((loc) => (
                    <a href={`/locations/${loc.slug.current}`} class="group block">
                      <div class="flex items-center gap-3 md:gap-4 p-3 md:p-4 rounded-xl md:rounded-2xl transition-all bg-neutral-50 border border-neutral-100 hover:border-primary-200 hover:bg-gradient-to-r hover:from-primary-50 hover:to-secondary-50 hover:shadow-md">
                        <div class="w-10 h-10 md:w-12 md:h-12 rounded-lg md:rounded-xl bg-white shadow-sm flex items-center justify-center text-primary-500 group-hover:bg-gradient-to-br group-hover:from-primary-500 group-hover:to-secondary-500 group-hover:text-white transition-all duration-300">
                          <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="w-5 h-5 md:w-6 md:h-6"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                          >
                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                            <circle cx="12" cy="10" r="3" />
                          </svg>
                        </div>
                        <div>
                          <p class="font-bold text-sm md:text-base text-neutral-900 group-hover:text-primary-700 transition-colors">
                            {loc.name}
                          </p>
                          <p class="text-xs text-neutral-500">{loc.area}</p>
                        </div>
                      </div>
                    </a>
                  ))}
                </div>
              </div>
            )
          }

          <!-- Latest Posts Sidebar -->
          <div
            class="bg-gradient-to-br from-primary-900 via-primary-800 to-primary-900 rounded-2xl md:rounded-3xl p-6 md:p-8 text-white overflow-hidden relative shadow-xl hover:shadow-2xl transition-shadow duration-300"
          >
            <div class="absolute inset-0 opacity-5 bg-[url('/assets/grid-pattern.svg')]"></div>
            <!-- Animated background effect -->
            <div
              class="absolute -top-10 -right-10 w-32 h-32 bg-secondary-500/20 rounded-full blur-3xl animate-pulse-slow"
            >
            </div>
            <div
              class="absolute -bottom-10 -left-10 w-32 h-32 bg-accent-500/15 rounded-full blur-3xl animate-pulse"
            >
            </div>

            <h3
              class="text-lg md:text-xl font-display font-bold mb-6 md:mb-8 relative z-10 border-l-4 border-accent-400 pl-4"
            >
              🔥 Trending Now
            </h3>
            <div class="space-y-6 md:space-y-8 relative z-10">
              {
                latestPosts.slice(0, 3).map((lp) => (
                  <a href={`/blog/${lp.slug.current}`} class="group block">
                    <time
                      datetime={lp.publishedAt}
                      class="text-[10px] md:text-xs uppercase tracking-widest text-primary-200 font-bold mb-2 block"
                    >
                      {formatDate(lp.publishedAt)}
                    </time>
                    <p class="font-semibold text-white group-hover:text-accent-300 transition-colors leading-tight text-base md:text-lg font-sans">
                      {lp.title}
                    </p>
                  </a>
                ))
              }
            </div>
            <a
              href="/blog"
              class="mt-8 md:mt-10 block text-center py-3 md:py-4 bg-white/10 hover:bg-white/20 border border-white/20 rounded-xl md:rounded-2xl transition-all text-sm md:text-base font-bold relative z-10 backdrop-blur-sm hover:shadow-lg"
            >
              Explore All Insights →
            </a>
          </div>
        </aside>
      </div>
    </Container>
  </article>

  <!-- Related Content Divider -->
  <div class="bg-neutral-50 py-12">
    <Container>
      <div class="h-px bg-neutral-200 w-full"></div>
    </Container>
  </div>

  <!-- More Articles -->
  <Section class="bg-neutral-50 pt-0 pb-16 md:pb-24 lg:pb-32">
    <Container>
      <header
        class="flex flex-col md:flex-row md:items-end justify-between mb-10 md:mb-16 gap-6 md:gap-8 px-4 sm:px-0"
      >
        <div class="max-w-2xl">
          <Badge
            variant="secondary"
            class="mb-4 md:mb-6 px-5 py-2 md:px-6 md:py-2.5 text-xs md:text-sm"
            >✨ Continue the Journey</Badge
          >
          <Heading
            as="h2"
            size="5xl"
            class="mb-3 md:mb-4 text-3xl sm:text-4xl md:text-5xl font-display font-extrabold"
            >Related <span
              class="bg-gradient-to-r from-primary-600 via-primary-500 to-secondary-500 bg-clip-text text-transparent"
              >Insights & Updates</span
            ></Heading
          >
          <p class="text-neutral-600 text-base md:text-lg lg:text-xl leading-relaxed">
            Stay informed with more expert perspectives on business in <span
              class="text-primary-700 font-semibold">Abu Dhabi</span
            >.
          </p>
        </div>
        <a
          href="/blog"
          class="inline-flex items-center justify-center gap-3 px-6 md:px-8 py-3 md:py-4 bg-white border-2 border-neutral-200 rounded-xl md:rounded-2xl font-bold text-sm md:text-base text-primary-700 transition-all hover:bg-gradient-to-r hover:from-primary-600 hover:to-secondary-500 hover:text-white hover:border-transparent hover:shadow-glow group w-full md:w-auto"
        >
          View All News
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-4 h-4 md:w-5 md:h-5 transition-transform group-hover:translate-x-1"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
          >
            <path d="M5 12h14m-7-7 7 7-7 7"></path>
          </svg>
        </a>
      </header>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8 lg:gap-10 px-4 sm:px-0">
        {relatedPosts.map((rp) => <BlogCard post={rp} />)}
      </div>
    </Container>
  </Section>

  <script>
    // Reading progress bar logic
    window.onscroll = function () {
      const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
      const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const scrolled = (winScroll / height) * 100;
      const progressBar = document.getElementById('progress-bar');
      if (progressBar) {
        progressBar.style.width = scrolled + '%';
      }
    };
  </script>
</BaseLayout>
