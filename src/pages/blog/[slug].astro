---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import Section from '../../components/ui/Section.astro';
import Heading from '../../components/ui/Heading.astro';
import Badge from '../../components/ui/Badge.astro';
import SanityImage from '../../components/ui/SanityImage.astro';
import PortableText from '../../components/blog/PortableText.astro';
import BlogCard from '../../components/blog/BlogCard.astro';
import FAQAccordion from '../../components/blog/FAQAccordion.astro';
import AuthorCard from '../../components/blog/AuthorCard.astro';
import RelatedLocations from '../../components/blog/RelatedLocations.astro';
import TrendingPosts from '../../components/blog/TrendingPosts.astro';
import SidebarSticky from '../../components/blog/SidebarSticky.astro';
import ReadingProgress from '../../components/blog/ReadingProgress.astro';
import ShareBar from '../../components/blog/ShareBar.astro';
import BackToTop from '../../components/blog/BackToTop.astro';
import NewsletterCTA from '../../components/blog/NewsletterCTA.astro';
import EngagementWidget from '../../components/blog/EngagementWidget.astro';
import AuthorBio from '../../components/blog/AuthorBio.astro';
import SEO from '../../components/SEO.astro';
import { getAllPosts, getPostBySlug, getLatestPosts } from '../../lib/sanity';
import { formatDate } from '../../lib/utils';
import type { BlogPost } from '../../types';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post: BlogPost) => ({
    params: { slug: post.slug.current },
  }));
}

const { slug } = Astro.params;
const post: BlogPost = await getPostBySlug(slug as string);
const latestPosts: BlogPost[] = await getLatestPosts(5);
const relatedPosts = latestPosts.filter((p) => p._id !== post._id).slice(0, 2);

if (!post) {
  return Astro.redirect('/404');
}

// Generate Article Schema
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.title,
  image: post.featuredImage?.asset?.url,
  datePublished: post.publishedAt,
  dateModified: post.publishedAt, // Simplified
  author: {
    '@type': 'Person',
    name: post.author.name,
  },
  publisher: {
    '@type': 'Organization',
    name: 'AtoZ Business Services',
    logo: {
      '@type': 'ImageObject',
      url: 'https://atozbusiness.ae/logo.svg', // Placeholder
    },
  },
  description: post.excerpt,
};

// Generate FAQ Schema if exists
const faqSchema =
  post.faqs && post.faqs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: post.faqs.map((faq) => ({
          '@type': 'Question',
          name: faq.question,
          acceptedAnswer: {
            '@type': 'Answer',
            text: faq.answer,
          },
        })),
      }
    : null;

const schemas: any[] = [articleSchema];
if (faqSchema) schemas.push(faqSchema);

const title = `${post.metaTitle || post.title} | AtoZ Blog`;
const description = post.metaDescription || post.excerpt;
---

<BaseLayout title={title} description={description} ogImage={post.featuredImage?.asset?.url}>
  <SEO
    slot="head"
    author={post.author.name}
    publishDate={post.publishedAt}
    keywords={post.tags}
    schema={schemas}
  />

  <!-- Reading Progress Bar -->
  <ReadingProgress color="gradient" height="4px" showPercentage={false} />

  <!-- Social Share Bar -->
  <ShareBar title={post.title} description={post.excerpt} />

  <!-- Back to Top Button -->
  <BackToTop showAfter={600} position="right" />

  <!-- Hero Section -->
  <Section
    class="bg-gradient-to-br from-primary-900 via-primary-800 to-primary-900 text-white pt-24 pb-36 md:pt-32 md:pb-44 lg:pt-36 lg:pb-52 overflow-hidden relative"
  >
    <!-- Background Image with Premium Overlay -->
    <div class="absolute inset-0 z-0">
      {
        post.featuredImage && (
          <div class="absolute inset-0">
            <SanityImage
              node={post.featuredImage}
              width={1920}
              className="w-full h-full object-cover opacity-20 scale-110 transition-transform duration-[20s] hover:scale-105"
              priority={true}
            />
            <div class="absolute inset-0 bg-gradient-to-b from-primary-900/90 via-primary-800/85 to-primary-900/95" />
          </div>
        )
      }
    </div>

    <!-- Animated Floating Shapes -->
    <div class="absolute inset-0 z-[1] overflow-hidden pointer-events-none">
      <!-- Large floating circle -->
      <div
        class="absolute -top-20 -right-20 w-80 h-80 md:w-[500px] md:h-[500px] rounded-full bg-gradient-to-br from-secondary-500/20 to-accent-500/10 blur-3xl animate-float"
      >
      </div>
      <!-- Small accent circle -->
      <div
        class="absolute top-1/3 -left-10 w-40 h-40 md:w-64 md:h-64 rounded-full bg-gradient-to-tr from-accent-500/15 to-secondary-500/10 blur-2xl animate-pulse-slow"
      >
      </div>
      <!-- Bottom floating shape -->
      <div
        class="absolute -bottom-20 right-1/4 w-60 h-60 md:w-96 md:h-96 rounded-full bg-gradient-to-tl from-primary-500/20 to-secondary-500/15 blur-3xl animate-float"
        style="animation-delay: -3s;"
      >
      </div>
      <!-- Geometric accent lines -->
      <div
        class="absolute top-20 left-10 w-32 h-px bg-gradient-to-r from-transparent via-white/20 to-transparent rotate-45 hidden lg:block"
      >
      </div>
      <div
        class="absolute bottom-32 right-20 w-48 h-px bg-gradient-to-r from-transparent via-accent-400/30 to-transparent -rotate-12 hidden lg:block"
      >
      </div>
      <!-- Grid pattern overlay -->
      <div
        class="absolute inset-0 opacity-[0.03] bg-[url('data:image/svg+xml;base64,')]"
      >
      </div>
    </div>

    <Container>
      <header class="max-w-5xl mx-auto text-center relative z-10 px-4 sm:px-6 lg:px-8">
        <!-- Breadcrumb Navigation -->
        <nav
          class="reveal mb-8 md:mb-10"
          data-animation="animate-fade-in-up"
          aria-label="Breadcrumb"
        >
          <ol
            class="flex items-center justify-center flex-wrap gap-2 text-sm md:text-base text-white/70"
          >
            <li>
              <a
                href="/"
                class="hover:text-white transition-colors duration-200 flex items-center gap-1.5"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-4 h-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                  <polyline points="9 22 9 12 15 12 15 22"></polyline>
                </svg>
                <span>Home</span>
              </a>
            </li>
            <li class="flex items-center gap-2">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-4 h-4 text-white/40"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
              <a href="/blog" class="hover:text-white transition-colors duration-200">Blog</a>
            </li>
            <li class="flex items-center gap-2">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-4 h-4 text-white/40"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
              <span class="text-accent-400 font-medium">{post.category.title}</span>
            </li>
          </ol>
        </nav>

        <!-- Category Badge -->
        <div
          class="reveal inline-block mb-6 md:mb-8"
          data-animation="animate-fade-in-up"
          style="transition-delay: 50ms"
        >
          <Badge
            variant="secondary"
            class="bg-gradient-to-r from-secondary-500 to-secondary-600 text-white border-0 px-6 py-2.5 md:px-8 md:py-3 uppercase tracking-[0.2em] text-xs md:text-sm font-bold shadow-xl shadow-secondary-500/25 hover:shadow-secondary-500/40 transition-all duration-300 hover:scale-105"
          >
            {post.category.title}
          </Badge>
        </div>

        <!-- Title with Gradient Hover -->
        <Heading
          as="h1"
          size="6xl"
          class="mb-10 md:mb-14 text-white reveal leading-[1.08] font-display text-3xl sm:text-4xl md:text-5xl lg:text-6xl xl:text-7xl font-extrabold px-2 sm:px-4 group"
          data-animation="animate-fade-in-up"
          style="transition-delay: 100ms"
        >
          <span
            class="inline-block bg-clip-text hover:text-transparent hover:bg-gradient-to-r hover:from-white hover:via-accent-300 hover:to-white transition-all duration-500 drop-shadow-[0_4px_30px_rgba(255,255,255,0.15)]"
          >
            {post.title}
          </span>
        </Heading>

        <!-- Enhanced Meta Pills with Glassmorphism -->
        <div
          class="flex flex-wrap items-center justify-center gap-3 md:gap-5 text-white reveal"
          data-animation="animate-fade-in-up"
          style="transition-delay: 200ms"
        >
          <!-- Author Pill -->
          <div
            class="group flex items-center gap-3 bg-white/10 backdrop-blur-lg px-5 py-2.5 md:px-6 md:py-3 rounded-full border border-white/20 hover:bg-white/20 hover:border-white/30 transition-all duration-300 shadow-lg hover:shadow-xl"
          >
            {
              post.author.photo && (
                <div class="w-9 h-9 md:w-11 md:h-11 rounded-full overflow-hidden border-2 border-white/60 shadow-lg ring-2 ring-accent-400/30 group-hover:ring-accent-400/50 transition-all duration-300">
                  <SanityImage
                    node={post.author.photo}
                    width={88}
                    height={88}
                    className="w-full h-full object-cover"
                  />
                </div>
              )
            }
            <div class="text-left">
              <span class="font-bold text-white text-sm md:text-base block leading-tight"
                >{post.author.name}</span
              >
              {
                post.author.role && (
                  <span class="text-white/60 text-xs hidden sm:block">{post.author.role}</span>
                )
              }
            </div>
          </div>

          <!-- Separator -->
          <span
            class="w-1.5 h-1.5 bg-gradient-to-r from-accent-400 to-secondary-400 rounded-full hidden md:block shadow-sm"
          ></span>

          <!-- Date Pill -->
          <div
            class="group flex items-center gap-2.5 bg-white/10 backdrop-blur-lg px-5 py-2.5 md:px-6 md:py-3 rounded-full border border-white/20 hover:bg-white/20 hover:border-white/30 transition-all duration-300 shadow-lg hover:shadow-xl"
          >
            <div
              class="w-8 h-8 md:w-9 md:h-9 rounded-lg bg-white/10 flex items-center justify-center group-hover:bg-accent-500/20 transition-colors duration-300"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-4 h-4 md:w-5 md:h-5 text-accent-400"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
            </div>
            <time datetime={post.publishedAt} class="font-semibold text-sm md:text-base"
              >{formatDate(post.publishedAt)}</time
            >
          </div>

          <!-- Separator -->
          <span
            class="w-1.5 h-1.5 bg-gradient-to-r from-secondary-400 to-primary-400 rounded-full hidden md:block shadow-sm"
          ></span>

          <!-- Reading Time Pill -->
          <div
            class="group flex items-center gap-2.5 bg-white/10 backdrop-blur-lg px-5 py-2.5 md:px-6 md:py-3 rounded-full border border-white/20 hover:bg-white/20 hover:border-white/30 transition-all duration-300 shadow-lg hover:shadow-xl"
          >
            <div
              class="w-8 h-8 md:w-9 md:h-9 rounded-lg bg-white/10 flex items-center justify-center group-hover:bg-secondary-500/20 transition-colors duration-300"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-4 h-4 md:w-5 md:h-5 text-secondary-400"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            </div>
            <span class="font-semibold text-sm md:text-base">{post.readingTime || 5} min read</span>
          </div>
        </div>

        <!-- Scroll Indicator -->
        <div
          class="reveal mt-12 md:mt-16"
          data-animation="animate-fade-in-up"
          style="transition-delay: 350ms"
        >
          <div
            class="flex flex-col items-center gap-2 text-white/50 group cursor-pointer hover:text-white/80 transition-colors duration-300"
          >
            <span class="text-xs uppercase tracking-widest font-medium">Scroll to read</span>
            <div
              class="w-6 h-10 rounded-full border-2 border-current flex items-start justify-center p-1.5"
            >
              <div class="w-1.5 h-3 bg-current rounded-full animate-bounce"></div>
            </div>
          </div>
        </div>
      </header>
    </Container>

    <!-- Bottom Gradient Border -->
    <div
      class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-accent-500 to-transparent opacity-60"
    >
    </div>
  </Section>

  <!-- Article Body -->
  <article class="bg-neutral-50 -mt-24 md:-mt-32 lg:-mt-40 relative z-20 md:pb-24 lg:pb-32">
    <Container class="md:pt-12 lg:pt-16">
      <div
        class="grid grid-cols-1 lg:grid-cols-12 gap-8 md:gap-12 lg:gap-16 max-w-7xl mx-auto px-4 sm:px-0"
      >
        <!-- Main Content -->
        <div class="lg:col-span-8">
          <div
            class="article-content bg-white rounded-2xl md:rounded-3xl lg:rounded-4xl p-2 sm:p-8 md:p-10 lg:p-12 shadow-soft border border-neutral-100/50 hover:shadow-xl transition-shadow duration-500"
          >
            <!-- Key Takeaways - Enhanced with Numbers -->
            {
              post.keyTakeaways && post.keyTakeaways.length > 0 && (
                <div class="key-takeaways bg-gradient-to-br from-primary-50 via-primary-50/80 to-secondary-50/30 rounded-2xl md:rounded-3xl p-6 md:p-8 lg:p-10 mb-10 md:mb-14 border border-primary-200/60 relative overflow-hidden group shadow-sm hover:shadow-md transition-all duration-500">
                  {/* Decorative Elements */}
                  <div class="absolute -top-16 -right-16 w-40 h-40 bg-gradient-to-br from-primary-300/20 to-secondary-300/10 rounded-full blur-3xl group-hover:scale-125 transition-transform duration-700" />
                  <div class="absolute -bottom-10 -left-10 w-32 h-32 bg-gradient-to-tr from-accent-300/10 to-primary-300/10 rounded-full blur-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-700" />

                  {/* Header */}
                  <div class="flex items-center gap-4 mb-8 md:mb-10 relative z-10">
                    <div class="w-12 h-12 md:w-14 md:h-14 rounded-2xl bg-gradient-to-br from-primary-500 via-primary-600 to-secondary-600 text-white flex items-center justify-center shadow-xl shadow-primary-500/25 group-hover:shadow-primary-500/40 transition-shadow duration-300">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="w-6 h-6 md:w-7 md:h-7"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                      >
                        <path d="M9 11l3 3L22 4" />
                        <path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11" />
                      </svg>
                    </div>
                    <div>
                      <h2 class="text-xl md:text-2xl lg:text-3xl font-display font-bold text-primary-900 leading-tight">
                        Key Takeaways
                      </h2>
                      <p class="text-sm text-primary-600/70 font-medium mt-0.5 hidden sm:block">
                        What you'll learn from this article
                      </p>
                    </div>
                  </div>

                  {/* Numbered List */}
                  <ol class="space-y-4 md:space-y-5 relative z-10">
                    {post.keyTakeaways.map((item, index) => (
                      <li class="takeaway-item flex items-start gap-4 md:gap-5 p-3 md:p-4 rounded-xl md:rounded-2xl bg-white/60 backdrop-blur-sm border border-white/80 hover:bg-white hover:shadow-md transition-all duration-300 group/item">
                        {/* Number Badge */}
                        <div class="flex-shrink-0 w-8 h-8 md:w-10 md:h-10 rounded-xl bg-gradient-to-br from-primary-500 to-secondary-500 text-white flex items-center justify-center font-display font-bold text-sm md:text-base shadow-md group-hover/item:scale-110 group-hover/item:shadow-lg transition-all duration-300">
                          {index + 1}
                        </div>
                        {/* Content */}
                        <div class="flex-1 pt-1">
                          <span class="text-base md:text-lg leading-relaxed font-sans text-primary-900 group-hover/item:text-primary-700 transition-colors duration-200">
                            {item}
                          </span>
                        </div>
                        {/* Check Icon */}
                        <div class="flex-shrink-0 w-6 h-6 md:w-7 md:h-7 rounded-full bg-green-100 text-green-600 flex items-center justify-center opacity-0 group-hover/item:opacity-100 transition-all duration-300 scale-75 group-hover/item:scale-100">
                          <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="w-4 h-4"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="3"
                          >
                            <polyline points="20 6 9 17 4 12" />
                          </svg>
                        </div>
                      </li>
                    ))}
                  </ol>
                </div>
              )
            }

            <!-- Article Content with Drop Cap -->
            <div
              class="reveal mb-10 md:mb-14 prose prose-lg md:prose-xl max-w-none
                     prose-headings:font-display prose-headings:text-neutral-900 prose-headings:font-bold
                     prose-h2:text-2xl prose-h2:md:text-3xl prose-h2:mt-12 prose-h2:mb-6 prose-h2:pb-4 prose-h2:border-b prose-h2:border-neutral-200
                     prose-h3:text-xl prose-h3:md:text-2xl prose-h3:mt-10 prose-h3:mb-4
                     prose-p:text-neutral-700 prose-p:leading-relaxed prose-p:mb-6
                     prose-a:text-primary-600 prose-a:font-semibold prose-a:no-underline hover:prose-a:text-primary-500 prose-a:transition-colors
                     prose-strong:text-neutral-900 prose-strong:font-bold
                     prose-blockquote:border-l-4 prose-blockquote:border-gradient-to-b prose-blockquote:from-primary-500 prose-blockquote:to-secondary-500
                     prose-blockquote:bg-gradient-to-r prose-blockquote:from-primary-50 prose-blockquote:to-transparent
                     prose-blockquote:pl-6 prose-blockquote:py-4 prose-blockquote:pr-4 prose-blockquote:rounded-r-xl
                     prose-blockquote:italic prose-blockquote:text-primary-900 prose-blockquote:not-italic
                     prose-blockquote:font-medium prose-blockquote:text-lg prose-blockquote:md:text-xl
                     prose-ul:my-6 prose-ol:my-6
                     prose-li:text-neutral-700 prose-li:mb-2
                     prose-img:rounded-2xl prose-img:shadow-lg prose-img:my-8
                     prose-figure:my-10
                     prose-figcaption:text-center prose-figcaption:text-neutral-500 prose-figcaption:text-sm prose-figcaption:mt-3
                     first-letter:font-display first-letter:text-5xl first-letter:md:text-6xl first-letter:font-bold
                     first-letter:float-left first-letter:mr-3 first-letter:mt-1
                     first-letter:text-transparent first-letter:bg-clip-text
                     first-letter:bg-gradient-to-br first-letter:from-primary-600 first-letter:to-secondary-500
                     first-letter:leading-none"
              data-animation="animate-fade-in"
            >
              <PortableText value={post.content} />
            </div>

            <!-- FAQs Section -->
            {
              post.faqs && post.faqs.length > 0 && (
                <div class="pt-10 md:pt-14 border-t-2 border-neutral-100">
                  <FAQAccordion faqs={post.faqs} />
                </div>
              )
            }

            <!-- Tags Section - Enhanced -->
            {
              post.tags && post.tags.length > 0 && (
                <div class="pt-10 md:pt-14 border-t-2 border-neutral-100">
                  <div class="flex items-center gap-3 mb-6">
                    <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-neutral-100 to-neutral-200 flex items-center justify-center text-neutral-500">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="w-5 h-5"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                      >
                        <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z" />
                        <line x1="7" y1="7" x2="7.01" y2="7" />
                      </svg>
                    </div>
                    <h3 class="text-base md:text-lg font-display font-bold text-neutral-800">
                      Related Topics
                    </h3>
                  </div>
                  <div class="flex flex-wrap gap-2.5 md:gap-3">
                    {post.tags.map((tag) => (
                      <a
                        href={`/blog?tag=${encodeURIComponent(tag)}`}
                        class="group inline-flex items-center gap-2 px-4 md:px-5 py-2.5 md:py-3 bg-neutral-100 text-neutral-700 rounded-xl md:rounded-2xl text-sm md:text-base font-semibold transition-all duration-300 hover:bg-gradient-to-r hover:from-primary-500 hover:to-secondary-500 hover:text-white hover:shadow-lg hover:shadow-primary-500/25 hover:scale-105 border border-transparent hover:border-primary-400/20"
                      >
                        <span class="text-neutral-400 group-hover:text-white/80 transition-colors">
                          #
                        </span>
                        {tag}
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          class="w-3.5 h-3.5 opacity-0 -ml-1 group-hover:opacity-100 group-hover:ml-0 transition-all duration-200"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2.5"
                        >
                          <path d="M5 12h14m-7-7 7 7-7 7" />
                        </svg>
                      </a>
                    ))}
                  </div>
                </div>
              )
            }

            <!-- Article Footer Section -->
            <div
              class="article-footer space-y-8 md:space-y-10 pt-10 md:pt-14 border-t-2 border-neutral-100"
            >
              <!-- Engagement Widget -->
              <EngagementWidget
                articleId={post.slug.current}
                question="Was this article helpful?"
              />

              <!-- Author Bio (Full) -->
              <AuthorBio
                author={post.author}
                publishedAt={post.publishedAt}
                updatedAt={post._updatedAt}
              />

              <!-- Newsletter CTA -->
              <NewsletterCTA
                title="Stay Ahead of the Curve"
                subtitle="Get expert business insights, tips, and exclusive updates delivered to your inbox weekly."
                buttonText="Subscribe Now"
              />
            </div>
          </div>
        </div>

        <!-- Sidebar - Sticky on Desktop -->
        <SidebarSticky topOffset="6rem">
          <!-- Author Card -->
          <AuthorCard author={post.author} showBio={true} showSocial={true} />

          <!-- Related Locations -->
          {
            post.relatedLocations && post.relatedLocations.length > 0 && (
              <RelatedLocations locations={post.relatedLocations} />
            )
          }

          <!-- Trending Posts -->
          <TrendingPosts posts={latestPosts} title="Trending Now" limit={3} />
        </SidebarSticky>
      </div>
    </Container>
  </article>

  <!-- Related Content Divider -->
  <div class="bg-neutral-50 py-12">
    <Container>
      <div class="h-px bg-neutral-200 w-full"></div>
    </Container>
  </div>

  <!-- More Articles -->
  <Section class="bg-neutral-50 pt-0 pb-16 md:pb-24 lg:pb-32">
    <Container>
      <header
        class="flex flex-col md:flex-row md:items-end justify-between mb-10 md:mb-16 gap-6 md:gap-8 px-4 sm:px-0"
      >
        <div class="max-w-2xl">
          <Badge
            variant="secondary"
            class="mb-4 md:mb-6 px-5 py-2 md:px-6 md:py-2.5 text-xs md:text-sm"
            >✨ Continue the Journey</Badge
          >
          <Heading
            as="h2"
            size="5xl"
            class="mb-3 md:mb-4 text-3xl sm:text-4xl md:text-5xl font-display font-extrabold"
            >Related <span
              class="bg-gradient-to-r from-primary-600 via-primary-500 to-secondary-500 bg-clip-text text-transparent"
              >Insights & Updates</span
            ></Heading
          >
          <p class="text-neutral-600 text-base md:text-lg lg:text-xl leading-relaxed">
            Stay informed with more expert perspectives on business in <span
              class="text-primary-700 font-semibold">Abu Dhabi</span
            >.
          </p>
        </div>
        <a
          href="/blog"
          class="inline-flex items-center justify-center gap-3 px-6 md:px-8 py-3 md:py-4 bg-white border-2 border-neutral-200 rounded-xl md:rounded-2xl font-bold text-sm md:text-base text-primary-700 transition-all hover:bg-gradient-to-r hover:from-primary-600 hover:to-secondary-500 hover:text-white hover:border-transparent hover:shadow-glow group w-full md:w-auto"
        >
          View All News
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-4 h-4 md:w-5 md:h-5 transition-transform group-hover:translate-x-1"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
          >
            <path d="M5 12h14m-7-7 7 7-7 7"></path>
          </svg>
        </a>
      </header>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8 lg:gap-10 px-4 sm:px-0">
        {relatedPosts.map((rp) => <BlogCard post={rp} />)}
      </div>
    </Container>
  </Section>

  <!-- Print Styles -->
  <style is:global>
    @media print {
      /* Hide non-essential elements */
      nav,
      footer,
      .share-bar-desktop,
      .share-bar-mobile,
      .back-to-top,
      .reading-progress-container,
      aside,
      .sidebar-sticky,
      [data-share-bar],
      [data-share-bar-mobile],
      [data-back-to-top],
      [data-reading-progress] {
        display: none !important;
      }

      /* Reset backgrounds and shadows */
      body,
      article,
      section,
      .article-content {
        background: white !important;
        box-shadow: none !important;
        border: none !important;
      }

      /* Improve typography for print */
      body {
        font-size: 12pt;
        line-height: 1.5;
        color: black !important;
      }

      h1,
      h2,
      h3,
      h4,
      h5,
      h6 {
        color: black !important;
        page-break-after: avoid;
      }

      p,
      li {
        orphans: 3;
        widows: 3;
      }

      /* Show URLs for links */
      a[href^='http']:after {
        content: ' (' attr(href) ')';
        font-size: 10pt;
        color: #666;
      }

      /* Images */
      img {
        max-width: 100% !important;
        page-break-inside: avoid;
      }

      /* Full width content */
      .lg\\:col-span-8 {
        grid-column: 1 / -1 !important;
        max-width: 100% !important;
      }

      /* Hide grid gaps */
      .grid {
        display: block !important;
      }

      /* Page breaks */
      article {
        page-break-before: always;
      }

      .key-takeaways,
      .faq-section {
        page-break-inside: avoid;
      }
    }
  </style>
</BaseLayout>
