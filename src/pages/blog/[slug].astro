---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import PortableText from '../../components/portable-text/PortableText.astro';
import MoreArticles from '../../components/blog/MoreArticles.astro';
import FAQAccordion from '../../components/blog/FAQAccordion.astro';
import RelatedLocations from '../../components/blog/RelatedLocations.astro';
import TrendingPosts from '../../components/blog/TrendingPosts.astro';
import SidebarSticky from '../../components/blog/SidebarSticky.astro';
import ReadingProgress from '../../components/blog/ReadingProgress.astro';
import ShareBar from '../../components/blog/ShareBar.astro';
import BackToTop from '../../components/blog/BackToTop.astro';
import NewsletterCTA from '../../components/blog/NewsletterCTA.astro';
import EngagementWidget from '../../components/blog/EngagementWidget.astro';
import AuthorBio from '../../components/blog/AuthorBio.astro';
import BlogPostHero from '../../components/blog/BlogPostHero.astro';
import KeyTakeaways from '../../components/blog/KeyTakeaways.astro';
import SEO from '../../components/SEO.astro';
import { getAllPosts, getPostBySlug, getLatestPosts } from '../../lib/sanity';
import { generateBlogPostingSchema } from '../../lib/schemas/article';
import { generateFAQSchema } from '../../lib/schemas/service';
import type { BlogPost } from '../../types';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post: BlogPost) => ({
    params: { slug: post.slug.current },
  }));
}

const { slug } = Astro.params;
const post: BlogPost = await getPostBySlug(slug as string);
const latestPosts: BlogPost[] = await getLatestPosts(5);

if (!post) {
  return Astro.redirect('/404');
}

const relatedPosts = latestPosts.filter((p) => p._id !== post._id).slice(0, 3);

// Generate Article Schema using the connected Knowledge Graph generator
const articleSchema = generateBlogPostingSchema({
  title: post.title,
  description: post.excerpt,
  slug: post.slug.current,
  publishDate: post.publishedAt,
  modifiedDate: post._updatedAt || post.publishedAt,
  image: post.featuredImage?.asset?.url,
  keywords: post.tags,
  author: {
    name: post.author.name,
    slug: post.author.slug?.current,
    image: post.author.photo?.asset?.url,
  },
});

// Generate FAQ Schema if exists
const faqSchema =
  post.faqs && post.faqs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: post.faqs.map((faq) => ({
          '@type': 'Question',
          name: faq.question,
          acceptedAnswer: {
            '@type': 'Answer',
            text: faq.answer,
          },
        })),
      }
    : null;

const schemas: any[] = [articleSchema];
if (faqSchema) schemas.push(faqSchema);

const title = `${post.metaTitle || post.title} | AtoZ Blog`;
const description = post.metaDescription || post.excerpt;

// Force dynamic OG generator for blog posts
const ogImageUrl = `/og/blog/${post.slug.current}.png`;
---

<BaseLayout title={title} description={description} ogImage={ogImageUrl}>
  <SEO
    slot="head"
    author={post.author.name}
    publishDate={post.publishedAt}
    keywords={post.tags}
    schema={schemas}
  />

  <!-- Reading Progress Bar -->
  <ReadingProgress color="gradient" height="4px" showPercentage={false} />

  <!-- Social Share Bar -->
  <ShareBar title={post.title} description={post.excerpt} />

  <!-- Back to Top Button -->
  <BackToTop showAfter={600} position="right" />

  <!-- Hero Section -->
  <BlogPostHero post={post} />

  <!-- Article Body -->
  <article class="bg-neutral-50 -mt-16 md:-mt-20 lg:-mt-24 relative z-20 md:pb-24 lg:pb-32">
    <Container class="md:pt-12 lg:pt-16">
      <div
        class="grid grid-cols-1 lg:grid-cols-12 gap-8 md:gap-12 lg:gap-16 max-w-7xl mx-auto px-4 sm:px-0"
      >
        <!-- Main Content -->
        <div class="lg:col-span-8">
          <div
            class="article-content bg-white rounded-2xl md:rounded-3xl lg:rounded-4xl p-2 sm:p-8 md:p-10 lg:p-12 shadow-soft border border-neutral-100/50 hover:shadow-xl transition-shadow duration-500"
          >
            <!-- Key Takeaways - Enhanced with Numbers -->
            <KeyTakeaways keyTakeaways={post.keyTakeaways || []} />

            <!-- Article Content with Drop Cap -->
            <div class="prose prose-lg text-neutral-600 leading-relaxed">
              <PortableText value={post.content} />
            </div>

            <!-- FAQs Section -->
            {
              post.faqs && post.faqs.length > 0 && (
                <div class="pt-10 md:pt-14 border-t-2 border-neutral-100">
                  <FAQAccordion faqs={post.faqs} />
                </div>
              )
            }

            <!-- Article Footer Section -->
            <div
              class="article-footer space-y-8 md:space-y-10 pt-10 md:pt-14 border-t-2 border-neutral-100"
            >
              <!-- Engagement Widget -->
              <EngagementWidget
                articleId={post.slug.current}
                question="Was this article helpful?"
              />

              <!-- Author  (Full) -->
              <AuthorBio
                author={post.author}
                publishedAt={post.publishedAt}
                updatedAt={post._updatedAt}
              />

              <!-- Newsletter CTA -->
              <NewsletterCTA
                title="Stay Ahead of the Curve"
                subtitle="Get expert business insights, tips, and exclusive updates delivered to your inbox weekly."
                buttonText="Subscribe Now"
              />
            </div>
          </div>
        </div>

        <!-- Sidebar - Sticky on Desktop -->
        <SidebarSticky topOffset="6rem">
          <!-- Related Locations -->
          {
            post.relatedLocations && post.relatedLocations.length > 0 && (
              <RelatedLocations locations={post.relatedLocations} />
            )
          }

          <!-- Trending Posts -->
          <TrendingPosts posts={latestPosts} title="Trending Now" limit={3} />
        </SidebarSticky>
      </div>
    </Container>
  </article>

  <!-- Related Content Divider -->
  <div class="bg-neutral-50 py-12">
    <Container>
      <div class="h-px bg-neutral-200 w-full"></div>
    </Container>
  </div>

  <!-- More Articles -->
  <!-- More Articles -->
  <MoreArticles posts={relatedPosts} />

  <!-- Print Styles -->
  <style is:global>
    @media print {
      /* Hide non-essential elements */
      nav,
      footer,
      .share-bar-desktop,
      .share-bar-mobile,
      .back-to-top,
      .reading-progress-container,
      aside,
      .sidebar-sticky,
      [data-share-bar],
      [data-share-bar-mobile],
      [data-back-to-top],
      [data-reading-progress] {
        display: none !important;
      }

      /* Reset backgrounds and shadows */
      body,
      article,
      section,
      .article-content {
        background: white !important;
        box-shadow: none !important;
        border: none !important;
      }

      /* Improve typography for print */
      body {
        font-size: 12pt;
        line-height: 1.5;
        color: black !important;
      }

      h1,
      h2,
      h3,
      h4,
      h5,
      h6 {
        color: black !important;
        page-break-after: avoid;
      }

      p,
      li {
        orphans: 3;
        widows: 3;
      }

      /* Show URLs for links */
      a[href^='http']:after {
        content: ' (' attr(href) ')';
        font-size: 10pt;
        color: #666;
      }

      /* Images */
      img {
        max-width: 100% !important;
        page-break-inside: avoid;
      }

      /* Full width content */
      .lg\\:col-span-8 {
        grid-column: 1 / -1 !important;
        max-width: 100% !important;
      }

      /* Hide grid gaps */
      .grid {
        display: block !important;
      }

      /* Page breaks */
      article {
        page-break-before: always;
      }

      .key-takeaways,
      .faq-section {
        page-break-inside: avoid;
      }
    }
  </style>
</BaseLayout>
