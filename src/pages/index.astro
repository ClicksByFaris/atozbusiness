---
import BaseLayout from '../layouts/BaseLayout.astro';
import SEO from '../components/SEO.astro';
import Hero from '../components/home/Hero.astro';
import ServicesGrid from '../components/home/ServicesGrid.astro';

import WhyChooseUs from '../components/home/WhyChooseUs.astro';
import HowItWorks from '../components/home/HowItWorks.astro';
import Stats from '../components/home/Stats.astro';
import LocationsSection from '../components/home/LocationsSection.astro';
import FAQ from '../components/home/FAQ.astro';
import CTASection from '../components/home/CTASection.astro';

// SEO imports
import { PAGE_SEO } from '../lib/seo';
import { generateLocalBusinessSchema } from '../lib/schemas/localBusiness';
import { generateFAQPageSchema } from '../lib/schemas/faqPage';
import { FAQS } from '../lib/constants';

import { sanityClient } from '../lib/sanity';
import { locationsQuery, popularServicesQuery } from '../lib/queries';

export const prerender = true;

// Fetch Sanity Data
const [locations, topServices] = await Promise.all([
  sanityClient.fetch(locationsQuery),
  sanityClient.fetch(popularServicesQuery),
]);

const mainLocation = locations?.find((loc: any) => loc.isPrimary) || locations?.[0];

// Generate schema markup
const localBusinessSchema = generateLocalBusinessSchema({
  location: 'all',
  hasMap: mainLocation?.gbpUrl,
  services: topServices?.map((s: any) => ({
    name: s.title,
    description: s.excerpt,
    url: `${Astro.site || 'https://atozbusiness.ae'}/services/${s.slug.current}`,
  })),
});
const faqSchema = generateFAQPageSchema(FAQS);
---

<BaseLayout title="Home" description={PAGE_SEO.home.description}>
  <!-- SEO Component with structured data -->
  <SEO slot="head" keywords={PAGE_SEO.home.keywords} schema={[localBusinessSchema, faqSchema]} />

  <!-- Hero Section -->
  <Hero />

  <!-- Services Grid -->
  <ServicesGrid />

  <!-- Why Choose Us -->
  <WhyChooseUs />

  <!-- How It Works -->
  <HowItWorks />

  <!-- Statistics -->
  <Stats />

  <!-- Locations -->
  <LocationsSection />

  <!-- FAQ -->
  <FAQ />

  <!-- Final CTA -->
  <CTASection />
</BaseLayout>
