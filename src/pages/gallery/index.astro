---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import Section from '../../components/ui/Section.astro';
import Heading from '../../components/ui/Heading.astro';
import SanityImage from '../../components/ui/SanityImage.astro';
import Badge from '../../components/ui/Badge.astro';
import Icon from '../../components/icons/Icon';
import { getGalleryItems } from '../../lib/sanity';
import type { GalleryItem } from '../../types';
export const prerender = true

const galleryItems: GalleryItem[] = await getGalleryItems();

// Extract unique categories from items
const uniqueCategories = ['All', ...new Set(galleryItems.map(item => item.category))];

const title = 'Gallery | AtoZ Business Services Abu Dhabi';
const description = 'Explore our offices, events, and see why we are the leading PRO service provider in Abu Dhabi.';
---

<BaseLayout title={title} description={description}>
  <!-- Hero Section -->
  <section class="relative bg-primary-900 py-24 overflow-hidden">
    <!-- Background Effects -->
    <div class="absolute inset-0 z-0">
      <div
        class="absolute inset-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:14px_24px]"
      >
      </div>
      <div
        class="absolute inset-0 bg-gradient-to-t from-primary-900 via-primary-900/90 to-primary-800/80"
      >
      </div>
    </div>

    <div
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-primary-500/20 rounded-full blur-[100px] opacity-30 pointer-events-none"
    >
    </div>

    <div class="container relative z-10 mx-auto px-4 text-center">
      <div
        class="inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-1.5 text-sm font-medium text-white backdrop-blur-md border border-white/10 mb-6 animate-fade-in-up"
      >
        <Icon name="Camera" className="w-5 h-5" client:idle />
        <span>Visual Excellence</span>
      </div>

      <h1
        class="font-display text-4xl md:text-6xl font-bold text-white mb-6 animate-fade-in-up [animation-delay:100ms] tracking-tight"
      >
        Our Journey in Frames
      </h1>
      <p
        class="mx-auto max-w-2xl text-lg text-primary-100/90 animate-fade-in-up [animation-delay:200ms] leading-relaxed"
      >
        Experience our state-of-the-art facilities and glimpse into the moments that define our professional community.
      </p>
    </div>
  </section>

  <!-- Gallery Section -->
  <Section class="bg-neutral-50 -mt-24 relative z-20 pb-24">
    <Container>
      <!-- Filter Bar -->
      <div class="flex flex-wrap justify-center gap-4 mb-16 reveal" data-animation="animate-fade-in">
        {uniqueCategories.map((cat, index) => (
          <button
            class:list={[
              "filter-btn px-8 py-3 rounded-full font-bold transition-all duration-300 border-2",
              index === 0 // Active 'All' by default
                ? "bg-primary-500 border-primary-500 text-white shadow-glow active" 
                : "bg-white border-neutral-200 text-neutral-600 hover:border-primary-500 hover:text-primary-500"
            ]}
            data-category={cat}
          >
            {cat}
          </button>
        ))}
      </div>

      <!-- Gallery Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="gallery-grid">
        {galleryItems.map((item, index) => (
          <div
            class="gallery-item group relative overflow-hidden rounded-3xl bg-white shadow-soft transition-all duration-500 hover:-translate-y-2 hover:shadow-2xl reveal w-full"
            data-category={item.category}
            data-animation="animate-fade-in-up"
            style={`transition-delay: ${index * 50}ms`}
          >
            <div class="aspect-[4/3] overflow-hidden relative">
              <SanityImage
                node={item.image}
                width={800}
                className="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-primary-950/80 via-primary-950/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            </div>
            
            <div class="absolute bottom-0 left-0 right-0 p-8 translate-y-6 group-hover:translate-y-0 transition-transform duration-500">
              <Badge variant="secondary" class="mb-3 opacity-0 group-hover:opacity-100 transition-opacity duration-700 delay-100">
                {item.category}
              </Badge>
              <h3 class="text-xl font-display font-bold text-white mb-2">{item.title}</h3>
              {item.description && (
                <p class="text-primary-100/80 text-sm opacity-0 group-hover:opacity-100 transition-opacity duration-700 delay-200 line-clamp-2">
                  {item.description}
                </p>
              )}
            </div>

            <!-- Zoom Indicator -->
            <div class="absolute top-6 right-6 w-12 h-12 rounded-full bg-white/20 backdrop-blur-md border border-white/30 flex items-center justify-center text-white opacity-0 group-hover:opacity-100 transition-all duration-500 scale-75 group-hover:scale-100">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M15 3h6v6"/><path d="M9 21H3v-6"/><path d="M21 3l-7 7"/><path d="M3 21l7-7"/>
              </svg>
            </div>
          </div>
        ))}

        {galleryItems.length === 0 && (
           <div class="col-span-full text-center py-20">
             <p class="text-neutral-500 text-lg">No gallery items found. Check back soon!</p>
           </div>
        )}
      </div>

    <script>
      const filterBtns = document.querySelectorAll('.filter-btn');
      const galleryItems = document.querySelectorAll('.gallery-item');

      filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          // Remove active class from all
          filterBtns.forEach(b => {
             b.classList.remove('bg-primary-500', 'border-primary-500', 'text-white', 'shadow-glow', 'active');
             b.classList.add('bg-white', 'border-neutral-200', 'text-neutral-600');
          });
          // Add active class to clicked
          btn.classList.remove('bg-white', 'border-neutral-200', 'text-neutral-600');
          btn.classList.add('bg-primary-500', 'border-primary-500', 'text-white', 'shadow-glow', 'active');

          const category = btn.getAttribute('data-category');

          galleryItems.forEach((item) => {
             const itemCategory = item.getAttribute('data-category');
             const htmlItem = item as HTMLElement;
             
             if (category === 'All' || category === itemCategory) {
               htmlItem.style.display = 'block';
               // Re-trigger animation
               htmlItem.classList.remove('is-visible');
               setTimeout(() => htmlItem.classList.add('is-visible'), 50);
             } else {
               htmlItem.style.display = 'none';
             }
          });
        });
      });
    </script>

      <!-- CTA -->
      <div class="mt-24 text-center reveal" data-animation="animate-fade-in-up">
        <h2 class="text-3xl font-display font-bold text-neutral-900 mb-6">Want to see more of our work?</h2>
        <p class="text-neutral-600 mb-10 max-w-2xl mx-auto text-lg">
          Follow us on social media for daily updates and a behind-the-scenes look at how we help businesses grow in Abu Dhabi.
        </p>
        <div class="flex justify-center gap-6">
          <a href="#" class="btn btn-primary px-10">Follow Us</a>
          <a href="/contact" class="btn btn-outline px-10">Contact Us</a>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>

<style>
  .shadow-glow {
    box-shadow: 0 0 20px rgba(42, 82, 152, 0.3);
  }
</style>
