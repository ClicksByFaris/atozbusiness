---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sanityClient, urlFor } from '../../lib/sanity';
import { BUSINESS_INFO } from '../../lib/constants';

// Import all LP components
import LPTrustBar from '../../components/lp/LPTrustBar.astro';
import LPHeader from '../../components/lp/LPHeader.astro';
import LPHero from '../../components/lp/LPHero.astro';
import LPPrimaryCTA from '../../components/lp/LPPrimaryCTA.astro';
import LPBenefits from '../../components/lp/LPBenefits.astro';
import LPCoreServices from '../../components/lp/LPCoreServices.astro';

import LPSocialProof from '../../components/lp/LPSocialProof.astro';
import LPTestimonials from '../../components/lp/LPTestimonials.astro';
import LPFinalCTA from '../../components/lp/LPFinalCTA.astro';
import LPContact from '../../components/lp/LPContact.astro';
import LPDisclaimer from '../../components/lp/LPDisclaimer.astro';

import { allLandingPagesQuery } from '../../lib/queries';

export const prerender = true;

// Define the data types
interface LandingPageData {
  title: string;
  slug: { current: string };

  published: boolean;
  active: boolean;
  mainHeadline: string;
  subHeadline?: string;
  heroImage?: {
    asset: any;
    altText: string;
  };
  primaryCtaText: string;
  secondaryCta?: {
    text: string;
    enabled: boolean;
  };
  benefits: Array<{
    text: string;
  }>;
  requiredDocuments?: string[];
  coreServicesHeadline?: string;
  coreServices?: Array<{
    icon?: string;
    title: string;
    description: string;
  }>;

  socialProof?: {
    googleRating: number;
    reviewCount: number;
    testimonials: Array<{
      customerName: string;
      customerPhoto?: any;
      rating: number;
      testimonial: string;
    }>;
  };
  metaTitle: string;
  metaDescription: string;
  ogImage?: {
    asset: any;
    altText: string;
  };
}

export async function getStaticPaths() {
  const landingPages = await sanityClient.fetch<LandingPageData[]>(allLandingPagesQuery);

  return landingPages.map((page) => ({
    params: { slug: page.slug.current },
    props: { page },
  }));
}

const { page } = Astro.props as { page: LandingPageData };

// Create WhatsApp link
const whatsappNumber = BUSINESS_INFO.whatsapp.replace(/[^0-9]/g, '');
const whatsappMessage = encodeURIComponent(`Hi, I'm interested in ${page.title}`);
const whatsappLink = `https://wa.me/${whatsappNumber}?text=${whatsappMessage}`;

// Get image URLs: Manual Sanity Image > Dynamic Endpoint
const ogImageUrl = page.ogImage 
  ? urlFor(page.ogImage.asset).width(1200).height(630).url() 
  : `/og/lp/${page.slug.current}.png`;
---

<BaseLayout
  title={page.metaTitle}
  description={page.metaDescription}
  ogImage={ogImageUrl}
  showNav={false}
  noindex={true}
>
  <!-- Landing Page Container - Mobile-First Optimizeded the test  -->
  <LPTrustBar />
  <LPHeader title="A to Z Business" />
  <div class="min-h-screen max-w-7xl mx-auto bg-white font-sans antialiased flex flex-col">
    <LPHero
      mainHeadline={page.mainHeadline}
      subHeadline={page.subHeadline}
      heroImage={page.heroImage}
    />

    <LPPrimaryCTA whatsappLink={whatsappLink} ctaText={page.primaryCtaText} />

    <LPBenefits benefits={page.benefits} />

    <LPCoreServices headline={page.coreServicesHeadline} services={page.coreServices} />

    <LPSocialProof socialProof={page.socialProof} />
    
    <LPTestimonials 
      testimonials={page.socialProof?.testimonials}
    />
    
    <LPContact phoneNumber={BUSINESS_INFO.phone} whatsappLink={whatsappLink} />

    <LPFinalCTA whatsappLink={whatsappLink} ctaText={page.primaryCtaText} />

    <LPDisclaimer />
  </div>

  <style>
    /* Animation delays for staggered effects */
    .animation-delay-100 {
      animation-delay: 100ms;
    }
    .animation-delay-200 {
      animation-delay: 200ms;
    }

    /* Reveal animation setup */
    .reveal {
      opacity: 0;
    }
    .reveal.is-visible {
      opacity: 1;
    }

    /* Smooth scrolling */
    html {
      scroll-behavior: smooth;
      scroll-padding-top: 80px; /* Accounts for the sticky header height */
    }

    /* Custom scrollbar for better UX */
    ::-webkit-scrollbar {
      width: 8px;
    }
    ::-webkit-scrollbar-track {
      background: #f1f1f1;
    }
    ::-webkit-scrollbar-thumb {
      background: #2a5298;
      border-radius: 4px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #1a3260;
    }
  </style>
</BaseLayout>
