---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LocationHero from '../../components/location/LocationHero.astro';
import ContactInfo from '../../components/location/ContactInfo.astro';
import GoogleMap from '../../components/location/GoogleMap';
import { sanityClient } from '../../lib/sanity';
import { locationBySlugQuery, locationsQuery } from '../../lib/queries';
import type { Location } from '../../types';
import { CircleCheck, Image as ImageIcon, Briefcase } from 'lucide-react';
import { getImageUrl } from '../../lib/sanity';

import SEO from '../../components/SEO.astro';
import SanityImage from '../../components/ui/SanityImage.astro';
import { generateLocationSchema } from '../../lib/schemas/localBusiness';

export async function getStaticPaths() {
  try {
    const locations: Location[] = await sanityClient.fetch(locationsQuery);
    
    if (!locations || locations.length === 0) {
      console.warn('No locations found in Sanity CMS');
      return [];
    }
    
    return locations.map((location) => ({
      params: { slug: location.slug.current },
    }));
  } catch (error) {
    console.error('Error fetching locations for static paths:', error);
    return [];
  }
}

const { slug } = Astro.params;

let location: Location | null = null;
try {
  location = await sanityClient.fetch(locationBySlugQuery, { slug });
} catch (error) {
  console.error(`Error fetching location with slug "${slug}":`, error);
}

if (!location) {
  return new Response(null, {
    status: 404,
    statusText: 'Not Found',
  });
}

const title = `${location.name} - AtoZ Business Services`;
const description =
  location.metaDescription ||
  `Visit AtoZ Business Services at ${location.area}. We offer professional government and typing services in Abu Dhabi.`;

const schema = generateLocationSchema({
  name: location.name,
  address: location.address,
  area: location.area,
  city: 'Abu Dhabi',
  phone: location.phone,
  latitude: location.coordinates?.lat,
  longitude: location.coordinates?.lng,
  image: location.image ? getImageUrl(location.image as any) : undefined,
});

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Locations', url: '/locations' },
  { name: location.name, url: `/locations/${location.slug.current}` },
];
---

<BaseLayout title={title} description={description}>
  <SEO
    slot="head"
    schema={schema}
    breadcrumbs={breadcrumbs}
    keywords={['typing center', location.area, 'PRO services', location.name, 'Abu Dhabi']}
  />
  <LocationHero location={location} />

  <div class="container relative z-20 px-4 py-16 mx-auto -mt-32">
    <div class="grid gap-8 lg:grid-cols-12">
      <!-- Main Content -->
      <div class="lg:col-span-8 space-y-8 animate-fade-in-up [animation-delay:300ms]">
        <!-- Gallery Section -->
        {
          location.gallery && location.gallery.length > 0 && (
            <div class="p-8 bg-white border rounded-3xl shadow-soft border-neutral-100">
              <div class="flex items-center gap-3 mb-6">
                <div class="p-2 rounded-lg bg-accent-50 text-accent-600">
                  <ImageIcon className="h-6 w-6" />
                </div>
                <h2 class="text-2xl font-bold font-display text-primary-900">Branch Gallery</h2>
              </div>

              <div class="grid grid-cols-2 gap-4 md:grid-cols-3">
                {location.gallery.map((image) => (
                  <div class="relative overflow-hidden transition shadow-sm cursor-pointer aspect-square rounded-2xl hover:opacity-90 group">
                    <SanityImage
                      node={image as any}
                      width={600}
                      height={600}
                      alt={image.alt || 'Location photo'}
                      className="object-cover w-full h-full transition-transform duration-700 group-hover:scale-110"
                    />
                    <div class="absolute inset-0 transition-colors bg-black/0 group-hover:bg-black/10" />
                  </div>
                ))}
              </div>
            </div>
          )
        }

        <!-- Services Section -->
        {
          location.servicesAvailable && location.servicesAvailable.length > 0 && (
            <div class="p-8 bg-white border rounded-3xl shadow-soft border-neutral-100">
              <div class="flex items-center gap-3 mb-6">
                <div class="p-2 rounded-lg bg-primary-50 text-primary-600">
                  <Briefcase className="h-6 w-6" />
                </div>
                <h2 class="text-2xl font-bold font-display text-primary-900">Services Available</h2>
              </div>

              <div class="grid gap-4 sm:grid-cols-2">
                {location.servicesAvailable.map((service) => (
                  <a
                    href={`/services/${service.slug.current}`}
                    class="flex items-center gap-3 p-4 transition-all border border-transparent rounded-xl bg-neutral-50 hover:bg-primary-50 hover:shadow-sm group hover:border-primary-100"
                  >
                    <div class="p-1 text-green-500 bg-white rounded-full shadow-sm shrink-0">
                      <CircleCheck className="h-4 w-4" />
                    </div>
                    <span class="font-medium text-neutral-700 group-hover:text-primary-700">
                      {service.title}
                    </span>
                  </a>
                ))}
              </div>
            </div>
          )
        }

        <!-- Map Section -->
        <div
          class="h-[400px] md:h-[500px] rounded-3xl shadow-soft bg-white border border-neutral-100 overflow-hidden"
        >
          <GoogleMap client:visible embedUrl={location.mapEmbedUrl} className="w-full h-full" />
        </div>
      </div>

      <!-- Sidebar -->
      <div class="lg:col-span-4 animate-fade-in-up [animation-delay:400ms]">
        <div class="sticky top-24">
          <ContactInfo location={location} />

          <!-- Helper CTA -->
          <div
            class="relative p-8 mt-6 overflow-hidden text-center text-white rounded-3xl bg-neutral-900"
          >
            <div class="relative z-10">
              <h3 class="mb-2 text-xl font-bold font-display">Need immediate help?</h3>
              <p class="mb-6 text-sm text-neutral-400">Our experts are ready to assist you.</p>
              <a
                href={`tel:${location.phone}`}
                class="block w-full py-3 font-bold transition-colors bg-white rounded-xl text-neutral-900 hover:bg-neutral-200"
              >
                Call Now
              </a>
            </div>
            <!-- Background blobs -->
            <div class="absolute top-0 right-0 w-32 h-32 rounded-full bg-primary-500/20 blur-2xl">
            </div>
            <div class="absolute bottom-0 left-0 w-32 h-32 rounded-full bg-accent-500/20 blur-2xl">
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
