---
import Icon from '../icons/Icon';
import PortableText from '../portable-text/PortableText.astro';

interface Props {
  features: string[];
  fullDescription: any;
}

const { features, fullDescription } = Astro.props;
---

<div class="bg-white rounded-2xl md:rounded-3xl p-8 shadow-soft border border-neutral-100/50">
  <div class="flex flex-col gap-8 items-start">
    <div class="prose prose-lg text-neutral-600">
      <h2 class="text-3xl font-bold text-neutral-900 mb-6 font-heading">About This Service</h2>
      <div class="leading-relaxed">
        <PortableText value={fullDescription} />
      </div>
    </div>
  </div>
</div>
