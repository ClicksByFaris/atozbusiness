---
import Heading from '../ui/Heading.astro';
import { formatDate } from '../../lib/utils';
import type { BlogPost } from '../../types';

interface Props {
  posts: BlogPost[];
  title?: string;
}

const { posts, title = "Helpful Guides" } = Astro.props;
const displayPosts = posts.slice(0, 3);
---

<div class="trending-posts bg-gradient-to-br from-secondary-900 via-secondary-800 to-secondary-900 rounded-2xl md:rounded-3xl p-6 md:p-8 text-white overflow-hidden relative shadow-xl hover:shadow-2xl transition-shadow duration-300">
  <!-- Background Pattern -->
  <div class="absolute inset-0 opacity-[0.03] bg-[url('data:image/svg+xml;base64,')]"></div>
  
  <!-- Animated Background Effects -->
  <div class="absolute -top-10 -right-10 w-32 h-32 bg-primary-500/20 rounded-full blur-3xl animate-pulse-slow"></div>
  <div class="absolute -bottom-10 -left-10 w-32 h-32 bg-accent-500/15 rounded-full blur-3xl animate-pulse"></div>

  <!-- Header -->
  <div class="flex items-center gap-3 mb-6 md:mb-8 relative z-10">
    <div class="w-10 h-10 md:w-12 md:h-12 rounded-xl bg-gradient-to-br from-accent-400 to-accent-500 flex items-center justify-center shadow-lg shadow-accent-500/30">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 md:w-6 md:h-6 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M12 20h9"/>
        <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
      </svg>
    </div>
    <Heading as="h3" size="xl" class="text-white border-l-4 border-accent-400 pl-4">
      {title}
    </Heading>
  </div>

  <!-- Posts List -->
  <div class="space-y-5 md:space-y-6 relative z-10">
    {displayPosts.map((post, index) => (
      <a href={`/blog/${post.slug.current}`} class="group block">
        <div class="flex items-start gap-4">
          <!-- Number/Index -->
          <div class="flex-shrink-0 w-8 h-8 rounded-lg bg-white/10 backdrop-blur-sm flex items-center justify-center text-white/80 font-display font-bold text-sm border border-white/10 group-hover:bg-accent-500 group-hover:border-accent-400 transition-all duration-300">
            {index + 1}
          </div>
          
          <!-- Content -->
          <div class="flex-1 min-w-0">
            {post.category && (
              <span class="text-[10px] md:text-xs uppercase tracking-widest text-accent-400 font-bold mb-1.5 block">
                {post.category.title}
              </span>
            )}
            <p class="font-semibold text-white group-hover:text-accent-300 transition-colors leading-snug text-sm md:text-base line-clamp-2">
              {post.title}
            </p>
            <time 
              datetime={post.publishedAt} 
              class="text-[10px] md:text-xs text-secondary-300 font-medium mt-2 block flex items-center gap-1.5"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                <line x1="16" y1="2" x2="16" y2="6"/>
                <line x1="8" y1="2" x2="8" y2="6"/>
                <line x1="3" y1="10" x2="21" y2="10"/>
              </svg>
              {formatDate(post.publishedAt)}
            </time>
          </div>
        </div>
      </a>
    ))}
  </div>

  <!-- CTA Button -->
  <a
    href="/blog"
    class="mt-8 md:mt-10 flex items-center justify-center gap-2 py-3 md:py-4 bg-white/10 hover:bg-white/20 border border-white/20 rounded-xl md:rounded-2xl transition-all text-sm md:text-base font-bold relative z-10 backdrop-blur-sm hover:shadow-lg group"
  >
    <span>Explore All Articles</span>
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M5 12h14m-7-7 7 7-7 7"/>
    </svg>
  </a>
</div>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
