---
import FAQAccordion from '../home/FAQAccordion';

interface Props {
  faqs: {
    question: string;
    answer: string;
  }[];
}

const { faqs } = Astro.props;
---

<div class="bg-white rounded-2xl md:rounded-3xl p-8 shadow-soft border border-neutral-100/50">
  <div class="text-center mb-10">
    <h2 class="text-3xl font-bold text-neutral-900 mb-4">Frequently Asked Questions</h2>
    <p class="text-neutral-600">Common questions about this specific service.</p>
  </div>

  <FAQAccordion faqs={faqs} client:visible />
</div>
