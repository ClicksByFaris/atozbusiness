---
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import Icon from '../icons/Icon';
import SanityImage from '../ui/SanityImage.astro';

interface Props {
  name: string;
  description: string;
  image?: any;
}

const { name, description, image } = Astro.props;
---

<section
  class="relative bg-gradient-to-br from-primary-950 to-primary-900 text-white py-20 sm:py-28 md:py-32 lg:py-40 xl:py-48 overflow-hidden"
>
  <!-- Main Background Visual (Blurred Image for Premium Vibe) -->
  {
    image && (
      <div class="absolute inset-0 z-0 opacity-60 pointer-events-none overflow-hidden aria-hidden='true'">
        <SanityImage
          node={image}
          width={1920}
          height={1080}
          className="w-full h-full object-cover blur-[100px] lg:blur-[150px] scale-150 opacity-80"
          priority
        />
        <div class="absolute inset-0 bg-neutral-950/80" />
        <div class="absolute inset-0 bg-gradient-to-t from-primary-950 via-primary-950/40 to-primary-950/60" />
      </div>
    )
  }

  <!-- Decorative Overlay Patterns -->
  <div class="absolute inset-0 bg-[url('/patterns/grid.svg')] opacity-10 z-0"></div>

  <!-- Modern Geometric Shapes -->
  <div class="absolute inset-0 z-0 pointer-events-none overflow-hidden" aria-hidden="true">
    <!-- Top Right Circle -->
    <div
      class="absolute -top-24 -right-24 sm:-top-32 sm:-right-32 w-48 h-48 sm:w-64 sm:h-64 md:w-96 md:h-96 lg:w-[500px] lg:h-[500px] bg-secondary-500/10 rounded-full blur-3xl animate-pulse"
    >
    </div>

    <!-- Bottom Left Circle -->
    <div
      class="absolute -bottom-32 -left-32 sm:-bottom-48 sm:-left-48 w-64 h-64 sm:w-80 sm:h-80 md:w-[500px] md:h-[500px] lg:w-[600px] lg:h-[600px] bg-primary-400/10 rounded-full blur-3xl animate-pulse"
      style="animation-delay: 1s;"
    >
    </div>

    <!-- Floating Hexagon Top Left -->
    <div
      class="absolute top-20 left-10 sm:top-32 sm:left-16 md:top-40 md:left-24 w-16 h-16 sm:w-20 sm:h-20 md:w-24 md:h-24 opacity-10 animate-float"
    >
      <svg viewBox="0 0 100 100" class="w-full h-full fill-secondary-300">
        <polygon
          points="50 1 95 25 95 75 50 99 5 75 5 25"
          stroke="currentColor"
          stroke-width="2"
          fill="none"
          class="stroke-secondary-400/40"></polygon>
      </svg>
    </div>

    <!-- Floating Square Bottom Right -->
    <div
      class="absolute bottom-32 right-12 sm:bottom-40 sm:right-20 md:bottom-48 md:right-32 w-12 h-12 sm:w-16 sm:h-16 md:w-20 md:h-20 opacity-10 animate-float-delayed rotate-45 border-2 border-primary-300/30"
    >
    </div>

    <!-- Floating Triangle Top Right -->
    <div
      class="absolute top-1/4 right-1/4 w-20 h-20 sm:w-24 sm:h-24 md:w-32 md:h-32 opacity-10 animate-float"
      style="animation-delay: 0.5s;"
    >
      <svg viewBox="0 0 100 100" class="w-full h-full">
        <polygon
          points="50 10 90 90 10 90"
          stroke="currentColor"
          stroke-width="2"
          fill="none"
          class="stroke-secondary-400/40"></polygon>
      </svg>
    </div>

    <!-- Small Dots Pattern -->
    <div
      class="absolute top-1/3 left-1/3 w-2 h-2 sm:w-3 sm:h-3 bg-white/20 rounded-full animate-pulse"
    >
    </div>
    <div
      class="absolute top-1/2 left-1/4 w-1.5 h-1.5 sm:w-2 sm:h-2 bg-secondary-400/30 rounded-full animate-pulse"
      style="animation-delay: 0.3s;"
    >
    </div>
    <div
      class="absolute bottom-1/3 right-1/3 w-2 h-2 sm:w-3 sm:h-3 bg-primary-400/30 rounded-full animate-pulse"
      style="animation-delay: 0.6s;"
    >
    </div>
  </div>

  <div class="absolute -bottom-1 left-0 w-full overflow-hidden leading-none rotate-180 z-10">
    <svg
      data-name="Layer 1"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 1200 120"
      preserveAspectRatio="none"
      class="relative block w-[calc(100%+1.3px)] h-[60px] text-neutral-50 fill-current"
    >
      <path
        d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V0H0V27.35A600.21,600.21,0,0,0,321.39,56.44Z"
      ></path>
    </svg>
  </div>

  <Container>
    <div
      class="relative z-10 max-w-4xl mx-auto text-center space-y-6 sm:space-y-7 md:space-y-8 lg:space-y-10 animate-fade-in-up px-4 sm:px-6 md:px-8"
    >
      <!-- High-End Badge -->
      <div
        class="inline-flex items-center gap-2 sm:gap-2.5 bg-white/10 backdrop-blur-md px-3 py-1.5 sm:px-4 sm:py-2 rounded-full border border-white/20 animate-fade-in mx-auto"
      >
        <Icon name="Award" className="w-3.5 h-3.5 sm:w-4 sm:h-4 text-secondary-400" client:idle />
        <span
          class="text-[10px] sm:text-xs font-bold uppercase tracking-widest text-secondary-100 italic"
          >Premium Service</span
        >
      </div>

      <h1
        class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl xl:text-7xl font-bold leading-tight sm:leading-tight md:leading-tight lg:leading-tight text-white drop-shadow-2xl tracking-tight px-2 sm:px-4"
      >
        {name}
      </h1>

      <p
        class="text-base sm:text-lg md:text-xl lg:text-2xl text-white/90 leading-relaxed sm:leading-relaxed md:leading-relaxed font-light max-w-xs sm:max-w-md md:max-w-2xl lg:max-w-3xl mx-auto drop-shadow-md px-2 sm:px-4"
      >
        {description}
      </p>

      <div
        class="flex flex-col sm:flex-row gap-3 sm:gap-4 md:gap-5 justify-center pt-4 sm:pt-6 md:pt-8 lg:pt-10 max-w-md sm:max-w-xl mx-auto"
      >
        <Button
          href="/contact"
          variant="primary"
          size="lg"
          class="shadow-glow hover:scale-105 transition-all duration-300 w-full sm:w-auto"
        >
          Book Consultation
        </Button>
        <Button
          href="/services"
          variant="outline"
          size="lg"
          class="bg-white/5 border-white/20 hover:bg-white/10 text-white backdrop-blur-sm transition-all duration-300 w-full sm:w-auto"
        >
          View All Services
        </Button>
      </div>
    </div>
  </Container>
</section>
