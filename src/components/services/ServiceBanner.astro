---
import SanityImage from '../ui/SanityImage.astro';
import Container from '../ui/Container.astro';

interface Props {
  image?: any;
  title?: string;
  height?: 'small' | 'medium' | 'large';
}

const { image, title, height = 'medium' } = Astro.props;

const heightClasses = {
  small: 'h-[200px] md:h-[250px]',
  medium: 'h-[300px] md:h-[400px]',
  large: 'h-[400px] md:h-[500px]',
};
---

{image && (
  <section class={`relative overflow-hidden ${heightClasses[height]} my-16`}>
    <!-- Background Image with Parallax Effect -->
    <div class="absolute inset-0 z-0">
      <SanityImage 
        node={image} 
        width={1600} 
        class="w-full h-full object-cover scale-105 transition-transform duration-700 hover:scale-110" 
      />
    </div>
    
    <!-- Gradient Overlay -->
    <div class="absolute inset-0 bg-gradient-to-r from-primary-900/80 via-primary-800/60 to-primary-900/80 z-10"></div>
    
    <!-- Pattern Overlay -->
    <div class="absolute inset-0 bg-[url('/patterns/grid.svg')] opacity-5 z-20"></div>
    
    <!-- Optional Title -->
    {title && (
      <Container class="relative z-30 h-full flex items-center justify-center">
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white text-center drop-shadow-2xl">
          {title}
        </h2>
      </Container>
    )}
    
    <!-- Top Wave Divider -->
    <div class="absolute -top-1 left-0 w-full overflow-hidden leading-none z-40">
      <svg
        data-name="Layer 1"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 1200 120"
        preserveAspectRatio="none"
        class="relative block w-[calc(100%+1.3px)] h-[40px] md:h-[60px] text-neutral-50 fill-current"
      >
        <path
          d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V0H0V27.35A600.21,600.21,0,0,0,321.39,56.44Z"
        ></path>
      </svg>
    </div>
    
    <!-- Bottom Wave Divider -->
    <div class="absolute -bottom-1 left-0 w-full overflow-hidden leading-none rotate-180 z-40">
      <svg
        data-name="Layer 1"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 1200 120"
        preserveAspectRatio="none"
        class="relative block w-[calc(100%+1.3px)] h-[40px] md:h-[60px] text-neutral-50 fill-current"
      >
        <path
          d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V0H0V27.35A600.21,600.21,0,0,0,321.39,56.44Z"
        ></path>
      </svg>
    </div>
  </section>
)}
