---
import Heading from '../ui/Heading.astro';

interface Location {
  name: string;
  area?: string;
  slug: {
    current: string;
  };
}

interface Props {
  locations: Location[];
  title?: string;
}

const { locations, title = "Visit Our Nearest Office" } = Astro.props;
---

<div class="related-locations bg-white rounded-2xl md:rounded-3xl p-6 md:p-8 shadow-soft border border-neutral-100/50 hover:shadow-lg transition-shadow duration-300">
  <!-- Header -->
  <div class="flex items-center gap-3 mb-6 md:mb-8">
    <div class="w-10 h-10 md:w-12 md:h-12 rounded-xl bg-gradient-to-br from-secondary-100 to-secondary-200 flex items-center justify-center text-secondary-600">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 md:w-6 md:h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
        <circle cx="12" cy="10" r="3"/>
      </svg>
    </div>
    <Heading as="h3" size="xl" class="text-neutral-900 border-l-4 border-secondary-500 pl-4">
      {title}
    </Heading>
  </div>

  <!-- Locations List -->
  <div class="space-y-3 md:space-y-4">
    {locations.map((loc) => (
      <a href={`/locations/${loc.slug.current}`} class="group block">
        <div class="flex items-center gap-3 md:gap-4 p-3 md:p-4 rounded-xl md:rounded-2xl transition-all duration-300 bg-neutral-50 border border-neutral-100 hover:border-primary-200 hover:bg-gradient-to-r hover:from-primary-50 hover:to-secondary-50 hover:shadow-md">
          <!-- Icon -->
          <div class="flex-shrink-0 w-10 h-10 md:w-12 md:h-12 rounded-lg md:rounded-xl bg-white shadow-sm flex items-center justify-center text-primary-500 group-hover:bg-gradient-to-br group-hover:from-primary-500 group-hover:to-secondary-500 group-hover:text-white transition-all duration-300 group-hover:shadow-md">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-5 h-5 md:w-6 md:h-6"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
          </div>
          
          <!-- Content -->
          <div class="flex-1 min-w-0">
            <p class="font-bold text-sm md:text-base text-neutral-900 group-hover:text-primary-700 transition-colors truncate">
              {loc.name}
            </p>
            {loc.area && (
              <p class="text-xs md:text-sm text-neutral-500 truncate">{loc.area}</p>
            )}
          </div>
          
          <!-- Arrow -->
          <div class="flex-shrink-0 w-8 h-8 rounded-full bg-neutral-100 group-hover:bg-primary-100 flex items-center justify-center text-neutral-400 group-hover:text-primary-600 transition-all duration-300">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M9 18l6-6-6-6"/>
            </svg>
          </div>
        </div>
      </a>
    ))}
  </div>

  <!-- View All Link -->
  <a 
    href="/locations"
    class="mt-6 flex items-center justify-center gap-2 py-3 px-4 rounded-xl border-2 border-dashed border-neutral-200 text-neutral-600 hover:text-primary-600 hover:border-primary-300 hover:bg-primary-50/50 transition-all duration-300 text-sm font-semibold group"
  >
    <span>View all locations</span>
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M5 12h14m-7-7 7 7-7 7"/>
    </svg>
  </a>
</div>
