---
import Heading from '../ui/Heading.astro';
import SanityImage from '../ui/SanityImage.astro';

interface Author {
  name: string;
  role?: string;
  bio?: string;
  photo?: any;
  social?: {
    twitter?: string;
    linkedin?: string;
    email?: string;
  };
}

interface Props {
  author: Author;
  publishedAt?: string;
  updatedAt?: string;
}

const { author, publishedAt, updatedAt } = Astro.props;

// Format dates
const formatDate = (dateString: string) => {
  return new Date(dateString).toLocaleDateString('en-US', {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
  });
};
---

<div
  class="author-bio bg-gradient-to-br from-primary-50/50 via-white to-secondary-50/30 rounded-2xl md:rounded-3xl p-6 md:p-8 lg:p-10 border border-primary-100/50"
>
  <div class="flex flex-col md:flex-row gap-6 md:gap-8">
    <!-- Author Photo -->
    <div class="flex-shrink-0">
      <div
        class="w-24 h-24 md:w-32 md:h-32 rounded-2xl md:rounded-3xl overflow-hidden border-4 border-white shadow-xl mx-auto md:mx-0"
      >
        {
          author.photo ? (
            <SanityImage
              node={author.photo}
              width={256}
              height={256}
              className="w-full h-full object-cover"
            />
          ) : (
            <div class="w-full h-full bg-gradient-to-br from-primary-400 to-secondary-500 flex items-center justify-center text-white text-3xl md:text-4xl font-display font-bold">
              {author.name.charAt(0)}
            </div>
          )
        }
      </div>
    </div>

    <!-- Author Info -->
    <div class="flex-1 text-center md:text-left">
      <!-- Written By Label -->
      <p class="text-xs uppercase tracking-widest text-primary-500 font-bold mb-2">Written by</p>

      <!-- Name -->
      <Heading as="h4" size="2xl" class="text-neutral-900 mb-1">
        {author.name}
      </Heading>

      <!-- Role -->
      {author.role && <p class="text-primary-600 font-medium mb-4">{author.role}</p>}

      <!-- Bio -->
      {author.bio && <p class="text-neutral-600 leading-relaxed mb-5 max-w-2xl">{author.bio}</p>}

      <!-- Social Links -->
      <div class="flex items-center justify-center md:justify-start gap-3 mb-5">
        {
          author.social?.linkedin && (
            <a
              href={author.social.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="w-10 h-10 rounded-xl bg-white border border-neutral-200 hover:border-primary-300 hover:bg-primary-50 text-neutral-500 hover:text-primary-600 flex items-center justify-center transition-all duration-300 hover:shadow-md"
              aria-label="LinkedIn Profile"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-5 h-5"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
              </svg>
            </a>
          )
        }

        {
          author.social?.twitter && (
            <a
              href={author.social.twitter}
              target="_blank"
              rel="noopener noreferrer"
              class="w-10 h-10 rounded-xl bg-white border border-neutral-200 hover:border-primary-300 hover:bg-primary-50 text-neutral-500 hover:text-primary-600 flex items-center justify-center transition-all duration-300 hover:shadow-md"
              aria-label="Twitter/X Profile"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-5 h-5"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
              </svg>
            </a>
          )
        }

        {
          author.social?.email && (
            <a
              href={`mailto:${author.social.email}`}
              class="w-10 h-10 rounded-xl bg-white border border-neutral-200 hover:border-primary-300 hover:bg-primary-50 text-neutral-500 hover:text-primary-600 flex items-center justify-center transition-all duration-300 hover:shadow-md"
              aria-label="Send Email"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-5 h-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                <polyline points="22,6 12,13 2,6" />
              </svg>
            </a>
          )
        }

        <!-- View All Posts -->
        <a
          href="/blog"
          class="ml-2 px-4 py-2.5 rounded-xl bg-primary-500 hover:bg-primary-600 text-white text-sm font-semibold transition-all duration-300 hover:shadow-md flex items-center gap-2"
        >
          <span>All posts</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-4 h-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M5 12h14m-7-7 7 7-7 7"></path>
          </svg>
        </a>
      </div>

      <!-- Published/Updated Dates -->
      {
        (publishedAt || updatedAt) && (
          <div class="flex flex-wrap items-center justify-center md:justify-start gap-4 text-sm text-neutral-500">
            {publishedAt && (
              <div class="flex items-center gap-1.5">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-4 h-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                  <line x1="16" y1="2" x2="16" y2="6" />
                  <line x1="8" y1="2" x2="8" y2="6" />
                  <line x1="3" y1="10" x2="21" y2="10" />
                </svg>
                <span>Published: {formatDate(publishedAt)}</span>
              </div>
            )}
            {updatedAt && updatedAt !== publishedAt && (
              <div class="flex items-center gap-1.5">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-4 h-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8" />
                  <path d="M21 3v5h-5" />
                </svg>
                <span>Updated: {formatDate(updatedAt)}</span>
              </div>
            )}
          </div>
        )
      }
    </div>
  </div>
</div>
