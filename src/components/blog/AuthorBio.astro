---
import SanityImage from '../ui/SanityImage.astro';

// 1. Define strict interfaces
interface SocialLinks {
  twitter?: string;
  linkedin?: string;
  email?: string;
}

interface Author {
  name: string;
  role?: string;
  bio?: string;
  // If you have a specific Sanity image type, replace 'any' with it
  photo?: any;
  social?: SocialLinks;
}

interface Props {
  author: Author;
  publishedAt?: string;
  updatedAt?: string;
}

const { author, publishedAt, updatedAt } = Astro.props;

// 2. Helper function with type safety
const formatDate = (dateString: string): string => {
  try {
    return new Date(dateString).toLocaleDateString('en-US', {
      month: 'long',
      day: 'numeric',
      year: 'numeric',
    });
  } catch (e) {
    return dateString; // Fallback if date is invalid
  }
};
---

<div
  class="mt-12 p-6 md:p-8 bg-gray-50 rounded-2xl flex flex-col sm:flex-row gap-6 items-start border border-gray-100"
>
  {/* Avatar Section */}
  <div class="flex-shrink-0">
    <div
      class="w-24 h-24 md:w-32 md:h-32 rounded-2xl md:rounded-3xl overflow-hidden border-4 border-white shadow-xl mx-auto md:mx-0"
    >
      {
        author.photo ? (
          <SanityImage
            node={author.photo}
            width={100}
            height={100}
            alt={author.photo?.alt || author.name}
            className="w-full h-full object-cover"
          />
        ) : (
          <div class="w-full h-full flex items-center justify-center bg-gray-300 text-gray-600 font-bold text-2xl select-none">
            {author.name.charAt(0).toUpperCase()}
          </div>
        )
      }
    </div>
  </div>

  {/* Info Section */}
  <div class="flex-1 min-w-0 space-y-2">
    <div>
      <p class="text-xs font-semibold tracking-wider text-gray-500 uppercase mb-1">Written by</p>
      <h3 class="text-xl font-bold text-gray-900 leading-tight">
        {author.name}
      </h3>
      {author.role && <p class="text-sm text-gray-600 font-medium">{author.role}</p>}
    </div>

    {/* Dates Section */}
    {
      (publishedAt || updatedAt) && (
        <div class="text-sm text-gray-500 flex flex-wrap gap-x-4 gap-y-1">
          {publishedAt && (
            <span class="flex items-center gap-1.5">
              <svg
                class="w-4 h-4 text-gray-400"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2" stroke-width="2" />
                <line x1="16" y1="2" x2="16" y2="6" stroke-width="2" />
                <line x1="8" y1="2" x2="8" y2="6" stroke-width="2" />
                <line x1="3" y1="10" x2="21" y2="10" stroke-width="2" />
              </svg>
              {formatDate(publishedAt)}
            </span>
          )}
          {updatedAt && updatedAt !== publishedAt && (
            <span class="flex items-center gap-1.5 border-l border-gray-300 pl-4">
              <span class="italic text-gray-400">Updated:</span> {formatDate(updatedAt)}
            </span>
          )}
        </div>
      )
    }

    {/* Social Links & Action */}
    <div class="flex items-center justify-between gap-4 pt-3 mt-2 border-t border-gray-200/60">
      {/* Social Icons */}
      <div class="flex gap-3">
        {
          author.social?.twitter && (
            <a
              href={author.social.twitter}
              target="_blank"
              rel="noopener noreferrer"
              class="text-gray-400 hover:text-gray-900 transition-colors"
              aria-label="Twitter"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
              </svg>
            </a>
          )
        }
        {
          author.social?.linkedin && (
            <a
              href={author.social.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="text-gray-400 hover:text-[#0077b5] transition-colors"
              aria-label="LinkedIn"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
              </svg>
            </a>
          )
        }
      </div>
    </div>
  </div>
</div>
