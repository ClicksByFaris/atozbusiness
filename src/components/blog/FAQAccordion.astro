---
interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  title?: string;
  faqs: FAQItem[];
}

const { title = 'Frequently Asked Questions', faqs } = Astro.props;
---

<section class="max-w-3xl mx-auto py-12 px-4">
  <h2 class="text-3xl font-bold text-gray-900 mb-8 tracking-tight">
    {title}
  </h2>

  <div class="border-t border-gray-200 divide-y divide-gray-200">
    {
      faqs.map((faq, index) => (
        <div class="group py-4">
          {/* Trigger Button */}
          <button
            type="button"
            class="faq-trigger flex items-center justify-between w-full text-left focus:outline-none"
            aria-expanded="false"
            data-index={index}
          >
            <span class="text-lg font-medium text-gray-900 group-hover:text-primary-600 transition-colors duration-200">
              {faq.question}
            </span>

            {/* Icon Wrapper */}
            <span class="ml-6 flex-shrink-0 relative w-6 h-6 flex items-center justify-center">
              {/* Vertical Line (rotates to horizontal) */}
              <span class="absolute w-0.5 h-full bg-gray-400 transition-transform duration-300 ease-out origin-center icon-v" />
              {/* Horizontal Line */}
              <span class="absolute w-full h-0.5 bg-gray-400" />
            </span>
          </button>

          {/* Content Wrapper */}
          <div
            class="faq-content overflow-hidden transition-all duration-300 ease-in-out max-h-0 opacity-0"
            aria-hidden="true"
          >
            <div class="pt-4 pb-2 text-gray-600 leading-relaxed text-base">{faq.answer}</div>
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  /* The following CSS handles the rotation animation 
    triggered by the class 'active' added via JS 
  */

  /* When active, hide the vertical line (making it a minus sign) */
  /* Or rotate it 90deg to form a cross? Let's do a rotation for a smooth effect */

  button[aria-expanded='true'] .icon-v {
    transform: rotate(90deg);
  }

  /* Optional: Change color when active */
  button[aria-expanded='true'] span.bg-gray-400 {
    @apply bg-primary-600;
  }
</style>

<script>
  // Function to initialize accordion logic
  function initAccordion() {
    // Select all triggers with explicit HTMLButtonElement type
    const triggers = document.querySelectorAll<HTMLButtonElement>('.faq-trigger');

    triggers.forEach((trigger) => {
      trigger.addEventListener('click', () => {
        // 1. Get the content associated with this trigger
        // We traverse up to the parent div, then find the content div
        const parent = trigger.parentElement as HTMLDivElement;
        const content = parent.querySelector('.faq-content') as HTMLDivElement;

        // 2. Check if currently open
        const isOpen = trigger.getAttribute('aria-expanded') === 'true';

        // 3. Close ALL other items (Accordion behavior)
        // If you want multiple items open at once, remove this block
        triggers.forEach((otherTrigger) => {
          if (otherTrigger !== trigger) {
            const otherParent = otherTrigger.parentElement as HTMLDivElement;
            const otherContent = otherParent.querySelector('.faq-content') as HTMLDivElement;

            otherTrigger.setAttribute('aria-expanded', 'false');
            otherContent.style.maxHeight = '0px';
            otherContent.style.opacity = '0';
            otherContent.setAttribute('aria-hidden', 'true');
          }
        });

        // 4. Toggle current item
        if (!isOpen) {
          // Open
          trigger.setAttribute('aria-expanded', 'true');
          content.setAttribute('aria-hidden', 'false');
          content.style.maxHeight = `${content.scrollHeight}px`;
          content.style.opacity = '1';
        } else {
          // Close
          trigger.setAttribute('aria-expanded', 'false');
          content.setAttribute('aria-hidden', 'true');
          content.style.maxHeight = '0px';
          content.style.opacity = '0';
        }
      });
    });
  }

  // Run on initial load
  initAccordion();

  // Run on View Transitions navigation (if using Astro View Transitions)
  document.addEventListener('astro:after-swap', initAccordion);
</script>
