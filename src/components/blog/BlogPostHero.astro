---
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import Heading from '../ui/Heading.astro';
import Badge from '../ui/Badge.astro';
import SanityImage from '../ui/SanityImage.astro';
import { formatDate } from '../../lib/utils';
import type { BlogPost } from '../../types';

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
---

<!-- Blog Post Hero Banner - Compact Design -->
<Section
  class="bg-gradient-to-br from-primary-900 via-primary-800 to-primary-900 text-white pt-12 pb-16 sm:pt-14 sm:pb-20 md:pt-16 md:pb-24 overflow-hidden relative"
>
  <!-- Background Image with Premium Overlay -->
  <div class="absolute inset-0 z-0">
    {
      post.featuredImage && (
        <div class="absolute inset-0">
          <SanityImage
            node={post.featuredImage}
            width={1920}
            className="w-full h-full object-cover opacity-20 scale-110 transition-transform duration-[20s] hover:scale-105"
            priority={true}
          />
          <div class="absolute inset-0 bg-gradient-to-b from-primary-900/90 via-primary-800/85 to-primary-900/95" />
        </div>
      )
    }
  </div>

  <!-- Animated Floating Shapes -->
  <div class="absolute inset-0 z-[1] overflow-hidden pointer-events-none">
    <!-- Large floating circle -->
    <div
      class="absolute -top-20 -right-20 w-80 h-80 md:w-[400px] md:h-[400px] rounded-full bg-gradient-to-br from-secondary-500/20 to-accent-500/10 blur-3xl animate-float"
    >
    </div>
    <!-- Small accent circle -->
    <div
      class="absolute top-1/3 -left-10 w-40 h-40 md:w-56 md:h-56 rounded-full bg-gradient-to-tr from-accent-500/15 to-secondary-500/10 blur-2xl animate-pulse-slow"
    >
    </div>
    <!-- Grid pattern overlay -->
    <div
      class="absolute inset-0 opacity-[0.03] bg-[url('data:image/svg+xml;base64,')]"
    >
    </div>
  </div>

  <Container>
    <header class="max-w-5xl mx-auto text-center relative z-10 px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb Navigation -->
      <nav class="reveal mb-4 md:mb-6" data-animation="animate-fade-in-up" aria-label="Breadcrumb">
        <ol class="flex items-center justify-center flex-wrap gap-2 text-sm text-white/70">
          <li>
            <a
              href="/"
              class="hover:text-white transition-colors duration-200 flex items-center gap-1.5"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-4 h-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                <polyline points="9 22 9 12 15 12 15 22"></polyline>
              </svg>
              <span>Home</span>
            </a>
          </li>
          <li class="flex items-center gap-2">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-4 h-4 text-white/40"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
            <a href="/blog" class="hover:text-white transition-colors duration-200">Blog</a>
          </li>
          <li class="flex items-center gap-2">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-4 h-4 text-white/40"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
            <span class="text-accent-400 font-medium">{post.category.title}</span>
          </li>
        </ol>
      </nav>

      <!-- Category Badge -->
      <div
        class="reveal inline-block mb-3 md:mb-4"
        data-animation="animate-fade-in-up"
        style="transition-delay: 50ms"
      >
        <Badge
          variant="secondary"
          class="bg-gradient-to-r from-secondary-500 to-secondary-600 text-white border-0 px-4 py-2 md:px-6 md:py-2.5 uppercase tracking-[0.2em] text-xs font-bold shadow-xl shadow-secondary-500/25 hover:shadow-secondary-500/40 transition-all duration-300 hover:scale-105"
        >
          {post.category.title}
        </Badge>
      </div>

      <!-- Title with Gradient Hover -->
      <Heading
        as="h1"
        size="6xl"
        class="mb-5 md:mb-7 text-white reveal leading-[1.08] font-display text-2xl sm:text-3xl md:text-4xl lg:text-5xl xl:text-6xl font-extrabold px-2 sm:px-4 group"
        data-animation="animate-fade-in-up"
        style="transition-delay: 100ms"
      >
        <span
          class="inline-block bg-clip-text hover:text-transparent hover:bg-gradient-to-r hover:from-white hover:via-accent-300 hover:to-white transition-all duration-500 drop-shadow-[0_4px_30px_rgba(255,255,255,0.15)]"
        >
          {post.title}
        </span>
      </Heading>

      <!-- Enhanced Meta Pills with Glassmorphism -->
      <div
        class="flex flex-wrap items-center justify-center gap-3 text-white reveal"
        data-animation="animate-fade-in-up"
        style="transition-delay: 200ms"
      >
        <!-- Author Pill -->
        <div
          class="group flex items-center gap-2.5 bg-white/10 backdrop-blur-lg px-4 py-2 md:px-5 md:py-2.5 rounded-full border border-white/20 hover:bg-white/20 hover:border-white/30 transition-all duration-300 shadow-lg hover:shadow-xl"
        >
          {
            post.author.photo && (
              <div class="w-7 h-7 md:w-8 md:h-8 rounded-full overflow-hidden border-2 border-white/60 shadow-lg ring-2 ring-accent-400/30 group-hover:ring-accent-400/50 transition-all duration-300">
                <SanityImage
                  node={post.author.photo}
                  width={64}
                  height={64}
                  className="w-full h-full object-cover"
                />
              </div>
            )
          }
          <div class="text-left">
            <span class="font-bold text-white text-sm block leading-tight">{post.author.name}</span>
          </div>
        </div>

        <!-- Separator -->
        <span
          class="w-1.5 h-1.5 bg-gradient-to-r from-accent-400 to-secondary-400 rounded-full hidden md:block shadow-sm"
        ></span>

        <!-- Date Pill -->
        <div
          class="group flex items-center gap-2 bg-white/10 backdrop-blur-lg px-4 py-2 md:px-5 md:py-2.5 rounded-full border border-white/20 hover:bg-white/20 hover:border-white/30 transition-all duration-300 shadow-lg hover:shadow-xl"
        >
          <div
            class="w-7 h-7 md:w-8 md:h-8 rounded-lg bg-white/10 flex items-center justify-center group-hover:bg-accent-500/20 transition-colors duration-300"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-4 h-4 text-accent-400"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
          </div>
          <time datetime={post.publishedAt} class="font-semibold text-sm"
            >{formatDate(post.publishedAt)}</time
          >
        </div>

        <!-- Separator -->
        <span
          class="w-1.5 h-1.5 bg-gradient-to-r from-secondary-400 to-primary-400 rounded-full hidden md:block shadow-sm"
        ></span>

        <!-- Reading Time Pill -->
        <div
          class="group flex items-center gap-2 bg-white/10 backdrop-blur-lg px-4 py-2 md:px-5 md:py-2.5 rounded-full border border-white/20 hover:bg-white/20 hover:border-white/30 transition-all duration-300 shadow-lg hover:shadow-xl"
        >
          <div
            class="w-7 h-7 md:w-8 md:h-8 rounded-lg bg-white/10 flex items-center justify-center group-hover:bg-secondary-500/20 transition-colors duration-300"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-4 h-4 text-secondary-400"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
          </div>
          <span class="font-semibold text-sm">{post.readingTime || 5} min read</span>
        </div>
      </div>
    </header>
  </Container>

  <!-- Bottom Gradient Border -->
  <div
    class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-accent-500 to-transparent opacity-60"
  >
  </div>
</Section>
