---
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import Heading from '../ui/Heading.astro';
import SanityImage from '../ui/SanityImage.astro';
import type { BlogPost } from '../../types';
import { formatDate } from '../../lib/utils';

interface Props {
  posts: BlogPost[];
}

const { posts } = Astro.props;
---

<Section class="bg-neutral-50 pt-0 pb-16 md:pb-24">
  <Container>
    <header class="flex items-end justify-between mb-8 md:mb-10 px-4 sm:px-0">
      <Heading as="h2" size="3xl" class="text-2xl md:text-3xl font-display font-bold"
        >Related <span
          class="bg-gradient-to-r from-primary-600 to-secondary-500 bg-clip-text text-transparent"
          >Articles</span
        ></Heading
      >
      <a
        href="/blog"
        class="hidden sm:inline-flex items-center gap-2 text-sm font-semibold text-primary-600 hover:text-primary-700 transition-colors"
      >
        View All
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-4 h-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
        >
          <path d="M5 12h14m-7-7 7 7-7 7"></path>
        </svg>
      </a>
    </header>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 md:gap-6 px-4 sm:px-0">
      {
        posts.map((post) => (
          <a
            href={`/blog/${post.slug.current}`}
            class="group flex flex-col bg-white rounded-xl overflow-hidden border border-neutral-100 hover:shadow-lg hover:-translate-y-0.5 transition-all duration-300"
          >
            <div class="aspect-[16/10] overflow-hidden">
              <SanityImage
                node={post.featuredImage}
                width={400}
                height={250}
                alt={post.featuredImage?.alt || post.title}
                className="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
              />
            </div>
            <div class="p-4 md:p-5 flex flex-col flex-1">
              <span class="text-xs text-primary-600 font-semibold mb-2">{post.category.title}</span>
              <h3 class="text-base md:text-lg font-display font-bold text-neutral-900 group-hover:text-primary-600 transition-colors leading-snug mb-2 line-clamp-2">
                {post.title}
              </h3>
              <p class="text-sm text-neutral-500 line-clamp-2 mb-3">{post.excerpt}</p>
              <div class="mt-auto flex items-center gap-2 text-xs text-neutral-400">
                <time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time>
                <span class="w-1 h-1 bg-neutral-300 rounded-full" />
                <span>{post.readingTime || 5} min read</span>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </Container>
</Section>
