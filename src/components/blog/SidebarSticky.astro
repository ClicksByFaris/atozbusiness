---
interface Props {
  class?: string;
  topOffset?: string;
}

const { class: className = '', topOffset = '6rem' } = Astro.props;
---

<aside class:list={['sidebar-sticky lg:col-span-4', className]}>
  <div
    class="sidebar-sticky-inner space-y-6 md:space-y-8 lg:space-y-10"
    style={`--sticky-top: ${topOffset}`}
  >
    <slot />
  </div>
</aside>

<style>
  .sidebar-sticky-inner {
    position: relative;
  }

  @media (min-width: 1024px) {
    .sidebar-sticky-inner {
      position: sticky;
      top: var(--sticky-top, 6rem);
      max-height: calc(100vh - var(--sticky-top, 6rem) - 2rem);
      overflow-y: auto;
      scrollbar-width: thin;
      scrollbar-color: rgba(42, 82, 152, 0.2) transparent;
      overscroll-behavior: contain;
    }

    .sidebar-sticky-inner::-webkit-scrollbar {
      width: 4px;
    }

    .sidebar-sticky-inner::-webkit-scrollbar-track {
      background: transparent;
    }

    .sidebar-sticky-inner::-webkit-scrollbar-thumb {
      background-color: rgba(42, 82, 152, 0.2);
      border-radius: 4px;
    }

    .sidebar-sticky-inner::-webkit-scrollbar-thumb:hover {
      background-color: rgba(42, 82, 152, 0.4);
    }
  }
</style>

<script>
  // Prevent page scroll when scrolling within sidebar on desktop
  function initSidebarScrollLock() {
    const sidebar = document.querySelector('.sidebar-sticky-inner');
    if (!sidebar) return;

    // Only apply on desktop (lg breakpoint and above)
    if (window.innerWidth < 1024) return;

    sidebar.addEventListener('wheel', (e) => {
      const element = e.currentTarget as HTMLElement;
      const scrollTop = element.scrollTop;
      const scrollHeight = element.scrollHeight;
      const height = element.clientHeight;
      const deltaY = (e as WheelEvent).deltaY;
      const isAtTop = scrollTop === 0;
      const isAtBottom = scrollTop + height >= scrollHeight;

      // Prevent page scroll only when sidebar has scrollable content
      if (scrollHeight > height) {
        // If scrolling up at top, or scrolling down at bottom, allow page scroll
        if ((isAtTop && deltaY < 0) || (isAtBottom && deltaY > 0)) {
          return;
        }
        // Otherwise prevent page scroll
        e.stopPropagation();
      }
    }, { passive: true });
  }

  // Initialize on load
  initSidebarScrollLock();

  // Re-initialize on page transitions (for Astro view transitions)
  document.addEventListener('astro:page-load', initSidebarScrollLock);
</script>
