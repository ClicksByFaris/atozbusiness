---
import Heading from '../ui/Heading.astro';
import SanityImage from '../ui/SanityImage.astro';

interface Author {
  name: string;
  role?: string;
  bio?: string;
  photo?: any;
  social?: {
    twitter?: string;
    linkedin?: string;
    email?: string;
  };
}

interface Props {
  author: Author;
  showBio?: boolean;
  showSocial?: boolean;
}

const { author, showBio = true, showSocial = true } = Astro.props;
---

<div
  class="author-card bg-white rounded-2xl md:rounded-3xl p-6 md:p-8 shadow-soft border border-neutral-100/50 hover:shadow-lg transition-all duration-300 group"
>
  <!-- Decorative Background -->
  <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500">
    <div class="absolute -top-10 -right-10 w-32 h-32 bg-primary-100/50 rounded-full blur-3xl"></div>
  </div>

  <!-- Author Photo -->
  <div class="relative z-10">
    <div
      class="w-24 h-24 md:w-28 md:h-28 rounded-2xl md:rounded-3xl overflow-hidden mx-auto mb-5 md:mb-6 border-4 border-primary-100 shadow-lg group-hover:border-primary-200 group-hover:shadow-xl transition-all duration-300"
    >
      {
        author.photo ? (
          <SanityImage
            node={author.photo}
            width={224}
            height={224}
            alt={author.photo?.alt || author.name}
            className="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
          />
        ) : (
          <div class="w-full h-full bg-gradient-to-br from-primary-400 to-secondary-500 flex items-center justify-center text-white text-3xl md:text-4xl font-display font-bold">
            {author.name.charAt(0)}
          </div>
        )
      }
    </div>

    <!-- Author Info -->
    <div class="text-center">
      <Heading as="h3" size="xl" class="text-neutral-900 mb-1">
        {author.name}
      </Heading>

      {
        author.role && (
          <p class="text-sm md:text-base text-primary-600 font-medium mb-4">{author.role}</p>
        )
      }

      <!-- Divider -->
      <div
        class="h-px bg-gradient-to-r from-transparent via-neutral-200 to-transparent w-full my-5 md:my-6"
      >
      </div>

      <!-- Social Links -->
      {
        showSocial && (
          <div class="flex items-center justify-center gap-3">
            {author.social?.linkedin && (
              <a
                href={author.social.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="w-10 h-10 rounded-xl bg-neutral-100 hover:bg-primary-500 text-neutral-500 hover:text-white flex items-center justify-center transition-all duration-300 hover:shadow-md hover:scale-110"
                aria-label="LinkedIn Profile"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-5 h-5"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                >
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                </svg>
              </a>
            )}

            {author.social?.twitter && (
              <a
                href={author.social.twitter}
                target="_blank"
                rel="noopener noreferrer"
                class="w-10 h-10 rounded-xl bg-neutral-100 hover:bg-primary-500 text-neutral-500 hover:text-white flex items-center justify-center transition-all duration-300 hover:shadow-md hover:scale-110"
                aria-label="Twitter/X Profile"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-5 h-5"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                >
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                </svg>
              </a>
            )}

            {author.social?.email && (
              <a
                href={`mailto:${author.social.email}`}
                class="w-10 h-10 rounded-xl bg-neutral-100 hover:bg-primary-500 text-neutral-500 hover:text-white flex items-center justify-center transition-all duration-300 hover:shadow-md hover:scale-110"
                aria-label="Send Email"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-5 h-5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                  <polyline points="22,6 12,13 2,6" />
                </svg>
              </a>
            )}
          </div>
        )
      }

      <!-- View All Posts CTA -->
      <a
        href="/blog"
        class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-primary-600 hover:text-primary-700 transition-colors group/link"
      >
        <span>View all articles</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-4 h-4 group-hover/link:translate-x-1 transition-transform"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M5 12h14m-7-7 7 7-7 7"></path>
        </svg>
      </a>
    </div>
  </div>
</div>

<style>
  .author-card {
    position: relative;
    overflow: hidden;
  }
</style>
