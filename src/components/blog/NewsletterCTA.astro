---
import Heading from '../ui/Heading.astro';

interface Props {
  title?: string;
  subtitle?: string;
  buttonText?: string;
  placeholder?: string;
}

const {
  title = 'Never Miss an Update',
  subtitle = 'Subscribe to our newsletter for the latest business insights, tips, and news delivered straight to your inbox.',
  buttonText = 'Subscribe',
  placeholder = 'Enter your email',
} = Astro.props;
---

<div
  class="newsletter-cta relative overflow-hidden rounded-2xl md:rounded-3xl bg-gradient-to-br from-primary-600 via-primary-700 to-secondary-700 p-8 md:p-10 lg:p-12"
>
  <!-- Background Decorations -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <!-- Floating shapes -->
    <div
      class="absolute -top-10 -right-10 w-40 h-40 md:w-64 md:h-64 rounded-full bg-white/5 blur-3xl"
    >
    </div>
    <div
      class="absolute -bottom-10 -left-10 w-32 h-32 md:w-48 md:h-48 rounded-full bg-accent-500/10 blur-3xl"
    >
    </div>
    <!-- Grid pattern -->
    <div
      class="absolute inset-0 opacity-[0.03] bg-[url('data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iNDAiIGhlaWdodD0iNDAiIHZpZXdCb3g9IjAgMCA0MCA0MCIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj48ZyBmaWxsPSJub25lIiBmaWxsLXJ1bGU9ImV2ZW5vZGQiPjxwYXRoIGQ9Ik0wIDBoNDB2NDBoLTQweiIvPjxwYXRoIGQ9Ik00MCAwdjQwaDQwdi00MHoiIHN0cm9rZT0iI2ZmZiIgc3Ryb2tlLXdpZHRoPSIxIi8+PC9nPjwvc3ZnPg==')]"
    >
    </div>
    <!-- Envelope icon decoration -->
    <div class="absolute top-6 right-6 md:top-10 md:right-10 opacity-10">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="w-24 h-24 md:w-32 md:h-32 text-white"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1"
      >
        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
        ></path>
        <polyline points="22,6 12,13 2,6"></polyline>
      </svg>
    </div>
  </div>

  <div class="relative z-10">
    <!-- Icon -->
    <div
      class="w-14 h-14 md:w-16 md:h-16 rounded-2xl bg-white/10 backdrop-blur-sm flex items-center justify-center mb-6 mx-auto md:mx-0"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="w-7 h-7 md:w-8 md:h-8 text-accent-400"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
        ></path>
        <polyline points="22,6 12,13 2,6"></polyline>
      </svg>
    </div>

    <!-- Content -->
    <div class="text-center md:text-left mb-8">
      <Heading as="h3" size="3xl" class="text-white mb-3">
        {title}
      </Heading>
      <p class="text-white/80 text-base md:text-lg max-w-xl">
        {subtitle}
      </p>
    </div>

    <!-- Form -->
    <form class="newsletter-form flex flex-col sm:flex-row gap-3 max-w-xl" data-newsletter-form>
      <div class="flex-1 relative">
        <input
          type="email"
          name="email"
          placeholder={placeholder}
          required
          class="w-full px-5 py-4 rounded-xl md:rounded-2xl bg-white/10 backdrop-blur-sm border border-white/20 text-white placeholder-white/50 focus:outline-none focus:ring-2 focus:ring-accent-400 focus:border-transparent transition-all text-base"
        />
      </div>
      <button
        type="submit"
        class="newsletter-submit px-8 py-4 rounded-xl md:rounded-2xl bg-accent-500 hover:bg-accent-400 text-white font-bold text-base transition-all duration-300 hover:shadow-lg hover:shadow-accent-500/30 hover:scale-105 active:scale-95 flex items-center justify-center gap-2 min-w-[140px]"
      >
        <span class="submit-text">{buttonText}</span>
        <span class="submit-loading hidden">
          <svg
            class="animate-spin w-5 h-5"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
          >
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"
            ></circle>
            <path
              class="opacity-75"
              fill="currentColor"
              d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
            ></path>
          </svg>
        </span>
        <span class="submit-success hidden">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-5 h-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="3"
          >
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-5 h-5 submit-arrow"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M5 12h14m-7-7 7 7-7 7"></path>
        </svg>
      </button>
    </form>

    <!-- Success Message -->
    <div
      class="newsletter-success hidden mt-4 p-4 rounded-xl bg-green-500/20 border border-green-400/30 text-green-300 text-center"
      data-newsletter-success
    >
      <div class="flex items-center justify-center gap-2">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-5 h-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
          <polyline points="22 4 12 14.01 9 11.01"></polyline>
        </svg>
        <span class="font-medium">Thanks for subscribing! Check your inbox to confirm.</span>
      </div>
    </div>

    <!-- Privacy note -->
    <p class="text-white/50 text-xs mt-4 text-center md:text-left">
      By subscribing, you agree to our
      <a href="/privacy" class="underline hover:text-white/70 transition-colors">Privacy Policy</a>.
      Unsubscribe anytime.
    </p>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.querySelector('[data-newsletter-form]') as HTMLFormElement;
    const successMessage = document.querySelector('[data-newsletter-success]');

    if (!form) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const submitBtn = form.querySelector('.newsletter-submit') as HTMLButtonElement;
      const submitText = submitBtn?.querySelector('.submit-text');
      const submitLoading = submitBtn?.querySelector('.submit-loading');
      const submitSuccess = submitBtn?.querySelector('.submit-success');
      const submitArrow = submitBtn?.querySelector('.submit-arrow');

      // Show loading
      if (submitText) submitText.classList.add('hidden');
      if (submitArrow) submitArrow.classList.add('hidden');
      if (submitLoading) submitLoading.classList.remove('hidden');
      if (submitBtn) submitBtn.disabled = true;

      // Simulate API call (replace with actual endpoint)
      await new Promise((resolve) => setTimeout(resolve, 1500));

      // Show success
      if (submitLoading) submitLoading.classList.add('hidden');
      if (submitSuccess) submitSuccess.classList.remove('hidden');
      submitBtn?.classList.add('bg-green-500', 'hover:bg-green-500');

      // Show success message
      if (successMessage) {
        successMessage.classList.remove('hidden');
      }

      // Hide form after delay
      setTimeout(() => {
        form.classList.add('opacity-50', 'pointer-events-none');
      }, 500);
    });
  });
</script>
