---
import { MessageCircle, Phone, MapPin } from 'lucide-react';
import { BUSINESS_INFO, LOCATIONS } from '../../lib/constants';

interface Props {
  pageTitle?: string;
}

const { pageTitle = BUSINESS_INFO.name } = Astro.props;

const phoneNumber = BUSINESS_INFO.phone;
const whatsappMessage = encodeURIComponent(`Hi, I'm interested in ${pageTitle}`);
const whatsappLink = `https://wa.me/${BUSINESS_INFO.whatsapp.replace(/[^0-9]/g, '')}?text=${whatsappMessage}`;

const telLink = `tel:${phoneNumber.replace(/[^0-9+]/g, '')}`;
---

<div class="fixed bottom-6 right-4 z-[9999] flex flex-col gap-3 pointer-events-none sm:bottom-8 sm:right-8 sm:gap-4">
  <!-- WhatsApp Button -->
  <div class="flex items-center justify-end gap-3 pointer-events-auto group">
    <span class="bg-white/90 backdrop-blur-sm text-[#25D366] text-[11px] font-bold py-1 px-2.5 rounded-lg shadow-sm border border-[#25D366]/20 transition-all duration-300 group-hover:bg-[#25D366] group-hover:text-white">
        WhatsApp
    </span>
    <a
      href={whatsappLink}
      target="_blank"
      rel="noopener noreferrer"
      class="relative flex items-center justify-center w-12 h-12 sm:w-14 sm:h-14 bg-[#25D366] text-white rounded-full shadow-lg transition-all duration-300 hover:scale-110 active:scale-95"
      aria-label="Chat on WhatsApp"
    >
      <div class="absolute inset-0 rounded-full bg-[#25D366] animate-pulse opacity-50"></div>
      <MessageCircle className="w-6 h-6 sm:w-7 sm:h-7 relative z-10" />
      <span class="absolute inset-0 rounded-full bg-[#25D366] animate-ping opacity-20"></span>
      <span class="absolute -top-1 -left-1 bg-red-500 text-white text-[9px] w-4 h-4 rounded-full flex items-center justify-center font-bold shadow-lg border-2 border-white">
          1
      </span>
    </a>
  </div>

  <!-- Call Button -->
  <div class="flex items-center justify-end gap-3 pointer-events-auto group">
    <span class="bg-white/90 backdrop-blur-sm text-slate-900 text-[11px] font-bold py-1 px-2.5 rounded-lg shadow-sm border border-slate-200 transition-all duration-300 group-hover:bg-slate-900 group-hover:text-white">
        Call Now
    </span>
    <a
      href={telLink}
      class="relative flex items-center justify-center w-12 h-12 sm:w-14 sm:h-14 bg-slate-900 text-white rounded-full shadow-lg transition-all duration-300 hover:scale-110 active:scale-95"
      aria-label="Call Now"
    >
      <Phone className="w-5 h-5 sm:w-6 sm:h-6" />
    </a>
  </div>

  <!-- Location Button -->
  <div class="flex items-center justify-end gap-3 pointer-events-auto group">
    <span class="bg-white/90 backdrop-blur-sm text-blue-600 text-[11px] font-bold py-1 px-2.5 rounded-lg shadow-sm border border-blue-100 transition-all duration-300 group-hover:bg-blue-600 group-hover:text-white">
        Our Locations
    </span>
    <a
      href="/locations"
      class="relative flex items-center justify-center w-12 h-12 sm:w-14 sm:h-14 bg-blue-600 text-white rounded-full shadow-lg transition-all duration-300 hover:scale-110 active:scale-95"
      aria-label="Find Our Office"
    >
      <MapPin className="w-5 h-5 sm:w-6 sm:h-6" />
    </a>
  </div>
</div>
