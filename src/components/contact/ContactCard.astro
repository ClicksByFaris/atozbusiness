---
export interface Props {
  icon: string;
  title: string;
  value: string;
  href?: string;
  description?: string;
}

const { icon, title, value, href, description } = Astro.props;
---

<div
  class="group relative bg-neutral-50 border border-neutral-200 rounded-xl p-6 hover:shadow-lg transition-all duration-300 hover:border-primary-300"
>
  <!-- Icon -->
  <div
    class="inline-flex items-center justify-center w-12 h-12 rounded-lg bg-gradient-to-br from-primary-500 to-secondary-500 mb-4 group-hover:scale-110 transition-transform duration-300"
  >
    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      {
        icon === 'Phone' && (
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
          />
        )
      }
      {
        icon === 'Mail' && (
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
          />
        )
      }
      {
        icon === 'MessageCircle' && (
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"
          />
        )
      }
      {
        icon === 'MapPin' && (
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z"
          />
        )
      }
      {
        icon === 'Clock' && (
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
          />
        )
      }
    </svg>
  </div>

  <!-- Content -->
  <div class="space-y-2">
    <h3 class="text-lg font-semibold text-neutral-900">{title}</h3>

    {
      href ? (
        <a
          href={href}
          class="inline-block text-primary-600 hover:text-primary-700 font-medium transition-colors text-lg"
        >
          {value}
        </a>
      ) : (
        <p class="text-neutral-900 font-medium text-lg">{value}</p>
      )
    }

    {description && <p class="text-neutral-600 text-sm">{description}</p>}
  </div>

  <!-- Hover effect indicator -->
  <div
    class="absolute inset-0 rounded-xl ring-2 ring-primary-500 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"
  >
  </div>
</div>
