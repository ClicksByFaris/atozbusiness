---
import { ChevronDown } from 'lucide-react';
import { BUSINESS_INFO } from '../../lib/constants';

interface Props {
  categories?: string[];
  groupedServices?: Record<string, any[]>;
}

const { categories = [], groupedServices = {} } = Astro.props;
const currentPath = Astro.url.pathname;

const navigation = [
  { name: 'Home', href: '/' },
  { name: 'Services', href: '/services', hasDropdown: true },
  { name: 'About', href: '/about' },
  { name: 'Blog', href: '/blog' },
  { name: 'Contact', href: '/contact' },
];

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<nav class="hidden lg:flex items-center gap-6 xl:gap-8">

  <!-- Nav Links -->
  {navigation.map((item) => (
    <div class="relative group/nav">
      {item.hasDropdown ? (
        <>
          <button
            class:list={[
              'flex items-center gap-1 text-neutral-700 hover:text-primary-600 font-medium text-sm transition-colors py-2 relative',
              isActive(item.href) && 'text-primary-600',
            ]}
          >
            {item.name}
            <ChevronDown className="w-4 h-4 transition-transform duration-200 group-hover/nav:rotate-180" />
            {isActive(item.href) && (
              <span class="absolute bottom-0 left-0 right-0 h-0.5 bg-primary-500 rounded-full" />
            )}
          </button>

          <!-- Mega dropdown -->
          <div class="absolute top-full left-1/2 -translate-x-1/2 w-[600px] bg-white rounded-xl shadow-xl border border-neutral-100 opacity-0 invisible group-hover/nav:opacity-100 group-hover/nav:visible transition-all duration-200 translate-y-2 group-hover/nav:translate-y-0 p-6 grid grid-cols-2 gap-8 before:absolute before:-top-4 before:left-0 before:w-full before:h-4">
            {categories.map((category) => (
              <div>
                <h3 class="font-bold text-neutral-900 mb-3 pb-2 border-b border-neutral-100 text-xs tracking-wider uppercase">
                  {category}
                </h3>
                <ul class="space-y-2">
                  {groupedServices[category]?.map((service: any) => (
                    <li>
                      <a
                        href={`/services/${service.slug}`}
                        class="block group/link"
                      >
                        <div class="text-sm font-medium text-neutral-700 group-hover/link:text-primary-500 transition-colors">
                          {service.title}
                        </div>
                        {service.shortDescription && (
                          <p class="text-xs text-neutral-400 mt-0.5 line-clamp-1 group-hover/link:text-neutral-500 transition-colors">
                            {service.shortDescription}
                          </p>
                        )}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </>
      ) : (
        <a
          href={item.href}
          class:list={[
            'text-neutral-700 hover:text-primary-600 font-medium text-sm transition-colors relative py-2 block',
            isActive(item.href) && 'text-primary-600',
          ]}
        >
          {item.name}
          {isActive(item.href) && (
            <span class="absolute bottom-0 left-0 right-0 h-0.5 bg-primary-500 rounded-full" />
          )}
        </a>
      )}
    </div>
  ))}

  <!-- CTA Buttons -->
  <div class="flex items-center gap-2 ml-2">

    <!-- Call Now: outlined -->
    <a
      href={`tel:${BUSINESS_INFO.phone}`}
      class="inline-flex items-center gap-2 rounded-full border border-neutral-300 bg-white px-5 py-2 text-sm font-semibold text-neutral-700 transition-all duration-200 hover:border-primary-400 hover:text-primary-600 hover:bg-primary-50"
    >
      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
        <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
      </svg>
      Call Now
    </a>

    <!-- WhatsApp Us: green filled -->
    <a
      href={`https://wa.me/${BUSINESS_INFO.whatsapp.replace(/[^0-9]/g, '')}`}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 rounded-full bg-[#25D366] px-5 py-2 text-sm font-semibold text-white shadow-sm transition-all duration-200 hover:bg-[#20bc5a] hover:shadow-md hover:scale-105"
    >
      <!-- WhatsApp icon -->
      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
      WhatsApp Us
    </a>

  </div>
</nav>
