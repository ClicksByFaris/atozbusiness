---
import Container from '../ui/Container.astro';
import { Mail, MapPin, Facebook, Instagram, Linkedin } from 'lucide-react';
import { BUSINESS_INFO, LOCATIONS } from '../../lib/constants';
import logo from '../../assets/logo.png';
import { Image } from 'astro:assets';

const currentYear = new Date().getFullYear();

const footerLinks = {
  services: [
    { name: 'Golden Visa', href: '/services/golden-visa-services' },
    { name: 'Family Visa', href: '/services/family-visa-typing' },
    { name: 'Company Formation', href: '/services/new-company-formation' },
    { name: 'PRO Services', href: '/services/pro-services' },
  ],
  company: [
    { name: 'About Us', href: '/about' },
    { name: 'Our Locations', href: '/locations' },
    { name: 'Careers', href: '/careers' },
    { name: 'Contact', href: '/contact' },
  ],
  resources: [
    { name: 'Blog', href: '/blog' },
    { name: 'Gallery', href: '/gallery' },
    { name: 'Privacy Policy', href: '/privacy-policy' },
    { name: 'Terms of Service', href: '/terms-of-service' },
  ],
};
---

<footer class="bg-neutral-950 text-neutral-400 border-t border-white/5">
  <!-- Main Footer -->
  <Container>
    <div class="py-20">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-8">
        <!-- Company Info -->
        <div class="space-y-8">
          <div>
            <div class="inline-block bg-white/95 px-4 py-3 rounded-xl mb-6 shadow-lg">
              <Image src={logo} alt="AtoZ Business Services" class="h-12 w-auto" />
            </div>
            <p class="text-sm leading-relaxed max-w-xs">
              Your elite partner for typing and PRO services in Abu Dhabi. We bridge the gap between
              complexity and efficiency for all your government documentation needs.
            </p>
          </div>

          <div class="flex gap-4">
            {
              [Facebook, Instagram, Linkedin].map((Icon, i) => (
                <a
                  href={BUSINESS_INFO.website}
                  class="w-10 h-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center hover:bg-primary-500 hover:text-white transition-all duration-300"
                  aria-label="Social Link"
                >
                  <Icon size={18} />
                </a>
              ))
            }
          </div>
        </div>

        <!-- Quick Links - Services -->
        <div>
          <h3 class="text-white font-display font-bold text-lg mb-8 relative inline-block">
            Our Services
            <span class="absolute -bottom-2 left-0 w-8 h-1 bg-secondary-500 rounded-full"></span>
          </h3>
          <ul class="space-y-4">
            {
              footerLinks.services.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-sm hover:text-secondary-400 transition-colors flex items-center gap-2 group"
                  >
                    <span class="w-1.5 h-1.5 rounded-full bg-white/10 group-hover:bg-secondary-500 transition-colors" />
                    {link.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Quick Links - Company -->
        <div>
          <h3 class="text-white font-display font-bold text-lg mb-8 relative inline-block">
            Company
            <span class="absolute -bottom-2 left-0 w-8 h-1 bg-secondary-500 rounded-full"></span>
          </h3>
          <ul class="space-y-4">
            {
              footerLinks.company.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-sm hover:text-secondary-400 transition-colors flex items-center gap-2 group"
                  >
                    <span class="w-1.5 h-1.5 rounded-full bg-white/10 group-hover:bg-secondary-500 transition-colors" />
                    {link.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Contact Info -->
        <div>
          <h3 class="text-white font-display font-bold text-lg mb-8 relative inline-block">
            Contact Us
            <span class="absolute -bottom-2 left-0 w-8 h-1 bg-secondary-500 rounded-full"></span>
          </h3>
          <ul class="space-y-6">
            <li class="flex items-start gap-4 text-sm group">
              <div
                class="w-10 h-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-secondary-500 group-hover:bg-secondary-500 group-hover:text-white transition-all duration-300 flex-shrink-0"
              >
                <MapPin size={18} />
              </div>
              <div>
                <span class="block text-white font-bold mb-1">{LOCATIONS.main.name}</span>
                <span class="block text-xs mb-2 text-neutral-500">{LOCATIONS.main.address}</span>
                <a
                  href={`tel:${BUSINESS_INFO.phone}`}
                  class="text-secondary-400 font-bold hover:text-secondary-300 transition-colors"
                >
                  {BUSINESS_INFO.phone}
                </a>
              </div>
            </li>
            <li class="flex items-start gap-4 text-sm pt-6 border-t border-white/5 group">
              <div
                class="w-10 h-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-secondary-500 group-hover:bg-secondary-500 group-hover:text-white transition-all duration-300 flex-shrink-0"
              >
                <Mail size={18} />
              </div>
              <div class="flex flex-col">
                <span class="text-xs text-neutral-500 mb-1">Email us at</span>
                <a
                  href={`mailto:${BUSINESS_INFO.email}`}
                  class="text-white font-medium hover:text-secondary-400 transition-colors"
                >
                  {BUSINESS_INFO.email}
                </a>
              </div>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </Container>

  <!-- Disclaimer Section -->
  <div class="border-t border-white/5 bg-white/5">
    <Container>
      <div class="py-8 text-center bg-transparent">
        <p class="text-xs text-neutral-500 leading-relaxed max-w-4xl mx-auto">
          <span class="font-bold text-neutral-400">Disclaimer:</span> We are a private typing center and
          not affiliated with the UAE Government. We charge a service fee for our typing and application
          assistance services. Government services can also be availed directly through official government
          channels.
        </p>
      </div>
    </Container>
  </div>

  <!-- Bottom Bar -->
  <div class="border-t border-white/5 bg-black/20">
    <Container>
      <div
        class="py-10 flex flex-col md:flex-row justify-between items-center text-xs tracking-widest uppercase font-bold text-neutral-500"
      >
        <p>
          © {currentYear} AtoZ Business Services. <span class="hidden sm:inline"
            >Crafted with precision in Abu Dhabi.</span
          >
        </p>
        <div class="flex gap-8 mt-6 md:mt-0">
          {
            footerLinks.resources.slice(-2).map((link) => (
              <a href={link.href} class="hover:text-white transition-colors">
                {link.name}
              </a>
            ))
          }
        </div>
      </div>
    </Container>
  </div>
</footer>
