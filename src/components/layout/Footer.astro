---
import Container from "../ui/Container.astro";
import {
    Phone,
    Mail,
    MapPin,
    Facebook,
    Instagram,
    Linkedin,
} from "lucide-react";

const currentYear = new Date().getFullYear();

const footerLinks = {
    services: [
        { name: "Golden Visa", href: "/services/golden-visa" },
        { name: "Family Visa", href: "/services/family-visa" },
        { name: "MOHRE Typing", href: "/services/mohre-typing" },
        { name: "PRO Services", href: "/services/pro-services" },
    ],
    company: [
        { name: "About Us", href: "/about" },
        { name: "Our Locations", href: "/locations" },
        { name: "Careers", href: "/careers" },
        { name: "Contact", href: "/contact" },
    ],
    resources: [
        { name: "Blog", href: "/blog" },
        { name: "Gallery", href: "/gallery" },
        { name: "Privacy Policy", href: "/privacy-policy" },
        { name: "Terms of Service", href: "/terms-of-service" },
    ],
};

const siteConfig = {
    phone: "+971-XXX-XXXXXXX",
    whatsapp: "971XXXXXXXXX",
    email: "info@atozbusiness.ae",
    address:
        "Mohammed Alhur Al Suwaidi St, opposite Khalidiya Mall, Khalidiya, Abu Dhabi",
};
---

<footer class="bg-gray-900 text-gray-300">
    <!-- Main Footer -->
    <Container>
        <div class="py-16">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
                <!-- Company Info -->
                <div>
                    <img
                        src="/assets/logo.svg"
                        alt="AtoZ Business Services"
                        class="h-12 w-auto mb-4 brightness-0 invert"
                    />
                    <p class="text-sm mb-4">
                        Your trusted partner for typing and PRO services in Abu
                        Dhabi. Fast, reliable, and professional assistance for
                        all your government documentation needs.
                    </p>
                    <div class="flex gap-4">
                        <a
                            href="#"
                            class="text-gray-400 hover:text-white transition-colors"
                        >
                            <Facebook size={20} />
                        </a>
                        <a
                            href="#"
                            class="text-gray-400 hover:text-white transition-colors"
                        >
                            <Instagram size={20} />
                        </a>
                        <a
                            href="#"
                            class="text-gray-400 hover:text-white transition-colors"
                        >
                            <Linkedin size={20} />
                        </a>
                    </div>
                </div>

                <!-- Quick Links - Services -->
                <div>
                    <h3 class="text-white font-semibold text-lg mb-4">
                        Our Services
                    </h3>
                    <ul class="space-y-2">
                        {
                            footerLinks.services.map((link) => (
                                <li>
                                    <a
                                        href={link.href}
                                        class="text-sm hover:text-white transition-colors"
                                    >
                                        {link.name}
                                    </a>
                                </li>
                            ))
                        }
                    </ul>
                </div>

                <!-- Quick Links - Company -->
                <div>
                    <h3 class="text-white font-semibold text-lg mb-4">
                        Company
                    </h3>
                    <ul class="space-y-2">
                        {
                            footerLinks.company.map((link) => (
                                <li>
                                    <a
                                        href={link.href}
                                        class="text-sm hover:text-white transition-colors"
                                    >
                                        {link.name}
                                    </a>
                                </li>
                            ))
                        }
                    </ul>
                </div>

                <!-- Contact Info -->
                <div>
                    <h3 class="text-white font-semibold text-lg mb-4">
                        Contact Us
                    </h3>
                    <ul class="space-y-3">
                        <li class="flex items-start gap-2 text-sm">
                            <Phone size={16} className="mt-1 flex-shrink-0" />
                            <a
                                href={`tel:${siteConfig.phone}`}
                                class="hover:text-white transition-colors"
                            >
                                {siteConfig.phone}
                            </a>
                        </li>
                        <li class="flex items-start gap-2 text-sm">
                            <Mail size={16} className="mt-1 flex-shrink-0" />
                            <a
                                href={`mailto:${siteConfig.email}`}
                                class="hover:text-white transition-colors"
                            >
                                {siteConfig.email}
                            </a>
                        </li>
                        <li class="flex items-start gap-2 text-sm">
                            <MapPin size={16} className="mt-1 flex-shrink-0" />
                            <span>{siteConfig.address}</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </Container>

    <!-- Bottom Bar -->
    <div class="border-t border-gray-800">
        <Container>
            <div
                class="py-6 flex flex-col md:flex-row justify-between items-center text-sm"
            >
                <p>
                    © {currentYear} AtoZ Business Services. All rights reserved.
                </p>
                <div class="flex gap-6 mt-4 md:mt-0">
                    {
                        footerLinks.resources.slice(-2).map((link) => (
                            <a
                                href={link.href}
                                class="hover:text-white transition-colors"
                            >
                                {link.name}
                            </a>
                        ))
                    }
                </div>
            </div>
        </Container>
    </div>
</footer>
