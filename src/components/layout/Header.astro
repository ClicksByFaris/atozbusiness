---
import Container from '../ui/Container.astro';
import Navigation from './Navigation.astro';
import MobileMenu from './MobileMenu';
import { BUSINESS_INFO, BUSINESS_HOURS } from '../../lib/constants';
import logo from '../../assets/logo.png';
import { Image } from 'astro:assets';
---

<header class="sticky top-0 z-50 bg-white shadow-sm">
  <!-- Top Bar -->
  <div class="bg-gradient-to-r from-primary-500 to-secondary-500 text-white py-2">
    <Container>
      <div class="flex justify-between items-center text-sm">
        <div class="hidden md:flex items-center gap-4">
          <a
            href={`tel:${BUSINESS_INFO.phone}`}
            class="flex items-center gap-2 hover:text-primary-100 transition-colors"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
              <path
                d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"
              ></path>
            </svg>
            {BUSINESS_INFO.phone}
          </a>
          <a
            href={`mailto:${BUSINESS_INFO.email}`}
            class="flex items-center gap-2 hover:text-primary-100 transition-colors"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"
              ></path>
              <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"></path>
            </svg>
            {BUSINESS_INFO.email}
          </a>
        </div>
        <div class="ml-auto flex items-center gap-3">
          <span class="hidden sm:inline">{BUSINESS_HOURS.weekdays}</span>
        </div>
      </div>
    </Container>
  </div>

  <!-- Main Header -->
  <Container>
    <div class="flex items-center justify-between h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center">
        <Image src={logo} alt="AtoZ Business Services" class="h-12 w-auto" />
      </a>

      <!-- Desktop Navigation -->
      <Navigation />

      <!-- Mobile Menu Button -->
      <MobileMenu client:load />
    </div>
  </Container>
</header>
