---
import Container from '../ui/Container.astro';
import Navigation from './Navigation.astro';
import MobileMenu from './MobileMenu';
import { BUSINESS_INFO, BUSINESS_HOURS } from '../../lib/constants';
import logo from '../../assets/logo.png';
import { Image } from 'astro:assets';
import { getNavigationServices } from '../../lib/sanity';

const services = await getNavigationServices();

// Group services by category
const groupedServices = services.reduce((acc: Record<string, any[]>, service: any) => {
  const cat = service.category || 'Other';
  if (!acc[cat]) {
    acc[cat] = [];
  }
  acc[cat].push(service);
  return acc;
}, {});

const categories = Object.keys(groupedServices).sort();
---

<header class="sticky top-0 z-50 transition-all duration-300 group" id="main-header">
  <!-- Top Bar -->
  <div
    class="bg-gradient-to-r from-primary-800 via-primary-700 to-secondary-700 text-white py-2 relative overflow-hidden shadow-sm"
  >
    <div class="absolute inset-0 bg-[url('/patterns/grid.svg')] opacity-10 mix-blend-overlay"></div>
    <Container class="relative z-10">
      <div
        class="flex justify-between items-center text-[11px] md:text-xs font-bold uppercase tracking-widest"
      >
        <div class="hidden md:flex items-center gap-6">
          <a
            href={`tel:${BUSINESS_INFO.phone}`}
            class="flex items-center gap-2 hover:text-white/80 transition-colors"
          >
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
              <path
                d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"
              ></path>
            </svg>
            {BUSINESS_INFO.phone}
          </a>
          <a
            href={`mailto:${BUSINESS_INFO.email}`}
            class="flex items-center gap-2 hover:text-white/80 transition-colors"
          >
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"
              ></path>
              <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"></path>
            </svg>
            {BUSINESS_INFO.email}
          </a>
        </div>
        <div class="ml-auto flex items-center gap-4">
          <span class="flex items-center gap-2">
            <span
              class="w-2 h-2 rounded-full bg-green-400 animate-pulse shadow-[0_0_8px_rgba(74,222,128,0.5)]"
            ></span>
            {BUSINESS_HOURS.weekdays}
          </span>
        </div>
      </div>
    </Container>
  </div>

  <!-- Main Header -->
  <div class="bg-white border-b border-neutral-100 transition-all duration-300" id="header-inner">
    <Container>
      <div
        class="flex items-center justify-between h-16 md:h-20 transition-all duration-300"
        id="header-content"
      >
        <!-- Logo -->
        <a href="/" class="flex items-center group/logo">
          <Image
            src={logo}
            alt="AtoZ Business Services"
            class="h-10 md:h-14 w-auto transition-transform duration-500 group-hover/logo:scale-105"
          />
        </a>

        <!-- Desktop Navigation -->
        <Navigation categories={categories} groupedServices={groupedServices} />

        <!-- Mobile Menu Button -->
        <MobileMenu categories={categories} groupedServices={groupedServices} client:load />
      </div>
    </Container>
  </div>
</header>

<script>
  const headerInner = document.getElementById('header-inner');

  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      headerInner?.classList.add('shadow-md');
    } else {
      headerInner?.classList.remove('shadow-md');
    }
  });
</script>
