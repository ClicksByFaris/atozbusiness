---
import Container from '../ui/Container.astro';
import Navigation from './Navigation.astro';
import MobileMenu from './MobileMenu';
import { BUSINESS_INFO, BUSINESS_HOURS, LOCATIONS } from '../../lib/constants';
import logo from '../../assets/logo.png';
import { Image } from 'astro:assets';
import { getNavigationServices } from '../../lib/sanity';

const services = await getNavigationServices();

const groupedServices = services.reduce((acc: Record<string, any[]>, service: any) => {
  const cat = service.category || 'Other';
  if (!acc[cat]) acc[cat] = [];
  acc[cat].push(service);
  return acc;
}, {});

const categories = Object.keys(groupedServices).sort((a, b) => {
  const minOrderA = Math.min(...groupedServices[a].map((s: any) => s.order ?? 999));
  const minOrderB = Math.min(...groupedServices[b].map((s: any) => s.order ?? 999));
  return minOrderA - minOrderB;
});
---

<header class="sticky top-0 z-50" id="main-header">

  <!-- ── Top Announcement Bar ─────────────────────────────────────── -->
  <div class="bg-neutral-900 text-white">
    <Container>
      <div class="flex items-center justify-between h-9 text-[11px] font-medium">

        <!-- Left: Phone + Email + Hours -->
        <div class="hidden md:flex items-center gap-0 divide-x divide-white/10">

          <!-- Phone -->
          <a
            href={`tel:${BUSINESS_INFO.phone}`}
            class="flex items-center gap-1.5 pr-4 text-neutral-300 hover:text-white transition-colors"
          >
            <svg class="w-3 h-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
            </svg>
            {BUSINESS_INFO.phone}
          </a>

          <!-- Email -->
          <a
            href={`mailto:${BUSINESS_INFO.email}`}
            class="flex items-center gap-1.5 px-4 text-neutral-300 hover:text-white transition-colors"
          >
            <svg class="w-3 h-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"/>
              <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"/>
            </svg>
            {BUSINESS_INFO.email}
          </a>

          <!-- Hours -->
          <span class="flex items-center gap-1.5 px-4 text-neutral-300">
            <svg class="w-3 h-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/>
            </svg>
            {BUSINESS_HOURS.weekdays}
          </span>
        </div>

        <!-- Right: Location + Slogan -->
        <div class="flex items-center gap-0 ml-auto divide-x divide-white/10">

          <!-- Location -->
          <span class="hidden sm:flex items-center gap-1.5 pr-4 text-neutral-300">
            <svg class="w-3 h-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
            </svg>
            {LOCATIONS.main.area} &amp; {LOCATIONS.branch.area}, Abu Dhabi
          </span>

          <!-- Slogan -->
          <span class="pl-4 text-neutral-400 italic hidden lg:block">
            Your Business. Our Support. A Brighter Abu Dhabi.
          </span>

          <!-- Mobile: show hours only -->
          <span class="flex md:hidden items-center gap-1.5 text-neutral-300">
            <span class="w-1.5 h-1.5 rounded-full bg-green-400 animate-pulse"></span>
            Open Now
          </span>
        </div>

      </div>
    </Container>
  </div>

  <!-- ── Main Header ───────────────────────────────────────────────── -->
  <div class="bg-white border-b border-neutral-100 transition-shadow duration-300" id="header-inner">
    <Container>
      <div class="flex items-center justify-between h-16 md:h-20" id="header-content">

        <!-- Logo -->
        <a href="/" class="flex items-center flex-shrink-0 group/logo">
          <Image
            src={logo}
            alt="AtoZ Business Services"
            class="h-10 md:h-14 w-auto transition-transform duration-300 group-hover/logo:scale-105"
          />
        </a>

        <!-- Desktop Navigation (nav links + CTA buttons live inside Navigation) -->
        <Navigation categories={categories} groupedServices={groupedServices} />

        <!-- Mobile Menu -->
        <MobileMenu categories={categories} groupedServices={groupedServices} client:load />

      </div>
    </Container>
  </div>

</header>

<script>
  const headerInner = document.getElementById('header-inner');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      headerInner?.classList.add('shadow-md');
    } else {
      headerInner?.classList.remove('shadow-md');
    }
  });
</script>
