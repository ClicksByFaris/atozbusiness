---
/**
 * SEO Component - Advanced SEO features
 *
 * Designed to work with Sanity CMS data in the future
 * Currently uses hardcoded data from constants
 *
 * Usage:
 * <SEO
 *   keywords={['keyword1', 'keyword2']}
 *   schema={generateLocalBusinessSchema()}
 *   breadcrumbs={[{ name: 'Home', url: '/' }]}
 * />
 */

import { getKeywordsString } from '../lib/seo';

interface Props {
  // Optional keywords (rendered as meta keywords)
  keywords?: string[] | readonly string[];

  // Schema.org structured data (pass schema object or array)
  schema?: object | object[];

  // Breadcrumbs for navigation
  breadcrumbs?: Array<{ name: string; url: string }>;

  // Author (for blog posts)
  author?: string;

  // Publish date (for blog posts)
  publishDate?: string | Date;

  // Modified date (for blog posts)
  modifiedDate?: string | Date;

  // Additional meta tags
  additionalMeta?: Array<{ name: string; content: string }>;

  // Robots meta (noindex, nofollow, etc.)
  robots?: string;
}

const {
  keywords = [],
  schema,
  breadcrumbs,
  author,
  publishDate,
  modifiedDate,
  additionalMeta = [],
  robots,
} = Astro.props;

// Generate breadcrumb schema if breadcrumbs provided
const breadcrumbSchema = breadcrumbs
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbs.map((item, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: item.name,
        item: item.url,
      })),
    }
  : null;

// Combine all schemas
const allSchemas = [];
if (schema) {
  allSchemas.push(...(Array.isArray(schema) ? schema : [schema]));
}
if (breadcrumbSchema) {
  allSchemas.push(breadcrumbSchema);
}
---

<!-- Keywords (for traditional SEO) -->{
  keywords.length > 0 && <meta name="keywords" content={getKeywordsString(keywords)} />
}

<!-- Robots meta tag -->
{robots && <meta name="robots" content={robots} />}

<!-- Author (for articles/blog posts) -->
{author && <meta name="author" content={author} />}

<!-- Article dates (for blog posts) -->
{publishDate && <meta property="article:published_time" content={publishDate.toString()} />}
{modifiedDate && <meta property="article:modified_time" content={modifiedDate.toString()} />}

<!-- Additional custom meta tags -->
{additionalMeta.map((meta) => <meta name={meta.name} content={meta.content} />)}

<!-- Structured Data (Schema.org JSON-LD) -->
{
  allSchemas.length > 0 && (
    <script
      type="application/ld+json"
      set:html={JSON.stringify(allSchemas.length === 1 ? allSchemas[0] : allSchemas)}
    />
  )
}
