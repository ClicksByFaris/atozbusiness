---
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import { STATISTICS } from '../../lib/constants';
import Icon from '../icons/Icon';
---

<Section background="gradient" padding="lg">
  <Container>
    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-5">
      {/* Years in Business */}
      <div
        class="text-center reveal"
        data-animation="animate-fade-in-up"
        style={{ animationDelay: '0ms' }}
      >
        <div class="mb-3 flex items-center justify-center">
          <Icon name="Award" size={32} className="text-accent-400" client:idle />
        </div>
        <div class="mb-2 font-display text-4xl font-bold text-white md:text-5xl">
          {STATISTICS.yearsInBusiness}
        </div>
        <div class="text-white/90">Years in Business</div>
      </div>

      {/* Clients Served */}
      <div
        class="text-center reveal"
        data-animation="animate-fade-in-up"
        style={{ animationDelay: '100ms' }}
      >
        <div class="mb-3 flex items-center justify-center">
          <Icon name="Users" size={32} className="text-accent-400" client:idle />
        </div>
        <div class="mb-2 font-display text-4xl font-bold text-white md:text-5xl">
          {STATISTICS.clientsServed}
        </div>
        <div class="text-white/90">Clients Served</div>
      </div>

      {/* Success Rate */}
      <div
        class="text-center reveal"
        data-animation="animate-fade-in-up"
        style={{ animationDelay: '200ms' }}
      >
        <div class="mb-3 flex items-center justify-center">
          <Icon name="TrendingUp" size={32} className="text-accent-400" client:idle />
        </div>
        <div class="mb-2 font-display text-4xl font-bold text-white md:text-5xl">
          {STATISTICS.successRate}
        </div>
        <div class="text-white/90">Success Rate</div>
      </div>

      {/* Services Offered */}
      <div
        class="text-center reveal"
        data-animation="animate-fade-in-up"
        style={{ animationDelay: '300ms' }}
      >
        <div class="mb-3 flex items-center justify-center">
          <Icon name="Briefcase" size={32} className="text-accent-400" client:idle />
        </div>
        <div class="mb-2 font-display text-4xl font-bold text-white md:text-5xl">
          {STATISTICS.servicesOffered}
        </div>
        <div class="text-white/90">Services Offered</div>
      </div>

      {/* Office Locations */}
      <div
        class="text-center reveal"
        data-animation="animate-fade-in-up"
        style={{ animationDelay: '400ms' }}
      >
        <div class="mb-3 flex items-center justify-center">
          <Icon name="MapPin" size={32} className="text-accent-400" client:idle />
        </div>
        <div class="mb-2 font-display text-4xl font-bold text-white md:text-5xl">
          {STATISTICS.officeLocations}
        </div>
        <div class="text-white/90">Office Locations</div>
      </div>
    </div>
  </Container>
</Section>
