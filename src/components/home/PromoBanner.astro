---
import { urlFor } from '../../lib/sanity';

interface Props {
  landingPages: any[];
}

const { landingPages = [] } = Astro.props;

// Ensure we only show up to 3 pages
const slides = landingPages.slice(0, 3);
---

{
  slides.length > 0 && (
    <section class="w-full relative py-20 md:py-28 bg-gray-900 overflow-hidden reveal shadow-inner group/slider">
      {/* Background Images - We loop and set opacity based on active class */}
      <div id="promo-backgrounds" class="absolute inset-0 z-0 bg-gray-900">
        {slides.map((page: any, index: number) => (
          <div
            class={`absolute inset-0 transition-opacity duration-1000 ease-in-out ${index === 0 ? 'opacity-100' : 'opacity-0'}`}
            data-bg-index={index}
          >
            {page.heroImage?.asset && (
              <img
                src={urlFor(page.heroImage.asset).width(2400).quality(100).auto('format').url()}
                alt={page.heroImage.altText || page.mainHeadline}
                loading={index === 0 ? 'eager' : 'lazy'}
                decoding="async"
                class="w-full h-full object-cover"
              />
            )}
            {/* Subtle dark tint to ensure text is always readable */}
            <div class="absolute inset-0 bg-black/50" />
          </div>
        ))}
      </div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        {/* Slider Navigation Dots (Top right of card) */}
        {slides.length > 1 && (
          <div class="absolute top-4 right-8 sm:right-12 z-20 flex space-x-2">
            {slides.map((_, index: number) => (
              <button
                aria-label={`Go to slide ${index + 1}`}
                class={`w-3 h-3 rounded-full transition-all duration-300 ${index === 0 ? 'bg-primary-500 w-8' : 'bg-white/50 hover:bg-white/80'}`}
                data-dot-index={index}
              />
            ))}
          </div>
        )}

        {/* Slides Content */}
        <div id="promo-slides-content" class="relative max-w-3xl min-h-[300px]">
          {slides.map((page: any, index: number) => (
            <div
              class={`transition-all duration-700 ease-out transform ${index === 0 ? 'opacity-100 translate-y-0 relative z-10' : 'opacity-0 translate-y-8 absolute inset-0 z-0 pointer-events-none'}`}
              data-content-index={index}
            >
              <div class="bg-gray-900/75 backdrop-blur-lg p-8 md:p-12 rounded-3xl border border-white/10 shadow-[0_8px_30px_rgb(0,0,0,0.5)]">
                <h2 class="text-3xl md:text-5xl lg:text-5xl font-extrabold text-white mb-6 leading-tight drop-shadow-md">
                  {page.mainHeadline}
                </h2>

                {page.subHeadline && (
                  <p class="text-lg md:text-xl text-gray-200 mb-10 max-w-xl leading-relaxed">
                    {page.subHeadline}
                  </p>
                )}

                <div class="flex flex-col sm:flex-row gap-4 inline-block">
                  <a
                    href={`/lp/${page.slug.current}`}
                    class="group inline-flex items-center justify-center px-8 py-4 text-lg font-bold text-white bg-primary-600 rounded-xl shadow-lg hover:bg-primary-500 hover:shadow-primary-600/50 hover:-translate-y-1 transition-all duration-300 ring-2 ring-primary-500/50 focus:outline-none"
                    tabindex={index === 0 ? 0 : -1}
                  >
                    <span>{page.primaryCtaText || 'Learn More'}</span>
                    <svg
                      class="w-5 h-5 ml-3 group-hover:translate-x-2 transition-transform duration-300"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M17 8l4 4m0 0l-4 4m4-4H3"
                      />
                    </svg>
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}

<script>
  // Slider Logic isolated to run exactly once when astro loads or remounts
  function initSliders() {
    const backgrounds = document.querySelectorAll('[data-bg-index]');
    const contents = document.querySelectorAll('[data-content-index]');
    const dots = document.querySelectorAll('[data-dot-index]');

    if (backgrounds.length <= 1) return; // No need to slide if 0 or 1 item

    let currentIndex = 0;
    const totalSlides = backgrounds.length;
    let slideInterval: number | undefined;

    function goToSlide(index: number) {
      if (index === currentIndex || index < 0 || index >= totalSlides) return;

      // Update Backgrounds
      backgrounds[currentIndex].classList.remove('opacity-100');
      backgrounds[currentIndex].classList.add('opacity-0');
      backgrounds[index].classList.remove('opacity-0');
      backgrounds[index].classList.add('opacity-100');

      // Update Contents
      const oldContent = contents[currentIndex];
      const newContent = contents[index];

      oldContent.classList.remove('opacity-100', 'translate-y-0', 'relative', 'z-10');
      oldContent.classList.add(
        'opacity-0',
        'translate-y-8',
        'absolute',
        'inset-0',
        'z-0',
        'pointer-events-none'
      );
      const oldLink = oldContent.querySelector('a');
      if (oldLink) oldLink.setAttribute('tabindex', '-1');

      newContent.classList.remove(
        'opacity-0',
        'translate-y-8',
        'absolute',
        'inset-0',
        'z-0',
        'pointer-events-none'
      );
      newContent.classList.add('opacity-100', 'translate-y-0', 'relative', 'z-10');
      const newLink = newContent.querySelector('a');
      if (newLink) newLink.setAttribute('tabindex', '0');

      // Update Dots
      const oldDot = dots[currentIndex];
      const newDot = dots[index];

      oldDot.classList.remove('bg-primary-500', 'w-8');
      oldDot.classList.add('bg-white/50');
      newDot.classList.remove('bg-white/50');
      newDot.classList.add('bg-primary-500', 'w-8');

      currentIndex = index;
    }

    function nextSlide() {
      goToSlide((currentIndex + 1) % totalSlides);
    }

    function startSlider() {
      stopSlider();
      slideInterval = window.setInterval(nextSlide, 5000); // 5 seconds
    }

    function stopSlider() {
      if (slideInterval) clearInterval(slideInterval);
    }

    // Event listeners
    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => {
        goToSlide(index);
        startSlider(); // Reset timer on manual click
      });
    });

    const sliderSection = document.querySelector('.group\\/slider');
    if (sliderSection) {
      sliderSection.addEventListener('mouseenter', stopSlider);
      sliderSection.addEventListener('mouseleave', startSlider);
    }

    // Start auto-play
    startSlider();
  }

  // Run on first load
  initSliders();

  // Also run if Astro View Transitions re-renders the page
  document.addEventListener('astro:after-swap', initSliders);
</script>
