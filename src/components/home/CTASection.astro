---
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import { BUSINESS_INFO } from '../../lib/constants';
import Icon from '../icons/Icon';
---

<Section background="gradient" padding="lg">
  <Container>
    <div class="text-center">
      <div class="reveal" data-animation="animate-fade-in-up">
        <h2 class="mb-4 font-display text-3xl font-bold text-white md:text-4xl lg:text-5xl">
          Ready to Get Started?
        </h2>
        <p class="mb-8 text-xl text-white/90 md:text-2xl">
          Let us handle your documentation needs. Contact us today for fast, professional service.
        </p>
      </div>

      <div
        class="mb-8 flex flex-wrap items-center justify-center gap-4 reveal"
        data-animation="animate-fade-in-up"
        style={{ animationDelay: '150ms' }}
      >
        {/* WhatsApp CTA */}
        <a
          href={`https://wa.me/${BUSINESS_INFO.whatsapp.replace(/[^0-9]/g, '')}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-lg bg-accent-500 px-8 py-4 font-medium text-white shadow-lg transition-all duration-200 hover:bg-accent-600 hover:shadow-xl hover:scale-105"
        >
          <Icon name="MessageCircle" size={24} client:load />
          <span class="text-lg">WhatsApp Us Now</span>
        </a>

        {/* Call CTA */}
        <a
          href={`tel:${BUSINESS_INFO.phone}`}
          class="inline-flex items-center gap-2 rounded-lg border-2 border-white bg-white px-8 py-4 font-medium text-primary-600 shadow-lg transition-all duration-200 hover:bg-neutral-50 hover:shadow-xl hover:scale-105"
        >
          <Icon name="Phone" size={24} client:load />
          <span class="text-lg">Call {BUSINESS_INFO.phone}</span>
        </a>
      </div>

      {/* Additional Info */}
      <div
        class="flex flex-wrap items-center justify-center gap-6 text-white/90 reveal"
        data-animation="animate-fade-in-up"
        style={{ animationDelay: '300ms' }}
      >
        <div class="flex items-center gap-2">
          <Icon name="Clock" size={20} className="text-accent-400" client:load />
          <span>Open Mon-Sat: 8 AM - 9 PM</span>
        </div>
        <div class="flex items-center gap-2">
          <Icon name="MapPin" size={20} className="text-accent-400" client:load />
          <span>Khalidiya & Al Zahiyah</span>
        </div>
        <div class="flex items-center gap-2">
          <Icon name="Mail" size={20} className="text-accent-400" client:load />
          <a href={`mailto:${BUSINESS_INFO.email}`} class="hover:text-white transition-colors">
            {BUSINESS_INFO.email}
          </a>
        </div>
      </div>
    </div>
  </Container>
</Section>
