---
import { BUSINESS_INFO, BUSINESS_HOURS } from '../../lib/constants';
import Icon from '../icons/Icon';
import HeroSlider from './HeroSlider.astro';
import { getHomePageData } from '../../lib/sanity';

const homeData = await getHomePageData();
const heroImages = homeData?.hero?.images || [];
const headline = homeData?.hero?.heading || BUSINESS_INFO.name;
const tagline = homeData?.hero?.tagline || BUSINESS_INFO.tagline;
---

<section class="relative bg-primary-900 text-white py-20 lg:py-28 overflow-hidden">
  <!-- Dynamic Slider Background -->
  <HeroSlider images={heroImages} />

  <!-- Overlay Pattern (Optional, but adds texture over the images) -->
  <div class="absolute inset-0 bg-[url('/patterns/grid.svg')] opacity-10 z-0 pointer-events-none">
  </div>

  <div class="container relative z-10 mx-auto px-4 text-center">
    <!-- Badge -->
    <div
      class="mb-6 inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-2 text-sm font-medium text-white backdrop-blur-md border border-white/10 animate-fade-in-up"
    >
      <Icon name="Award" size={16} className="text-accent-400" client:idle />
      <span>Trusted by 15,000+ Clients Across UAE</span>
    </div>

    <!-- Main Heading -->
    <h1
      class="mb-6 font-display text-4xl md:text-5xl lg:text-7xl font-bold text-white tracking-tight animate-fade-in-up drop-shadow-lg [animation-delay:100ms]"
    >
      {headline}
    </h1>

    <!-- Tagline -->
    <p
      class="mb-8 mx-auto max-w-2xl text-xl md:text-2xl text-primary-100/90 leading-relaxed animate-fade-in-up drop-shadow-md [animation-delay:200ms]"
    >
      {tagline}
    </p>

    <!-- Location Indicator -->
    <div
      class="mb-10 flex items-center justify-center gap-2 text-primary-200 animate-fade-in-up drop-shadow-md [animation-delay:300ms]"
    >
      <Icon name="MapPin" size={20} className="text-accent-400" client:idle />
      <span class="text-lg">Khalidiya & Al Zahiyah, Abu Dhabi</span>
    </div>

    <!-- CTA Buttons -->
    <div
      class="flex flex-wrap items-center justify-center gap-4 animate-fade-in-up [animation-delay:400ms]"
    >
      <a
        href={`https://wa.me/${BUSINESS_INFO.whatsapp.replace(/[^0-9]/g, '')}`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-xl bg-accent-500 px-8 py-4 font-bold text-white shadow-lg shadow-accent-500/30 transition-all duration-300 hover:bg-accent-600 hover:scale-105 hover:shadow-xl"
      >
        <Icon name="MessageCircle" size={20} client:idle />
        WhatsApp Us
      </a>

      <a
        href={`tel:${BUSINESS_INFO.phone}`}
        class="inline-flex items-center gap-2 rounded-xl border border-white/20 bg-white/5 px-8 py-4 font-bold text-white backdrop-blur-sm transition-all duration-300 hover:bg-white/10 hover:border-white/40"
      >
        <Icon name="Phone" size={20} client:idle />
        Call Now
      </a>

      <a
        href="/services"
        class="inline-flex items-center gap-2 rounded-xl border border-transparent px-8 py-4 font-medium text-white/80 transition-all duration-300 hover:text-white"
      >
        View Services
        <Icon name="ArrowRight" size={20} client:idle />
      </a>
    </div>

    <!-- Quick Info Cards -->
    <div
      class="grid gap-6 md:grid-cols-3 max-w-4xl mx-auto mt-16 animate-fade-in-up [animation-delay:500ms]"
    >
      <!-- Business Hours -->
      <div
        class="rounded-2xl bg-white/5 p-6 backdrop-blur-md border border-white/10 hover:bg-white/10 transition-colors"
      >
        <div class="mb-3 flex items-center justify-center gap-2">
          <Icon name="Clock" size={24} className="text-accent-400" client:idle />
          <h3 class="font-bold text-lg text-white">Open Now</h3>
        </div>
        <p class="text-sm text-primary-200">{BUSINESS_HOURS.weekdays}</p>
      </div>

      <!-- Location -->
      <div
        class="rounded-2xl bg-white/5 p-6 backdrop-blur-md border border-white/10 hover:bg-white/10 transition-colors"
      >
        <div class="mb-3 flex items-center justify-center gap-2">
          <Icon name="MapPin" size={24} className="text-accent-400" client:idle />
          <h3 class="font-bold text-lg text-white">Prime Location</h3>
        </div>
        <p class="text-sm text-primary-200">Opposite Khalidiya Mall</p>
      </div>

      <!-- Support -->
      <div
        class="rounded-2xl bg-white/5 p-6 backdrop-blur-md border border-white/10 hover:bg-white/10 transition-colors"
      >
        <div class="mb-3 flex items-center justify-center gap-2">
          <Icon name="Headphones" size={24} className="text-accent-400" client:idle />
          <h3 class="font-bold text-lg text-white">24/7 Support</h3>
        </div>
        <p class="text-sm text-primary-200">Always here to help</p>
      </div>
    </div>
  </div>
  <div class="absolute -bottom-1 left-0 w-full overflow-hidden leading-none rotate-180 z-10">
    <svg
      data-name="Layer 1"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 1200 120"
      preserveAspectRatio="none"
      class="relative block w-[calc(100%+1.3px)] h-[60px] text-neutral-50 fill-current"
    >
      <path
        d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V0H0V27.35A600.21,600.21,0,0,0,321.39,56.44Z"
      ></path>
    </svg>
  </div>
</section>
