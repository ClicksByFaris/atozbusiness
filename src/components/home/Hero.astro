---
import { BUSINESS_INFO, STATISTICS } from "../../lib/constants";
import Icon from "../icons/Icon";
import HeroSlider from "./HeroSlider.astro";
import { getHomePageData } from "../../lib/sanity";

const homeData = await getHomePageData();
const heroImages = homeData?.hero?.images || [];
const headline =
  homeData?.hero?.heading || "Business Setup, PRO & Typing Services";
const tagline =
  homeData?.hero?.tagline ||
  "Get professional help with business setup, residency, document clearing, visa and typing services from a trusted local team in Abu Dhabi.";
---

<section class="relative bg-white overflow-x-hidden">
  <!-- ── Main Two-Column Grid ──────────────────────────────────────────── -->
  <div class="grid grid-cols-1 lg:grid-cols-2 min-h-[580px]">
    <!-- LEFT: Content Column -->
    <div
      class="relative z-10 flex flex-col justify-center gap-6 px-6 sm:px-10 lg:px-14 xl:px-20 py-16 lg:py-24"
    >
      <!-- Subtle background for left side only -->
      <div
        class="absolute inset-0 bg-gradient-to-br from-primary-50/50 via-white to-white pointer-events-none"
      >
      </div>

      <!-- Badge -->
      <div
        class="relative inline-flex self-start items-center gap-2 rounded-full bg-primary-50 border border-primary-100 px-4 py-2"
      >
        <Icon name="Users" size={15} className="text-primary-600" client:idle />
        <span class="text-sm font-semibold text-primary-700"
          >Trusted by businesses across Abu Dhabi</span
        >
      </div>

      <!-- Headline -->
      <h1
        class="relative font-display text-4xl sm:text-5xl xl:text-6xl font-bold text-neutral-900 leading-tight tracking-tight"
      >
        {headline.replace(" in Abu Dhabi", "")}
        {
          headline.includes("in Abu Dhabi") && (
            <span class="text-accent-500"> in Abu Dhabi</span>
          )
        }
      </h1>

      <!-- Tagline -->
      <p
        class="relative text-base sm:text-lg text-neutral-600 leading-relaxed max-w-lg"
      >
        {tagline}
      </p>

      <!-- CTA Buttons -->
      <div class="relative flex flex-wrap gap-3 items-center">
        <a
          href={`https://wa.me/${BUSINESS_INFO.whatsapp.replace(/[^0-9]/g, "")}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-xl bg-accent-500 px-6 py-3.5 font-bold text-white shadow-lg shadow-accent-500/25 transition-all duration-300 hover:bg-accent-600 hover:scale-105"
        >
          <Icon name="MessageCircle" size={20} client:idle />
          WhatsApp Us
        </a>
        <a
          href={`tel:${BUSINESS_INFO.phone}`}
          class="inline-flex items-center gap-2 rounded-xl border-2 border-neutral-200 bg-white px-6 py-3.5 font-bold text-neutral-700 transition-all duration-300 hover:border-primary-300 hover:bg-primary-50"
        >
          <Icon name="Phone" size={20} client:idle />
          Call Now
        </a>
        <a
          href="/services"
          class="inline-flex items-center gap-1.5 px-4 py-3.5 font-medium text-neutral-500 transition-all duration-200 hover:text-primary-600"
        >
          View Services
          <Icon name="ArrowRight" size={18} client:idle />
        </a>
      </div>

      <!-- Trust Bar: Google Rating + Clients -->
      <div class="relative flex flex-wrap items-center gap-5 pt-1">
        <!-- Google Rating -->
        <div class="flex items-center gap-2.5">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            class="w-6 h-6 flex-shrink-0"
          >
            <path
              fill="#4285F4"
              d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
            ></path>
            <path
              fill="#34A853"
              d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
            ></path>
            <path
              fill="#FBBC05"
              d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"
            ></path>
            <path
              fill="#EA4335"
              d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
            ></path>
          </svg>
          <div>
            <div class="flex items-center gap-0.5">
              {
                [1, 2, 3, 4, 5].map(() => (
                  <svg
                    class="w-3.5 h-3.5 text-accent-400 fill-current"
                    viewBox="0 0 20 20"
                  >
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                ))
              }
            </div>
            <span class="text-xs font-semibold text-neutral-700"
              >4.9 Google Rating</span
            >
          </div>
        </div>

        <div class="w-px h-8 bg-neutral-200"></div>

        <!-- Happy Clients -->
        <div class="flex items-center gap-2">
          <div
            class="w-9 h-9 rounded-full bg-primary-100 flex items-center justify-center"
          >
            <Icon
              name="Users"
              size={18}
              className="text-primary-600"
              client:idle
            />
          </div>
          <div>
            <p class="text-sm font-bold text-neutral-900">
              {STATISTICS.clientsServed}
            </p>
            <p class="text-xs text-neutral-500">Happy Clients</p>
          </div>
        </div>
      </div>
    </div>

    <!-- RIGHT: Full-bleed image slider with seamless edge blend -->
    <div class="relative min-h-[340px] lg:min-h-0">
      <!-- Slider with CSS mask for perfect edge blending -->
      <div class="absolute inset-0 hero-slider-masked">
        <HeroSlider images={heroImages} mode="card" />
      </div>

      <!-- Subtle bottom vignette for depth -->
      <div
        class="absolute inset-x-0 bottom-0 h-20 bg-gradient-to-t from-white/10 to-transparent z-40 pointer-events-none"
      >
      </div>
    </div>
  </div>

  <!-- ── Bottom Info Cards ──────────────────────────────────────────────── -->
  <!-- Sits below the grid, above the wave -->
  <div
    class="relative z-20 container mx-auto px-6 sm:px-10 lg:px-14 xl:px-20 pb-16 pt-6"
  >
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <!-- Business Hours -->
      <a
        href="/contact"
        class="group flex items-center gap-4 bg-white rounded-2xl border border-neutral-200 px-5 py-4 shadow-soft hover:shadow-md hover:border-primary-200 transition-all duration-300"
      >
        <div
          class="w-12 h-12 rounded-xl bg-accent-50 flex items-center justify-center flex-shrink-0 group-hover:bg-accent-100 transition-colors"
        >
          <Icon
            name="Clock"
            size={22}
            className="text-accent-600"
            client:idle
          />
        </div>
        <div class="min-w-0 flex-1">
          <p class="font-bold text-neutral-900 text-sm">
            Open Monday – Saturday
          </p>
          <p class="text-xs text-neutral-500 mt-0.5">8:00 AM – 9:00 PM</p>
        </div>
        <Icon
          name="ChevronRight"
          size={16}
          className="text-neutral-300 group-hover:text-primary-500 transition-colors flex-shrink-0"
          client:idle
        />
      </a>

      <!-- 2 Locations -->
      <a
        href="/locations"
        class="group flex items-center gap-4 bg-white rounded-2xl border border-neutral-200 px-5 py-4 shadow-soft hover:shadow-md hover:border-primary-200 transition-all duration-300"
      >
        <div
          class="w-12 h-12 rounded-xl bg-primary-50 flex items-center justify-center flex-shrink-0 group-hover:bg-primary-100 transition-colors"
        >
          <Icon
            name="MapPin"
            size={22}
            className="text-primary-600"
            client:idle
          />
        </div>
        <div class="min-w-0 flex-1">
          <p class="font-bold text-neutral-900 text-sm">
            2 Abu Dhabi Locations
          </p>
          <p class="text-xs text-neutral-500 mt-0.5">
            Khalidiya &amp; Al Zahiyah
          </p>
        </div>
        <Icon
          name="ChevronRight"
          size={16}
          className="text-neutral-300 group-hover:text-primary-500 transition-colors flex-shrink-0"
          client:idle
        />
      </a>

      <!-- Fast Response -->
      <a
        href={`https://wa.me/${BUSINESS_INFO.whatsapp.replace(/[^0-9]/g, "")}`}
        target="_blank"
        rel="noopener noreferrer"
        class="group flex items-center gap-4 bg-white rounded-2xl border border-neutral-200 px-5 py-4 shadow-soft hover:shadow-md hover:border-primary-200 transition-all duration-300"
      >
        <div
          class="w-12 h-12 rounded-xl bg-secondary-50 flex items-center justify-center flex-shrink-0 group-hover:bg-secondary-100 transition-colors"
        >
          <Icon
            name="Zap"
            size={22}
            className="text-secondary-600"
            client:idle
          />
        </div>
        <div class="min-w-0 flex-1">
          <p class="font-bold text-neutral-900 text-sm">Fast Response</p>
          <p class="text-xs text-neutral-500 mt-0.5">
            Quick support via WhatsApp, call or email
          </p>
        </div>
        <Icon
          name="ChevronRight"
          size={16}
          className="text-neutral-300 group-hover:text-primary-500 transition-colors flex-shrink-0"
          client:idle
        />
      </a>
    </div>
  </div>

  <!-- Wave divider (sits after cards, z-10 is below cards z-20) -->
  <div
    class="absolute -bottom-1 left-0 w-full overflow-hidden leading-none rotate-180 z-10 pointer-events-none"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 1200 120"
      preserveAspectRatio="none"
      class="relative block w-[calc(100%+1.3px)] h-[60px] text-neutral-50 fill-current"
    >
      <path
        d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V0H0V27.35A600.21,600.21,0,0,0,321.39,56.44Z"
      ></path>
    </svg>
  </div>
</section>
