---
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import Heading from '../ui/Heading.astro';
import Card from '../ui/Card.astro';
import Button from '../ui/Button.astro';
import Icon from '../icons/Icon';
import SanityImage from '../ui/SanityImage.astro';
import { sanityClient } from '../../lib/sanity';
import { popularServicesQuery } from '../../lib/queries';
import type { Service } from '../../types';

const services: Service[] = await sanityClient.fetch(popularServicesQuery);
---

<Section background="white" padding="lg">
  <Container>
    <!-- Header Section -->
    <div class="text-center mb-16 reveal" data-animation="animate-fade-in-up">
      <div class="inline-block mb-4">
        <span
          class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary-50 text-primary-700 text-sm font-semibold tracking-wide"
        >
          <Icon name="Sparkles" size={16} client:idle />
          <span>Our Expertise</span>
        </span>
      </div>
      <Heading as="h2" class="mb-6 text-neutral-900">Featured Services</Heading>
      <p class="text-lg text-neutral-600 max-w-2xl mx-auto leading-relaxed">
        From visa services to company formation, we offer comprehensive solutions for all your
        government documentation needs in Abu Dhabi.
      </p>
    </div>

    <!-- Services Grid -->
    <div class="services-grid mb-16">
      {
        services.map((service, index) => (
          <article
            class="service-card reveal"
            data-animation="animate-fade-in-up"
            style={{
              animationDelay: `${index * 100}ms`,
            }}
            aria-labelledby={`service-${service.slug.current}`}
          >
            <Card variant="hover" padding="none" class="h-full service-card-inner group">
              {/* Featured Image */}
              {service.featuredImage && (
                <div class="relative h-56 overflow-hidden">
                  <SanityImage
                    node={service.featuredImage}
                    width={600}
                    class="w-full h-full object-cover transition-all duration-700 group-hover:scale-110"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-neutral-900/80 via-neutral-900/20 to-transparent" />

                  {/* Service Number Badge */}
                  <div class="absolute top-4 right-4 flex items-center justify-center w-12 h-12 rounded-full bg-white/95 backdrop-blur-sm shadow-lg">
                    <span class="font-mono text-sm font-bold text-primary-600">0{index + 1}</span>
                  </div>
                </div>
              )}

              {/* Card Content */}
              <div class="p-6 sm:p-8">
                {/* Service Title */}
                <h3
                  id={`service-${service.slug.current}`}
                  class="font-display text-2xl sm:text-3xl font-bold text-neutral-900 mb-4 leading-tight group-hover:text-primary-600 transition-colors duration-300"
                >
                  {service.title}
                </h3>

                {/* Description */}
                <p class="hidden md:block text-base text-neutral-600 leading-relaxed mb-6 md:line-clamp-3">
                  {service.excerpt}
                </p>

                {/* Learn More Link */}
                <a
                  href={`/services/${service.slug.current}`}
                  class="inline-flex items-center gap-2 text-sm font-bold text-primary-600 transition-all duration-300 hover:text-primary-700 hover:gap-3 uppercase tracking-wider group/link"
                >
                  <span>Learn More About {service.title}</span>
                  <Icon
                    name="ArrowRight"
                    size={16}
                    className="transition-transform duration-300 group-hover/link:translate-x-1"
                    client:idle
                  />
                </a>
              </div>
            </Card>
          </article>
        ))
      }
    </div>

    {/* View All Services CTA */}
    <div class="text-center reveal" data-animation="animate-fade-in-up">
      <Button variant="primary" size="lg" href="/services"> View All Services </Button>
    </div>
  </Container>
</Section>

<style>
  /* Services Grid - Responsive Layout */
  .services-grid {
    display: grid;
    gap: 2rem;
    grid-template-columns: 1fr;
  }

  /* Tablet: 2 columns */
  @media (min-width: 768px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2.5rem;
    }
  }

  /* Desktop: 3 columns */
  @media (min-width: 1024px) {
    .services-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }
  }

  /* Large Desktop: Better spacing */
  @media (min-width: 1280px) {
    .services-grid {
      gap: 2.5rem;
    }
  }

  /* Service Card Styling */
  .service-card {
    opacity: 0;
    transform: translateY(30px);
    transition: all 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .service-card.reveal[data-animation='animate-fade-in-up'] {
    animation: fadeInUp 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }

  .service-card-inner {
    border: 1px solid hsl(0 0% 90% / 0.6);
    background: linear-gradient(to bottom, white, hsl(0 0% 98%));
    transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    overflow: hidden;
  }

  .service-card-inner:hover {
    border-color: hsl(var(--primary-600) / 0.3);
    box-shadow:
      0 20px 40px -12px hsl(var(--primary-600) / 0.15),
      0 4px 12px -4px hsl(0 0% 0% / 0.1);
    transform: translateY(-8px);
  }

  /* Line Clamp Utility */
  /* Line Clamp Utility - only applies when visible */
  .line-clamp-3:not(.hidden) {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* For large screens and above */
  @media (min-width: 1024px) {
    .lg\:line-clamp-3 {
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
  }

  /* Fade In Up Animation */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Ensure smooth hardware acceleration */
  .service-card-inner,
  .service-card img {
    will-change: transform;
    backface-visibility: hidden;
    -webkit-font-smoothing: subpixel-antialiased;
  }

  /* Responsive Typography */
  @media (max-width: 640px) {
    .service-card-inner h3 {
      font-size: 1.5rem;
    }
  }
</style>
