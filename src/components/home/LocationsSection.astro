---
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import Heading from '../ui/Heading.astro';
import Button from '../ui/Button.astro';
import LocationCard from '../location/LocationCard.astro';
import { sanityClient } from '../../lib/sanity';
import { locationsQuery } from '../../lib/queries';
import type { Location } from '../../types';

const locations: Location[] = await sanityClient.fetch(locationsQuery);
// Show only first 2 locations on homepage to match design intent, or grid them if more.
const displayedLocations = locations.slice(0, 2);
---

<Section background="white" padding="lg">
  <Container>
    <div class="text-center mb-12 reveal" data-animation="animate-fade-in-up">
      <Heading as="h2" class="mb-4 text-neutral-900"> Visit Our Offices </Heading>
      <p class="text-lg text-neutral-600 max-w-2xl mx-auto">
        Conveniently located across Abu Dhabi to serve you better. Visit us at either of our
        branches for fast and professional service.
      </p>
    </div>

    {
      locations.length > 0 ? (
        <div class="grid gap-8 md:grid-cols-2 mb-12">
          {displayedLocations.map((location, index) => (
            <div
              class="reveal h-full"
              data-animation="animate-fade-in-up"
              style={{ animationDelay: `${index * 200}ms` }}
            >
              <LocationCard location={location} />
            </div>
          ))}
        </div>
      ) : (
        <div class="text-center py-12 bg-neutral-50 rounded-2xl mb-12">
          <p class="text-neutral-500">Loading locations...</p>
        </div>
      )
    }

    {/* View All Locations CTA */}
    <div
      class="text-center reveal"
      data-animation="animate-fade-in-up"
      style="animation-delay: 400ms"
    >
      <Button variant="outline" size="lg" href="/locations"> View All Locations </Button>
    </div>
  </Container>
</Section>
