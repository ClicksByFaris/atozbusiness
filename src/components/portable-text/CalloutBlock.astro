---
const { node } = Astro.props;
const { title, text, type = 'info' } = node;

const colors = {
  info: {
    bg: 'bg-blue-50',
    border: 'border-blue-200',
    text: 'text-blue-900',
    icon: 'text-blue-500',
  },
  warning: {
    bg: 'bg-amber-50',
    border: 'border-amber-200',
    text: 'text-amber-900',
    icon: 'text-amber-500',
  },
  error: { bg: 'bg-red-50', border: 'border-red-200', text: 'text-red-900', icon: 'text-red-500' },
  success: {
    bg: 'bg-green-50',
    border: 'border-green-200',
    text: 'text-green-900',
    icon: 'text-green-500',
  },
};

const style = colors[type as keyof typeof colors] || colors.info;
---

<div class={`my-8 p-6 rounded-2xl border ${style.bg} ${style.border}`}>
  {title && <h5 class={`font-bold text-lg mb-2 ${style.text}`}>{title}</h5>}
  <div class={`prose-sm ${style.text}`}>
    {text}
  </div>
</div>
