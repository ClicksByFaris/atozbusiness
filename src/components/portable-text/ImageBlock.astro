---
import SanityImage from '../ui/SanityImage.astro';

const { node } = Astro.props;
---

<figure class="my-8 group relative">
  <div
    class="overflow-hidden rounded-2xl shadow-md border border-neutral-100 transition-all duration-300 group-hover:shadow-lg"
  >
    <SanityImage node={node} width={1200} className="w-full h-auto object-cover" />
  </div>
  {
    node.caption && (
      <figcaption class="mt-3 text-center text-sm text-neutral-500 italic">
        {node.caption}
      </figcaption>
    )
  }
</figure>
