---
/**
 * GoogleTagManager.astro
 *
 * Loads GTM via the standard Google async snippet — runs on the main thread
 * but is fully non-blocking (async + deferred execution).
 *
 * Requirements:
 *  - PUBLIC_GTM_ID set in .env (must start with "GTM-")
 */

const rawId = import.meta.env.PUBLIC_GTM_ID;

// Strict validation: must be a non-empty string starting with GTM-
const gtmId: string | null =
  typeof rawId === 'string' && rawId.trim().startsWith('GTM-') && rawId.trim().length > 4
    ? rawId.trim()
    : null;

// Known placeholder — not a real container ID
const isPlaceholder = rawId === 'GTM-XXXXXXX' || rawId === undefined || rawId === '';

if (import.meta.env.DEV) {
  if (gtmId === null || isPlaceholder) {
    console.log('\x1b[33m%s\x1b[0m', '⚠  [GoogleTagManager] Invalid or missing PUBLIC_GTM_ID — GTM will not load.');
    console.log('\x1b[33m%s\x1b[0m', '   → Set a real GTM container ID in your .env file:');
    console.log('\x1b[33m%s\x1b[0m', '     PUBLIC_GTM_ID=GTM-XXXXXXX');
  } else {
    console.log('\x1b[32m%s\x1b[0m', `✔  [GoogleTagManager] GTM loaded with ID: ${gtmId}`);
  }
}
---

{gtmId !== null ? (
  <>
    {/* Standard GTM snippet — async, non-blocking, runs on main thread */}
    <script is:inline define:vars={{ gtmId }}>
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
      (function (w, d, s, l, i) {
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s);
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + '&l=' + l;
        f.parentNode.insertBefore(j, f);
      })(window, document, 'script', 'dataLayer', gtmId);
    </script>

    {/* Fallback for browsers with JavaScript disabled */}
    <noscript>
      <iframe
        src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
        height="0"
        width="0"
        style="display:none;visibility:hidden"
      />
    </noscript>
  </>
) : null}
