---
interface Props {
    maxWidth?: "sm" | "md" | "lg" | "xl" | "2xl" | "7xl" | "full";
    padding?: boolean;
    class?: string;
}

const { maxWidth = "7xl", padding = true, class: className = "" } = Astro.props;

const maxWidthClasses = {
    sm: "max-w-screen-sm",
    md: "max-w-screen-md",
    lg: "max-w-screen-lg",
    xl: "max-w-screen-xl",
    "2xl": "max-w-screen-2xl",
    "7xl": "max-w-7xl",
    full: "max-w-full",
};

const paddingClass = padding ? "px-4 sm:px-6 lg:px-8" : "";

const classes = `${maxWidthClasses[maxWidth]} mx-auto ${paddingClass} ${className}`;
---

<div class={classes}>
    <slot />
</div>
