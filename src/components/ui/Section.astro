---
interface Props {
  background?: 'white' | 'light' | 'gray' | 'gradient' | 'transparent';
  padding?: 'sm' | 'md' | 'lg';
  class?: string;
  id?: string;
  [key: string]: any;
}

const { background = 'white', padding = 'sm', class: className = '', id, ...rest } = Astro.props;

const backgroundClasses = {
  white: 'bg-white',
  light: 'bg-neutral-50',
  gray: 'bg-neutral-100',
  gradient: 'bg-gradient-to-br from-primary-500 to-secondary-500',
  transparent: 'bg-transparent',
};

const paddingClasses = {
  sm: 'py-6 md:py-12',
  md: 'py-16 md:py-24',
  lg: 'py-20 md:py-32',
};

const classes = `${backgroundClasses[background]} ${paddingClasses[padding]} ${className}`;
---

<section id={id} class={classes} {...rest}>
  <slot />
</section>
