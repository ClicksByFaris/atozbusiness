---
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import { MapPin, Navigation, Clock, Phone } from 'lucide-react';
import { LOCATIONS, BUSINESS_HOURS, BUSINESS_INFO } from '../../lib/constants';

interface Props {
  title?: string;
  subtitle?: string;
}

const { 
  title = "Visit Our Typing Centers", 
  subtitle = "Conveniently located in Abu Dhabi to serve you better"
} = Astro.props;

const locations = [
  {
    ...LOCATIONS.main,
    mapLink: "https://maps.google.com/?q=Khalidiya+Mall+Abu+Dhabi",
    timing: BUSINESS_HOURS.weekdays,
    phone: BUSINESS_INFO.phone // Fall back to main business phone
  },
  {
    ...LOCATIONS.branch,
    mapLink: "https://maps.google.com/?q=Al+Zahiyah+Abu+Dhabi",
    timing: BUSINESS_HOURS.weekdays,
    phone: LOCATIONS.branch.phone
  }
];
---

<Section background="white" class="py-12 sm:py-16">
  <Container>
    <div class="text-center max-w-3xl mx-auto mb-12">
      <h2 class="text-3xl sm:text-4xl font-display font-bold text-slate-900 mb-4 animate-fade-in-up">
        {title}
      </h2>
      <p class="text-lg text-slate-600 animate-fade-in-up animation-delay-100">
        {subtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
      {locations.map((loc, index) => (
        <div 
          class="bg-white rounded-2xl border border-slate-100 shadow-xl shadow-slate-200/50 overflow-hidden hover:shadow-2xl hover:scale-[1.02] transition-all duration-300 group animate-fade-in-up"
          style={`animation-delay: ${200 + index * 100}ms;`}
        >
          <!-- Map Preview / Visual Header -->
          <div class="bg-slate-100 h-32 relative overflow-hidden flex items-center justify-center">
             <div class="absolute inset-0 bg-gradient-to-br from-blue-50 to-slate-100 opacity-50"></div>
             <!-- Decorative Pattern -->
             <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#3b82f6_1px,transparent_1px)] [background-size:16px_16px]"></div>
             
             <div class="relative z-10 w-16 h-16 bg-white rounded-full shadow-md flex items-center justify-center text-blue-600 group-hover:scale-110 transition-transform duration-300">
                <MapPin className="w-8 h-8" />
             </div>
          </div>

          <div class="p-6 sm:p-8">
            <h3 class="text-xl font-bold text-slate-900 mb-2">{loc.name}</h3>
            <p class="text-slate-500 mb-6 text-sm">{loc.shortDescription}</p>

            <div class="space-y-4 mb-8">
              <div class="flex items-start gap-3">
                <MapPin className="w-5 h-5 text-blue-600 shrink-0 mt-0.5" />
                <span class="text-slate-700 font-medium">{loc.address}</span>
              </div>
              
              <div class="flex items-start gap-3">
                <Clock className="w-5 h-5 text-blue-600 shrink-0 mt-0.5" />
                <span class="text-slate-700">{loc.timing}</span>
              </div>

               <div class="flex items-start gap-3">
                <Phone className="w-5 h-5 text-blue-600 shrink-0 mt-0.5" />
                <a href={`tel:${(loc.phone || BUSINESS_INFO.phone).replace(/[^0-9+]/g, '')}`} class="text-slate-700 hover:text-blue-600 transition-colors">
                  {loc.phone || BUSINESS_INFO.phone}
                </a>
              </div>
            </div>

            <a 
              href={loc.mapLink}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-center gap-2 w-full py-3 px-4 bg-slate-50 hover:bg-blue-50 text-slate-700 hover:text-blue-700 font-bold rounded-xl border border-slate-200 hover:border-blue-200 transition-all duration-200"
            >
              <Navigation className="w-4 h-4" />
              Get Directions
            </a>   
          </div>
        </div>
      ))}
    </div>
  </Container>
</Section>
