---
import { Phone } from 'lucide-react';

interface Props {
  phoneNumber: string;
  showOnMobile?: boolean; // Option to hide on mobile if sticky footer is enough
}

const { phoneNumber, showOnMobile = true } = Astro.props;
const cleanNumber = phoneNumber.replace(/[^0-9+]/g, '');
const telLink = `tel:${cleanNumber}`;
---

<div
  class:list={[
    'fixed right-4 bottom-24 sm:bottom-28 z-40 animate-fade-in-up',
    { 'hidden sm:block': !showOnMobile },
  ]}
  style="animation-delay: 500ms;"
>
  <a
    href={telLink}
    class="group flex items-center justify-center gap-2 pl-4 pr-3 py-2.5 bg-gradient-to-br from-blue-600 to-blue-700 text-white rounded-full shadow-lg hover:shadow-xl hover:scale-105 active:scale-95 transition-all duration-300 relative overflow-hidden animate-bounce-gentle"
    aria-label="Call Now"
  >
    <!-- Ripple effect overlay -->
    <div class="absolute inset-0 bg-white/20 opacity-0 group-hover:opacity-100 transition-opacity">
    </div>

    <span class="text-xs sm:text-sm font-bold whitespace-nowrap">Speak to Expert</span>

    <div class="bg-white/20 rounded-full p-1.5">
      <Phone className="w-4 h-4 sm:w-5 sm:h-5 fill-current relative z-10" />
    </div>

    <!-- Pulse ring -->
    <span class="absolute inset-0 rounded-full border border-blue-400 opacity-50 animate-ping"
    ></span>
  </a>
</div>

<style>
  @keyframes bounce-gentle {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-5px);
    }
  }
  .animate-bounce-gentle {
    animation: bounce-gentle 2s infinite;
  }
</style>
