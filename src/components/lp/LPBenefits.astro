---
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';

interface Benefit {
  emoji: string;
  text: string;
}

interface Props {
  benefits: Benefit[];
}

const { benefits } = Astro.props;
---

<Section background="white">
  <Container maxWidth="full" class="max-w-3xl mx-0">
    <div class="flex flex-col gap-3 sm:gap-4 max-w-lg">
      {
        benefits.map((benefit, index) => (
          <div
            class="flex items-start gap-3 sm:gap-4 reveal"
            data-animation="animate-slide-up"
            style={`animation-delay: ${index * 100}ms;`}
          >
            <svg
              class="w-6 h-6 sm:w-7 sm:h-7 flex-shrink-0 text-green-600"
              viewBox="0 0 24 24"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <rect width="24" height="24" rx="5" fill="currentColor" />
              <path
                d="M7 12.5L10.5 16L17.5 9"
                stroke="white"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
            <span class="text-lg sm:text-xl text-neutral-800 font-medium leading-tight">
              {benefit.text}
            </span>
          </div>
        ))
      }
    </div>
  </Container>
</Section>
