---
import { ExternalLink } from 'lucide-react';
import SanityImage from '../ui/SanityImage.astro';
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';

interface Testimonial {
  customerName: string;
  rating: number;
  testimonial: string;
  customerPhoto?: any;
}

interface Props {
  testimonials: Testimonial[];
}

const { testimonials } = Astro.props;
const displayedTestimonials = testimonials?.slice(0, 3) || [];
---

<!-- Testimonials Section - Compact Cards -->
<Section class="!py-5 !sm:py-7" background="white" padding="sm">
  <Container maxWidth="full" padding={false} class="max-w-lg mx-auto px-3">
    <h3
      class="text-lg sm:text-xl font-display font-bold text-center text-neutral-900 mb-4 sm:mb-5 reveal"
    >
      What Customers Say
    </h3>

    <div class="space-y-3">
      {
        displayedTestimonials.map((testimonial, index) => (
          <div
            class="bg-white rounded-xl p-4 shadow-sm border border-neutral-100 reveal"
            data-animation="animate-fade-in-up"
            style={`animation-delay: ${index * 100}ms;`}
          >
            <div class="flex items-center gap-2.5 mb-2.5">
              <div class="w-9 h-9 rounded-full bg-gradient-to-br from-primary-500 to-secondary-500 flex items-center justify-center text-white font-bold text-sm flex-shrink-0 overflow-hidden">
                {testimonial.customerPhoto ? (
                  <SanityImage
                    node={testimonial.customerPhoto}
                    width={100}
                    height={100}
                    alt={testimonial.customerName}
                    class="w-full h-full object-cover"
                  />
                ) : (
                  testimonial.customerName.charAt(0)
                )}
              </div>
              <div class="flex-1 min-w-0">
                <p class="font-semibold text-neutral-900 text-sm truncate">
                  {testimonial.customerName}
                </p>
                <div class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <svg
                      class={`w-3 h-3 ${i < testimonial.rating ? 'text-accent-500' : 'text-neutral-300'}`}
                      fill="currentColor"
                      viewBox="0 0 20 20"
                    >
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                    </svg>
                  ))}
                </div>
              </div>
            </div>
            <p class="text-xs sm:text-sm text-neutral-700 leading-relaxed">
              "{testimonial.testimonial}"
            </p>
          </div>
        ))
      }
    </div>

    <!-- See more link -->
    <div
      class="mt-5 text-center reveal"
      data-animation="animate-fade-in"
      style="animation-delay: 400ms;"
    >
      <a
        href="https://share.google/66ShmVhCLq5EyetEm"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 text-sm font-medium text-primary-600 hover:text-primary-700 hover:underline decoration-2 underline-offset-2 transition-all"
      >
        See more reviews
        <ExternalLink className="w-3.5 h-3.5" />
      </a>
    </div>
  </Container>
</Section>
