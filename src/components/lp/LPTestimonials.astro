---
import { sanityClient } from '../../lib/sanity';
import { ExternalLink, Star } from 'lucide-react';
import SanityImage from '../ui/SanityImage.astro';
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';

interface Testimonial {
  customerName: string;
  rating: number;
  testimonial: string;
  customerPhoto?: any;
}

interface Props {
  testimonials?: Testimonial[];
}

let { testimonials } = Astro.props;

// Fetch testimonials IF NOT provided
if (!testimonials || testimonials.length === 0) {
    const socialProofData = await sanityClient.fetch<{ testimonials: Testimonial[] } | null>(`*[_type == "socialProof"][0] {
        testimonials[] {
        customerName,
        customerPhoto,
        rating,
        testimonial
        }
    }`);

    testimonials = socialProofData?.testimonials || [];
}

const displayedTestimonials = testimonials.slice(0, 3);

// Helper for initials
const getInitials = (name: string) => {
  return name.split(' ').map(n => n[0]).join('').toUpperCase().substring(0, 2);
};

// Colors for the fallback squares
const bgColors = ['bg-blue-100', 'bg-amber-100', 'bg-slate-100'];
const textColors = ['text-blue-600', 'text-amber-600', 'text-slate-600'];
---

<Section class="!py-16 bg-[#F8F9FA]" background="light">
  <Container>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {displayedTestimonials.map((testimonial, index) => (
        <div class="bg-white rounded-2xl p-8 shadow-sm border border-neutral-100 flex flex-col h-full reveal" style={`animation-delay: ${index * 150}ms;`}>
          
          <!-- Top Row: Avatar and Name -->
          <div class="flex items-center gap-4 mb-6">
            <div class={`w-14 h-14 rounded-xl ${bgColors[index % 3]} flex items-center justify-center flex-shrink-0 overflow-hidden`}>
              {testimonial.customerPhoto ? (
                <SanityImage
                  node={testimonial.customerPhoto}
                  width={100}
                  height={100}
                  alt={testimonial.customerName}
                  class="w-full h-full object-cover"
                />
              ) : (
                <span class={`font-bold text-lg ${textColors[index % 3]}`}>
                  {getInitials(testimonial.customerName)}
                </span>
              )}
            </div>
            
            <div class="flex-1 min-w-0">
               <h4 class="font-bold text-slate-900 text-lg mb-1 truncate">
                 {testimonial.customerName}
               </h4>
               <div class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <Star 
                      className={`w-3.5 h-3.5 fill-current ${i < testimonial.rating ? 'text-amber-500' : 'text-neutral-200'}`} 
                    />
                  ))}
               </div>
            </div>
          </div>

          <!-- Bottom: Quote -->
          <p class="text-slate-600 italic leading-relaxed text-[15px]">
            "{testimonial.testimonial}"
          </p>
        </div>
      ))}
    </div>

    {testimonials.length > 3 && (
      <div class="mt-10 text-center reveal">
        <a
          href="https://share.google/66ShmVhCLq5EyetEm"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-sm font-bold text-slate-500 hover:text-primary-600 transition-colors uppercase tracking-wider"
        >
          View More Success Stories
          <ExternalLink className="w-4 h-4" />
        </a>
      </div>
    )}
  </Container>
</Section>
