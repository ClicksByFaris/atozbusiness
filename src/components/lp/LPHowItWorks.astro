---
interface Props {
  whatsappLink: string;
}

const { whatsappLink } = Astro.props;

const steps = [
  {
    number: "1",
    title: "Message Us",
    icon: `<svg class="w-6 h-6 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" /></svg>`
  },
  {
    number: "2",
    title: "Send Documents",
    icon: `<svg class="w-6 h-6 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>`
  },
  {
    number: "3",
    title: "Get Approved",
    icon: `<svg class="w-6 h-6 text-yellow-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`
  }
];
---

<section class="py-10 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-8 px-4">
      <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-2">
        Get Started in <span class="text-blue-600">3 Easy Steps</span>
      </h2>
    </div>

    <!-- Compact Row Layout -->
    <div class="flex flex-col md:flex-row justify-center items-center gap-3 md:gap-6 max-w-4xl mx-auto">
      {steps.map((step, index) => (
        <>
          <!-- Step Row Card -->
          <div class="w-full md:w-auto flex-1 flex flex-row items-center p-4 bg-white rounded-2xl shadow-sm border border-gray-100">
            <div class="flex-shrink-0 flex items-center justify-center w-12 h-12 rounded-full bg-blue-50 relative mr-4">
              <div class="absolute -top-1 -right-1 w-5 h-5 bg-blue-600 text-white rounded-full flex items-center justify-center font-bold text-[10px] shadow-md z-10">
                {step.number}
              </div>
              <div set:html={step.icon} />
            </div>
            <h3 class="text-lg font-bold text-gray-900">{step.title}</h3>
          </div>
          
          <!-- Arrows linking the steps together -->
          {index < steps.length - 1 && (
            <>
              <!-- Arrow for Desktop -->
              <div class="hidden md:flex items-center justify-center">
                <svg class="w-6 h-6 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </div>
              <!-- Small downward arrow / connector for Mobile -->
              <div class="md:hidden flex items-center justify-center h-4">
                <svg class="w-4 h-4 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
                </svg>
              </div>
            </>
          )}
        </>
      ))}
    </div>

    <!-- Call to action button under steps -->
    <div class="mt-8 text-center">
      <a
        href={whatsappLink}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center px-6 py-3 text-base font-bold rounded-xl text-white bg-[#25D366] hover:bg-[#128C7E] shadow-lg shadow-green-500/30 transition-all duration-300 hover:-translate-y-1 group"
      >
        <svg class="w-5 h-5 mr-2 group-hover:animate-bounce" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        Message Us to Start
      </a>
    </div>
  </div>
</section>
