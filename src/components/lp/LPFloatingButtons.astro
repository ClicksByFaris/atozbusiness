---
/**
 * LPFloatingButtons.astro
 * Landing Page floating CTA buttons — fixed bottom corners.
 * - WhatsApp: bottom-left
 * - Call:     bottom-right
 */

interface Props {
  whatsappLink: string;
  phoneNumber: string;
  pageTitle?: string;
}

const { whatsappLink, phoneNumber, pageTitle = 'A to Z Business' } = Astro.props;

const telLink = `tel:${phoneNumber.replace(/[^0-9+]/g, '')}`;
---

<!-- LP WhatsApp Button — bottom-left -->
<a
  id="lp-whatsapp-btn"
  href={whatsappLink}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Chat on WhatsApp"
  class="lp-btn lp-btn--whatsapp"
>
  <span class="lp-pulse lp-pulse--green"></span>
  <span class="lp-icon-wrap lp-icon-wrap--green">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
    >
      <path
        d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
      ></path>
    </svg>
  </span>
  <span class="lp-text">
    <span class="lp-text__top">WhatsApp</span>
    <span class="lp-text__bottom">Chat With Us</span>
  </span>
  <span class="lp-badge">1</span>
</a>

<!-- LP Call Button — bottom-right -->
<a id="lp-call-btn" href={telLink} aria-label={`Call ${phoneNumber}`} class="lp-btn lp-btn--call">
  <span class="lp-pulse lp-pulse--blue"></span>
  <span class="lp-icon-wrap lp-icon-wrap--blue">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
    >
      <path
        d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"
      ></path>
    </svg>
  </span>
  <span class="lp-text">
    <span class="lp-text__top">Call Now</span>
    <span class="lp-text__bottom">Free Consultation</span>
  </span>
</a>

<style>
  /* ── Base button ──────────────────────────────────────── */
  .lp-btn {
    position: fixed;
    bottom: 24px;
    z-index: 9999;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 18px 10px 10px;
    border-radius: 50px;
    text-decoration: none;
    color: #fff;
    font-family: 'Inter', system-ui, sans-serif;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
    overflow: visible;
  }

  .lp-btn--whatsapp {
    left: 20px;
    background: #25d366;
  }

  .lp-btn--call {
    right: 20px;
    background: linear-gradient(135deg, #1a3a7c 0%, #2a5298 100%);
  }

  .lp-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.32);
  }

  .lp-btn:active {
    transform: translateY(-1px);
  }

  /* ── Icon circle test ─────────────────────────────────────── */
  .lp-icon-wrap {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .lp-icon-wrap--green {
    background: rgba(0, 0, 0, 0.15);
  }

  .lp-icon-wrap--blue {
    background: rgba(255, 255, 255, 0.18);
  }

  .lp-icon-wrap svg {
    width: 22px;
    height: 22px;
  }

  /* ── Text block ──────────────────────────────────────── */
  .lp-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .lp-text__top {
    font-size: 0.7rem;
    font-weight: 500;
    opacity: 0.85;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .lp-text__bottom {
    font-size: 0.9rem;
    font-weight: 700;
    white-space: nowrap;
  }

  /* ── Pulse ring ──────────────────────────────────────── */
  .lp-pulse {
    position: absolute;
    inset: 0;
    border-radius: 50px;
    animation: lp-ping 2.5s cubic-bezier(0, 0, 0.2, 1) infinite;
    pointer-events: none;
    opacity: 0;
  }

  .lp-pulse--green {
    box-shadow: 0 0 0 0 #25d366;
    background: #25d366;
  }

  .lp-pulse--blue {
    box-shadow: 0 0 0 0 #2a5298;
    background: #2a5298;
  }

  @keyframes lp-ping {
    0% {
      transform: scale(1);
      opacity: 0.4;
    }
    80%,
    100% {
      transform: scale(1.18);
      opacity: 0;
    }
  }

  /* ── Notification badge (WhatsApp) ───────────────────── */
  .lp-badge {
    position: absolute;
    top: -5px;
    right: -5px;
    background: #ef4444;
    color: #fff;
    font-size: 0.6rem;
    font-weight: 800;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid #fff;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
  }

  /* ── Mobile ──────────────────────────────────────────── */
  @media (max-width: 480px) {
    .lp-btn {
      bottom: 200px;
      padding: 10px;
      border-radius: 50%;
      width: 54px;
      height: 54px;
      justify-content: center;
      gap: 0;
    }

    .lp-btn .lp-text {
      display: none;
    }

    .lp-pulse {
      border-radius: 50%;
    }

    .lp-btn--whatsapp {
      left: 16px;
    }

    .lp-btn--call {
      right: 16px;
    }

    .lp-icon-wrap {
      width: 34px;
      height: 34px;
    }

    .lp-icon-wrap svg {
      width: 20px;
      height: 20px;
    }

    .lp-badge {
      top: -2px;
      right: -2px;
    }
  }
</style>
