---
/**
 * LPFloatingButtons.astro
 * Landing Page exclusive floating CTA buttons.
 * - WhatsApp: fixed to the LEFT side (vertically centered)
 * - Call:     fixed to the RIGHT side
 */

interface Props {
  whatsappLink: string;
  phoneNumber: string;
  pageTitle?: string;
}

const { whatsappLink, phoneNumber, pageTitle = 'A to Z Business' } = Astro.props;

const telLink = `tel:${phoneNumber.replace(/[^0-9+]/g, '')}`;
---

<!-- LP WhatsApp Button — LEFT side -->
<a
  id="lp-whatsapp-btn"
  href={whatsappLink}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Chat on WhatsApp"
  class="lp-float lp-float--left"
>
  <!-- Pulse rin -->
  <span class="lp-pulse lp-pulse--green"></span>
  <!-- WhatsApp SVG icon -->
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="currentColor"
    class="lp-icon"
    aria-hidden="true"
  >
    <path
      d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
    ></path>
  </svg>
  <!-- Label -->
  <span class="lp-label lp-label--green">WhatsApp Us</span>
  <!-- Notification badge -->
  <span class="lp-badge">1</span>
</a>

<!-- LP Call Button — RIGHT side -->
<a
  id="lp-call-btn"
  href={telLink}
  aria-label={`Call ${phoneNumber}`}
  class="lp-float lp-float--right"
>
  <!-- Pulse ring -->
  <span class="lp-pulse lp-pulse--blue"></span>
  <!-- Phone SVG icon -->
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="currentColor"
    class="lp-icon"
    aria-hidden="true"
  >
    <path
      d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"
    ></path>
  </svg>
  <!-- Label -->
  <span class="lp-label lp-label--blue">Call Now</span>
</a>

<style>
  /* ── Base floating button ─────────────────────────────── */
  .lp-float {
    position: fixed;
    top: 50%;
    transform: translateY(-50%);
    z-index: 9999;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem 0.75rem 0.75rem;
    border-radius: 0 50px 50px 0; /* default: left-side pill */
    text-decoration: none;
    color: #ffffff;
    font-family: 'Inter', system-ui, sans-serif;
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.02em;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.22);
    transition:
      padding 0.25s ease,
      box-shadow 0.25s ease,
      transform 0.25s ease;
    overflow: visible;
  }

  /* LEFT side — pill opens to the right */
  .lp-float--left {
    left: 0;
    border-radius: 0 50px 50px 0;
    background: #25d366;
    flex-direction: row;
  }

  /* RIGHT side — pill opens to the left */
  .lp-float--right {
    right: 0;
    left: auto;
    border-radius: 50px 0 0 50px;
    background: #1a3a7c;
    flex-direction: row-reverse;
  }

  /* Hover expand */
  .lp-float:hover {
    padding: 0.875rem 1.25rem;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.3);
    transform: translateY(-50%) scale(1.04);
  }

  /* ── Icon ───────────────────────────────────────────── */
  .lp-icon {
    width: 1.6rem;
    height: 1.6rem;
    flex-shrink: 0;
  }

  /* ── Label text ─────────────────────────────────────── */
  .lp-label {
    white-space: nowrap;
    opacity: 0;
    max-width: 0;
    overflow: hidden;
    transition:
      opacity 0.25s ease,
      max-width 0.35s ease;
  }

  .lp-float:hover .lp-label {
    opacity: 1;
    max-width: 120px;
  }

  .lp-label--green {
    color: #fff;
  }
  .lp-label--blue {
    color: #fff;
  }

  /* ── Pulse ring ─────────────────────────────────────── */
  .lp-pulse {
    position: absolute;
    inset: -4px;
    border-radius: inherit;
    animation: lp-ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
    pointer-events: none;
    opacity: 0;
  }

  .lp-pulse--green {
    background: #25d366;
  }
  .lp-pulse--blue {
    background: #2a5298;
  }

  @keyframes lp-ping {
    0% {
      transform: scale(1);
      opacity: 0.35;
    }
    70% {
      transform: scale(1.15);
      opacity: 0;
    }
    100% {
      transform: scale(1.15);
      opacity: 0;
    }
  }

  /* ── Notification badge (WhatsApp only) ─────────────── */
  .lp-badge {
    position: absolute;
    top: -6px;
    right: -6px;
    background: #ef4444;
    color: #fff;
    font-size: 0.65rem;
    font-weight: 800;
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid #fff;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
  }

  /* ── Responsive: smaller on mobile ─────────────────── */
  @media (max-width: 640px) {
    .lp-float {
      padding: 0.6rem 0.85rem 0.6rem 0.65rem;
    }

    .lp-float--right {
      padding: 0.6rem 0.65rem 0.6rem 0.85rem;
    }

    .lp-icon {
      width: 1.35rem;
      height: 1.35rem;
    }
  }
</style>
