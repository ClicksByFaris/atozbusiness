---
import { sanityClient } from '../../lib/sanity';
import SanityImage from '../ui/SanityImage.astro';
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';

interface Testimonial {
  customerName: string;
  rating: number;
  testimonial?: string;
  customerPhoto?: any;
}

interface Props {
  googleRating?: number;
  reviewCount?: number;
  testimonials?: Testimonial[];
}

let { googleRating, reviewCount, testimonials } = Astro.props;

// If data is missing (e.g. removed from page schema), fetch the global social proof document
if (!testimonials || testimonials.length === 0) {
  const globalData = await sanityClient.fetch(`*[_type == "socialProof"][0] {
    googleRating,
    reviewCount,
    testimonials[] {
      customerName,
      customerPhoto,
      rating,
      testimonial
    }
  }`);
  
  if (globalData) {
    googleRating = googleRating ?? globalData.googleRating ?? 5;
    reviewCount = reviewCount ?? globalData.reviewCount;
    testimonials = testimonials ?? globalData.testimonials;
  }
}

// Ensure fallbacks for display
googleRating = googleRating || 5;
---

<!-- Social Proof Section - Simple Avatar Group -->
<Section id="reviews" background="white">
  <Container maxWidth="full" class="max-w-4xl mx-0">
    <div class="flex flex-row items-start justify-start gap-4 sm:gap-6 reveal">
      <!-- Customer Avatars -->
      {
        testimonials && testimonials.length > 0 && (
          <div class="flex -space-x-4">
            {testimonials.slice(0, 5).map((testimonial, index) => (
              <div
                class="w-12 h-12 rounded-full border-2 border-white bg-neutral-100 flex-shrink-0 overflow-hidden shadow-sm"
                style={`z-index: ${5 - index};`}
              >
                {testimonial.customerPhoto ? (
                  <SanityImage
                    node={testimonial.customerPhoto}
                    width={100}
                    height={100}
                    alt={testimonial.customerName}
                    class="w-full h-full object-cover"
                  />
                ) : (
                  <div class="w-full h-full flex items-center justify-center bg-primary-100 text-primary-700 font-bold text-sm">
                    {testimonial.customerName.charAt(0)}
                  </div>
                )}
              </div>
            ))}
          </div>
        )
      }

      <!-- Rating Info -->
      <div class="flex flex-col justify-center h-12 ml-1">
        <div class="flex items-center gap-1.5">
          <span class="font-bold text-lg text-neutral-900 leading-none">{googleRating}/5</span>
          <div class="flex gap-0.5">
            {
              Array.from({ length: 5 }).map(() => (
                <svg class="w-4 h-4 text-yellow-400 fill-current" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))
            }
          </div>
        </div>
        <p class="text-xs font-medium text-neutral-600 mt-0.5">
          Excellent on <span class="font-bold text-neutral-900">Google</span>
        </p>
      </div>
    </div>
  </Container>
</Section>
