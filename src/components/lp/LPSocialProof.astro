---
import { sanityClient } from '../../lib/sanity';
import SanityImage from '../ui/SanityImage.astro';
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';

interface Testimonial {
  customerName: string;
  rating: number;
  testimonial?: string;
  customerPhoto?: any;
}

interface Props {
  socialProof?: {
    googleRating?: number;
    reviewCount?: number;
    testimonials?: Testimonial[];
  };
}

let { socialProof } = Astro.props;

// If data is missing (e.g. not passed from parent), fetch it
if (!socialProof) {
  const globalData = await sanityClient.fetch(`*[_type == "socialProof"][0] {
    googleRating,
    reviewCount,
    testimonials[] {
      customerName,
      customerPhoto,
      rating,
      testimonial
    }
  }`);
  
  socialProof = {
    googleRating: globalData?.googleRating ?? 5,
    reviewCount: globalData?.reviewCount,
    testimonials: globalData?.testimonials,
  };
}

const googleRating = socialProof?.googleRating || 5;
const testimonials = socialProof?.testimonials;

// Helper for initials
const getInitials = (name: string) => {
  return name.split(' ').map(n => n[0]).join('').toUpperCase().substring(0, 2);
};
---

<!-- Social Proof Section - Simple Avatar Group -->
<Section id="reviews" background="white" class="!py-10">
  <Container maxWidth="full" class="max-w-4xl mx-0">
    <div class="flex flex-row items-center justify-start gap-4 sm:gap-6 reveal">
      
      <!-- Customer Avatars -->
      {
        testimonials && testimonials.length > 0 && (
          <div class="flex -space-x-3">
            {testimonials.slice(0, 5).map((testimonial, index) => (
              <div
                class="w-11 h-11 rounded-full border-2 border-white bg-neutral-100 flex-shrink-0 overflow-hidden shadow-sm"
                style={`z-index: ${5 - index};`}
              >
                {testimonial.customerPhoto ? (
                   <SanityImage
                    node={testimonial.customerPhoto}
                    width={100}
                    height={100}
                    alt={testimonial.customerName}
                    class="w-full h-full object-cover"
                  />
                ) : (
                  <div class="w-full h-full flex items-center justify-center bg-slate-900 text-amber-400 font-bold text-xs">
                    {getInitials(testimonial.customerName)}
                  </div>
                )}
              </div>
            ))}
          </div>
        )
      }

      <!-- Rating Info -->
      <div class="flex flex-col justify-center h-11">
        <div class="flex items-center gap-1.5 leading-none">
          <span class="font-bold text-lg text-slate-900 leading-none">{googleRating}/5</span>
          <div class="flex gap-0.5">
            {
              Array.from({ length: 5 }).map(() => (
                <svg class="w-4 h-4 text-amber-500 fill-current" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))
            }
          </div>
        </div>
        <p class="text-xs font-semibold text-slate-500 mt-1 uppercase tracking-wider">
          Reviews from <span class="text-slate-900 font-bold">Google</span>
        </p>
      </div>
    </div>
  </Container>
</Section>
