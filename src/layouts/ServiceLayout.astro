---
import BaseLayout from './BaseLayout.astro';
import type { Service } from '../types';
import {
  generateServiceSchema,
  generateFAQSchema,
  generateServiceBreadcrumbs,
  generateHowToSchema,
} from '../lib/schemas/service';

interface Props {
  service: Service;
}

const { service } = Astro.props;

// Generate all schemas using centralized utilities
const faqSchema = service.faq ? generateFAQSchema(service.faq, service.slug.current) : null;

// Convert processSteps to HowTo schema if they exist
const howToSchema =
  service.processSteps && service.processSteps.length > 0
    ? generateHowToSchema({
        name: `How to apply for ${service.title}`,
        description: service.excerpt,
        slug: service.slug.current,
        steps: service.processSteps.map((step: any, idx: number) => ({
          name: step.step || step.title || `Step ${idx + 1}`,
          text: step.description || `Complete step ${idx + 1} of the process.`,
        })),
      })
    : null;

const serviceSchema = generateServiceSchema({
  name: service.title,
  description: service.excerpt,
  slug: service.slug.current,
  image: service.featuredImage?.asset?.url,
  category: service.category,
  areaServed: 'Abu Dhabi, UAE',
  audienceType: 'Expatriates, Investors, and Businesses', // AEO optimized targeting
  serviceOutput: service.title, // The actual entity output (e.g. Golden Visa)
  offers: {
    price: service.pricing?.startingFrom ? String(service.pricing.startingFrom) : undefined,
    priceCurrency: service.pricing?.currency || 'AED',
  },
  hasFAQ: !!faqSchema,
  hasHowTo: !!howToSchema,
});

const breadcrumbSchema = generateServiceBreadcrumbs(service.title, service.slug.current);

const schemas = [serviceSchema, faqSchema, howToSchema, breadcrumbSchema].filter(Boolean);

// Use Sanity featured image or fallback to the newly added default OG image
const ogImageUrl = service.featuredImage?.asset?.url || '/images/og/og%20image.webp';
---

<BaseLayout
  title={`${service.title} in Abu Dhabi | A to Z Business`}
  description={service.excerpt}
  ogImage={ogImageUrl}
>
  {schemas.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}

  <main class="bg-neutral-50 pb-20">
    <slot />
  </main>
</BaseLayout>
